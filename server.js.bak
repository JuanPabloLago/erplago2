app.get('/api/productos', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    const listaPreciosId = req.query.listaPreciosId || 1;
    try {
        const result = await pool.query(`SELECT p.id_producto, p.sku, p.nombre, p.marca, p.url_imagen, i.stock_real, pr.precio as precio_base, p.activo FROM productos p LEFT JOIN inventario i ON p.id_producto = i.id_producto AND i.id_empresa = $1 LEFT JOIN precios pr ON p.id_producto = pr.id_producto AND pr.id_lista_precio = $2 ORDER BY p.nombre;`, [id_empresa, listaPreciosId]);
        res.json(result.rows);
    } catch (err) {
        console.error('Error al obtener productos:', err);
        res.status(500).send('Error interno del servidor');
    }
});

app.get('/api/productos/:id', verificarToken, async (req, res) => {
    const { id } = req.params;
    const id_empresa = req.user.id_empresa;
    try {
        const [productoRes, inventarioRes, preciosRes, codigosRes] = await Promise.all([
            pool.query('SELECT * FROM productos WHERE id_producto = $1', [id]),
            pool.query('SELECT stock_real, stock_minimo, stock_maximo FROM inventario WHERE id_producto = $1 AND id_empresa = $2', [id, id_empresa]),
            pool.query('SELECT id_lista_precio, precio FROM precios WHERE id_producto = $1', [id]),
            pool.query('SELECT codigo_barras FROM productocodigosbarras WHERE id_producto = $1', [id])
        ]);

        if (productoRes.rows.length === 0) return res.status(404).json({ error: 'Producto no encontrado' });

        res.json({
            ...productoRes.rows[0],
            inventario: inventarioRes.rows[0] || {},
            precios: preciosRes.rows,
            codigos_barras: codigosRes.rows.map(c => c.codigo_barras)
        });
    } catch (err) {
        console.error('Error al obtener detalle de producto:', err);
        res.status(500).send('Error interno del servidor');
    }
});

app.post('/api/productos', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    const { sku, nombre, marca, descripcion, id_categoria, unidad_medida, url_imagen, inventario, precios, codigos_barras } = req.body;
    
    const client = await pool.connect();
    try {
        await client.query('BEGIN');
        const productoResult = await client.query(`INSERT INTO productos (sku, nombre, marca, descripcion, id_categoria, unidad_medida, url_imagen) VALUES ($1, $2, $3, $4, $5, $6, $7) RETURNING id_producto;`, [sku, nombre, marca, descripcion, id_categoria || null, unidad_medida, url_imagen]);
        const id_producto = productoResult.rows[0].id_producto;

        await client.query(`INSERT INTO inventario (id_empresa, id_producto, stock_real, stock_minimo, stock_maximo) VALUES ($1, $2, $3, $4, $5);`, [id_empresa, id_producto, inventario.stock_real || 0, inventario.stock_minimo || 0, inventario.stock_maximo || 0]);

        for (const p of precios) {
            if (p.precio) {
                await client.query(`INSERT INTO precios (id_producto, id_lista_precio, precio) VALUES ($1, $2, $3);`, [id_producto, p.id_lista_precio, p.precio]);
            }
        }
        for (const codigo of codigos_barras) {
            if (codigo) {
                await client.query(`INSERT INTO productocodigosbarras (id_producto, codigo_barras) VALUES ($1, $2) ON CONFLICT (codigo_barras) DO NOTHING;`, [id_producto, codigo]);
            }
        }
        await client.query('COMMIT');
        res.status(201).json({ id_producto });
    } catch (err) {
        await client.query('ROLLBACK');
        console.error('Error al crear el producto:', err);
        if (err.code === '23505') return res.status(409).json({ error: 'El SKU o Código de Barras ingresado ya existe.' });
        res.status(500).send('Error interno del servidor');
    } finally {
        client.release();
    }
});

app.put('/api/productos/:id', verificarToken, async (req, res) => {
    const { id } = req.params;
    const id_empresa = req.user.id_empresa;
    const { sku, nombre, marca, descripcion, id_categoria, unidad_medida, url_imagen, activo, inventario, precios, codigos_barras } = req.body;
    const client = await pool.connect();
    try {
        await client.query('BEGIN');
        
        await client.query(`UPDATE productos SET sku = $1, nombre = $2, marca = $3, descripcion = $4, id_categoria = $5, unidad_medida = $6, url_imagen = $7, activo = $8 WHERE id_producto = $9;`, [sku, nombre, marca, descripcion, id_categoria || null, unidad_medida, url_imagen, activo, id]);
        
        await client.query(`INSERT INTO inventario (id_empresa, id_producto, stock_real, stock_minimo, stock_maximo) VALUES ($1, $2, $3, $4, $5) ON CONFLICT (id_empresa, id_producto) DO UPDATE SET stock_real = $3, stock_minimo = $4, stock_maximo = $5;`, [id_empresa, id, inventario.stock_real || 0, inventario.stock_minimo || 0, inventario.stock_maximo || 0]);

        await client.query('DELETE FROM precios WHERE id_producto = $1;', [id]);
        for (const p of precios) {
            if (p.precio) {
                await client.query(`INSERT INTO precios (id_producto, id_lista_precio, precio) VALUES ($1, $2, $3);`, [id, p.id_lista_precio, p.precio]);
            }
        }
        
        await client.query('DELETE FROM productocodigosbarras WHERE id_producto = $1;', [id]);
        for (const codigo of codigos_barras) {
            if (codigo) {
                await client.query(`INSERT INTO productocodigosbarras (id_producto, codigo_barras) VALUES ($1, $2) ON CONFLICT (codigo_barras) DO NOTHING;`, [id, codigo]);
            }
        }
        await client.query('COMMIT');
        res.status(200).json({ id_producto: id });
    } catch (err) {
        await client.query('ROLLBACK');
        console.error(`Error al actualizar el producto ${id}:`, err);
        if (err.code === '23505') return res.status(409).json({ error: 'El SKU o Código de Barras ya pertenece a otro producto.' });
        res.status(500).send('Error interno del servidor');
    } finally {
        client.release();
    }
});

// -------------------------------------------------------
// MÓDULO DE BÚSQUEDA (Para la página de Ventas)
// -------------------------------------------------------
app.get('/api/clientes/buscar', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    const termino = req.query.q;
    if (!termino) return res.json([]);
    const terminoDeBusqueda = `%${termino}%`;
    try {
        const result = await pool.query(`SELECT id_cliente, razon_social, cuit FROM clientes WHERE id_empresa = $1 AND (razon_social ILIKE $2 OR cuit ILIKE $2 OR CAST(id_cliente AS TEXT) ILIKE $2) LIMIT 10;`, [id_empresa, terminoDeBusqueda]);
        res.json(result.rows);
    } catch (err) {
        console.error('Error al buscar clientes:', err);
        res.status(500).send('Error interno del servidor');
    }
});

app.get('/api/catalogo/buscar', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    const { clienteId, q: termino } = req.query;
    if (!clienteId) return res.status(400).json({ error: 'Se requiere un ID de cliente.' });
    const terminosBusqueda = termino.split(' ').filter(t => t).map(t => `%${t}%`);
    if (terminosBusqueda.length === 0) return res.json([]);
    try {
        const query = `
            WITH cliente_lista AS (SELECT COALESCE(id_lista_precio, 1) AS lista_id FROM clientes WHERE id_cliente = $2 AND id_empresa = $1)
            SELECT DISTINCT p.id_producto, p.nombre, p.marca, p.sku, i.stock_real, pr.precio AS precio_venta
            FROM productos p
            INNER JOIN inventario i ON p.id_producto = i.id_producto AND i.id_empresa = $1
            LEFT JOIN precios pr ON p.id_producto = pr.id_producto AND pr.id_lista_precio = (SELECT lista_id FROM cliente_lista)
            LEFT JOIN ProductoCodigosBarras pcb ON p.id_producto = pcb.id_producto
            WHERE p.activo = TRUE AND i.stock_real > 0
            AND (${terminosBusqueda.map((_, i) => `(p.nombre ILIKE $${i+3} OR p.marca ILIKE $${i+3} OR p.sku ILIKE $${i+3} OR pcb.codigo_barras ILIKE $${i+3})`).join(' AND ')})
            LIMIT 20;
        `;
        const result = await pool.query(query, [id_empresa, clienteId, ...terminosBusqueda]);
        res.json(result.rows);
    } catch (err) {
        console.error('Error al buscar productos:', err);
        res.status(500).send('Error interno del servidor');
    }
});

app.get('/api/catalogo/sku/:sku', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    const { sku } = req.params;
    const { clienteId } = req.query;
    if (!clienteId || !sku) return res.status(400).json({ error: 'Se requieren SKU y ID de cliente.' });
    try {
        const query = `
            WITH cliente_lista AS (SELECT COALESCE(id_lista_precio, 1) AS lista_id FROM clientes WHERE id_cliente = $3 AND id_empresa = $1)
            SELECT p.id_producto, p.sku, p.nombre, i.stock_real, pr.precio AS precio_venta
            FROM productos p
            INNER JOIN inventario i ON p.id_producto = i.id_producto AND i.id_empresa = $1
            LEFT JOIN precios pr ON p.id_producto = pr.id_producto AND pr.id_lista_precio = (SELECT lista_id FROM cliente_lista)
            WHERE p.sku ILIKE $2 AND p.activo = TRUE;
        `;
        const result = await pool.query(query, [id_empresa, sku, clienteId]);
        if (result.rows.length === 0) return res.status(404).json({ error: 'Producto no encontrado.' });
        res.json(result.rows[0]);
    } catch (err) {
        console.error('Error al buscar producto por SKU:', err);
        res.status(500).send('Error interno del servidor');
    }
});

app.get('/api/catalogo/barcode/:barcode', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    const { barcode } = req.params;
    const { clienteId } = req.query;
    if (!clienteId || !barcode) return res.status(400).json({ error: 'Se requieren Código de Barras y ID de cliente.' });
    try {
        const query = `
            WITH cliente_lista AS (SELECT COALESCE(id_lista_precio, 1) AS lista_id FROM clientes WHERE id_cliente = $3 AND id_empresa = $1)
            SELECT p.id_producto, p.sku, p.nombre, i.stock_real, pr.precio AS precio_venta
            FROM ProductoCodigosBarras pcb
            JOIN productos p ON pcb.id_producto = p.id_producto
            JOIN inventario i ON p.id_producto = i.id_producto AND i.id_empresa = $1
            LEFT JOIN precios pr ON p.id_producto = pr.id_producto AND pr.id_lista_precio = (SELECT lista_id FROM cliente_lista)
            WHERE pcb.codigo_barras = $2 AND p.activo = TRUE;
        `;
        const result = await pool.query(query, [id_empresa, barcode, clienteId]);
        if (result.rows.length === 0) return res.status(404).json({ error: 'Producto no encontrado.' });
        res.json(result.rows[0]);
    } catch (err) {
        console.error('Error al buscar por código de barras:', err);
        res.status(500).send('Error interno del servidor');
    }
});


// -------------------------------------------------------
// MÓDULO DE PEDIDOS
// -------------------------------------------------------
app.post('/api/pedidos', verificarToken, async (req, res) => {
    const { id_cliente, total, items, estado } = req.body;
    const id_empresa = req.user.id_empresa;
    const id_usuario = req.user.id_usuario;
    if (!id_cliente || !items || !Array.isArray(items) || items.length === 0) return res.status(400).json({ error: 'Faltan datos para crear el pedido.' });
    
    const client = await pool.connect();
    try {
        await client.query('BEGIN');
        const estadoResult = await client.query('SELECT nombre FROM PedidoEstados WHERE id_estado = $1', [estado]);
        const nombreEstado = estadoResult.rows[0]?.nombre;
        if (!nombreEstado) throw new Error('Estado de pedido no válido.');
        
        const pedidoQuery = 'INSERT INTO pedidos(id_empresa, id_cliente, id_estado, total, id_usuario_creador) VALUES($1, $2, $3, $4, $5) RETURNING id_pedido';
        const pedidoResult = await client.query(pedidoQuery, [id_empresa, id_cliente, estado, total, id_usuario]);
        const nuevoPedidoId = pedidoResult.rows[0].id_pedido;

        const debeDescontarStock = (nombreEstado !== 'Cotización' && nombreEstado !== 'En Suspenso');
        for (const item of items) {
            if (debeDescontarStock) {
                await client.query('UPDATE inventario SET stock_real = stock_real - $1 WHERE id_producto = $2 AND id_empresa = $3', [item.cantidad, item.id_producto, id_empresa]);
            }
            await client.query('INSERT INTO pedidoitems(id_pedido, id_producto, cantidad, precio_unitario_congelado) VALUES($1, $2, $3, $4)', [nuevoPedidoId, item.id_producto, item.cantidad, item.precio_venta]);
        }
        await registrarLog(id_usuario, 'Creación de Pedido', `Se creó el pedido N° ${nuevoPedidoId} (Estado: ${estado}) por ${total}.`, req);
        await client.query('COMMIT');
        res.status(201).json({ message: 'Pedido creado exitosamente.', id_pedido: nuevoPedidoId });
    } catch (err) {
        await client.query('ROLLBACK');
        console.error('Error al crear el pedido:', err);
        res.status(500).send('Error interno del servidor');
    } finally {
        client.release();
    }
});

app.get('/api/pedidos/suspendidos', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    try {
        const result = await pool.query(`SELECT p.id_pedido, p.total, p.fecha_creacion, c.razon_social FROM pedidos p JOIN clientes c ON p.id_cliente = c.id_cliente WHERE p.id_empresa = $1 AND p.id_estado = 9 ORDER BY p.fecha_creacion DESC;`, [id_empresa]);
        res.json(result.rows);
    } catch (err) {
        console.error('Error al obtener suspendidos:', err);
        res.status(500).send('Error interno del servidor');
    }
});

app.post('/api/pedidos/recuperar/:id', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    const { id: id_pedido } = req.params;
    const client = await pool.connect();
    try {
        await client.query('BEGIN');
        await client.query('UPDATE pedidos SET id_estado = 10 WHERE id_pedido = $1 AND id_empresa = $2', [id_pedido, id_empresa]);
        const itemsResult = await client.query(`SELECT pi.id_producto, p.sku, p.nombre, pi.cantidad, pi.precio_unitario_congelado as precio_venta FROM pedidoitems pi JOIN productos p ON pi.id_producto = p.id_producto WHERE pi.id_pedido = $1;`, [id_pedido]);
        const clienteResult = await client.query('SELECT id_cliente, razon_social, cuit FROM clientes WHERE id_cliente = (SELECT id_cliente FROM pedidos WHERE id_pedido = $1)', [id_pedido]);
        await client.query('COMMIT');
        res.json({ cliente: clienteResult.rows[0], items: itemsResult.rows });
    } catch (err) {
        await client.query('ROLLBACK');
        console.error('Error al recuperar pedido:', err);
        res.status(500).send('Error interno del servidor');
    } finally {
        client.release();
    }
});

