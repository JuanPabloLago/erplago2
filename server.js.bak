// =======================================================================
// 1. CONFIGURACIÓN E IMPORTACIONES
// =======================================================================
require('dotenv').config();
const express = require('express');
const path = require('path');
const { Pool } = require('pg');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcrypt');
const multer = require('multer');
const xlsx = require('xlsx');

const app = express();
const port = 3000;

// =======================================================================
// 2. MIDDLEWARES DE EXPRESS
// =======================================================================
app.use(express.json());
app.use(express.static(path.join(__dirname, 'frontend')));
const upload = multer({ storage: multer.memoryStorage() });

// =======================================================================
// 3. CONEXIÓN A LA BASE DE DATOS (POSTGRESQL)
// =======================================================================
const pool = new Pool({
    user: process.env.DB_USER,
    host: process.env.DB_HOST,
    database: process.env.DB_DATABASE,
    password: process.env.DB_PASSWORD,
    port: process.env.DB_PORT
});

pool.query('SELECT NOW()', (err, res) => {
    if (err) {
        console.error('Error al conectar a la base de datos:', err.stack);
    } else {
        console.log('Conexión a PostgreSQL exitosa!');
    }
});

// =======================================================================
// 4. FUNCIONES HELPER (REUTILIZABLES)
// =======================================================================
async function registrarLog(id_usuario, accion, detalle, req) {
    try {
        const ip = req.ip || req.connection.remoteAddress;
        const text = `
            INSERT INTO usuarios_logs(id_usuario, accion, detalle, ip_origen)
            VALUES($1, $2, $3, $4);
        `;
        const values = [id_usuario, accion, detalle, ip];
        await pool.query(text, values);
    } catch (err) {
        console.error('Error al registrar en el log:', err.message);
    }
}

// =======================================================================
// 5. MIDDLEWARE DE AUTENTICACIÓN (EL "GUARDIAN")
// =======================================================================
function verificarToken(req, res, next) {
    const authHeader = req.headers['authorization'];
    const token = authHeader && authHeader.split(' ')[1];
    if (token == null) {
        return res.status(401).json({ error: 'Acceso no autorizado: Token no proporcionado.' });
    }
    jwt.verify(token, process.env.JWT_SECRET, (err, user) => {
        if (err) {
            return res.status(403).json({ error: 'Acceso prohibido: El token no es válido o ha expirado.' });
        }
        req.user = user;
        next();
    });
}

// =======================================================================
// 6. RUTAS DE LA API (ENDPOINTS)
// =======================================================================

// -------------------------------------------------------
// MÓDULO DE USUARIOS Y AUTENTICACIÓN
// -------------------------------------------------------
app.post('/api/usuarios/login', async (req, res) => {
    const { username, password } = req.body;
    if (!username || !password) {
        return res.status(400).json({ error: 'Se requieren usuario y contraseña.' });
    }
    try {
        const result = await pool.query('SELECT * FROM usuarios WHERE username = $1 AND activo = TRUE', [username]);
        if (result.rows.length === 0) {
            return res.status(401).json({ error: 'Credenciales inválidas o usuario inactivo.' });
        }
        const user = result.rows[0];
        const match = await bcrypt.compare(password, user.password_hash);
        if (match) {
            const payload = { id_usuario: user.id_usuario, username: user.username, rol: user.rol, id_empresa: user.id_empresa };
            const token = jwt.sign(payload, process.env.JWT_SECRET, { expiresIn: '8h' });
            await registrarLog(user.id_usuario, 'Login Exitoso', `Usuario '${user.username}' ha iniciado sesión.`, req);
            res.status(200).json({ message: 'Login exitoso', token: token });
        } else {
            await registrarLog(user.id_usuario, 'Login Fallido', `Intento con contraseña incorrecta para '${user.username}'.`, req);
            res.status(401).json({ error: 'Credenciales inválidas.' });
        }
    } catch (err) {
        console.error('Error en el login:', err);
        res.status(500).send('Error interno del servidor');
    }
});

// -------------------------------------------------------
// MÓDULO DE DASHBOARD
// -------------------------------------------------------
app.get('/api/dashboard/stats', verificarToken, async (req, res) => {
    const id_empresa = req.user.id_empresa;
    try {
        const [ventasResult, clientesResult, pendientesResult, stockResult] = await Promise.all([
            pool.query(`SELECT SUM(total) as total_ventas FROM pedidos WHERE id_empresa = $1 AND id_estado IN (2, 3, 5, 6) AND fecha_creacion >= date_trunc('month', current_date);`, [id_empresa]),
            pool.query(`SELECT COUNT(id_cliente) as total_clientes FROM clientes WHERE id_empresa = $1 AND fecha_alta >= date_trunc('month', current_date);`, [id_empresa]),
            pool.query(`SELECT COUNT(id_pedido) as total_pendientes FROM pedidos WHERE id_empresa = $1 AND id_estado IN (1, 2);`, [id_empresa]),
            pool.query(`SELECT COUNT(id_producto) as total_stock_bajo FROM inventario WHERE id_empresa = $1 AND stock_real <= stock_minimo AND stock_minimo > 0;`, [id_empresa])
        ]);
        const stats = {
            ventas_mes: ventasResult.rows[0].total_ventas || 0,
            nuevos_clientes: clientesResult.rows[0].total_clientes || 0,
            pedidos_pendientes: pendientesResult.rows[0].total_pendientes || 0,
            stock_bajo: stockResult.rows[0].total_stock_bajo || 0
        };
        res.json(stats);
    } catch (err) {
        console.error('Error al obtener estadísticas del dashboard:', err);
        res.status(500).send('Error interno del servidor');
    }
});

