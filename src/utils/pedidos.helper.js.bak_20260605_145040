// 9. ACTUALIZAR CAMPOS ESPECÍFICOS DEL PEDIDO
// ═══════════════════════════════════════════════════════════════════════════
/**
 * Actualiza campos específicos del pedido sin tocar los totales.
 * Whitelist de campos permitidos para seguridad.
 *
 * @param {Object} client
 * @param {Object} datos
 * @param {number} datos.id_pedido
 * @param {number} datos.id_empresa
 * @param {Object} datos.campos - {campo: valor}
 * @returns {Object} Pedido actualizado
 */
async function actualizarCampos(client, datos) {
    const { id_pedido, id_empresa, campos } = datos;

    if (!id_pedido || !id_empresa) throw new Error('pedidos.helper.actualizarCampos: id_pedido y id_empresa obligatorios');
    if (!campos || Object.keys(campos).length === 0) throw new Error('pedidos.helper.actualizarCampos: campos vacíos');

    const camposPermitidos = [
        'id_cliente', 'tipo_entrega', 'observaciones', 'descuento_general',
        'estado_entrega', 'notas_entrega', 'domicilio_entrega',
        'fecha_entrega_pactada', 'id_moneda', 'cotizacion',
        'total_moneda_extranjera', 'valor_dolar_momento'
    ];

    const sets = [];
    const params = [];
    let idx = 1;

    for (const [campo, valor] of Object.entries(campos)) {
        if (camposPermitidos.includes(campo)) {
            sets.push(`${campo} = $${idx}`);
            params.push(valor);
            idx++;
        }
    }

    if (sets.length === 0) throw new Error('pedidos.helper.actualizarCampos: ningún campo válido');

    params.push(id_pedido, id_empresa);

    const { rows: [pedido] } = await client.query(`
        UPDATE pedidos SET ${sets.join(', ')}
        WHERE id_pedido = $${idx} AND id_empresa = $${idx + 1}
        RETURNING *
    `, params);

    if (!pedido) throw new Error(`pedidos.helper.actualizarCampos: pedido ${id_pedido} no encontrado`);

    return pedido;
}

