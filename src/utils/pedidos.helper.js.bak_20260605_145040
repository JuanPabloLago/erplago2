// 6. RECALCULAR TOTALES (desde BD)
// ═══════════════════════════════════════════════════════════════════════════
/**
 * Lee los items de BD, recalcula totales y actualiza el pedido.
 * ÚNICA función que actualiza los campos de totales del pedido.
 *
 * @param {Object} client
 * @param {number} id_pedido
 * @param {number} [id_empresa] - si se proporciona, valida aislamiento
 * @returns {Object} Totales calculados
 */
async function recalcularTotales(client, id_pedido, id_empresa) {
    if (!id_pedido)  throw new Error('pedidos.helper.recalcularTotales: id_pedido obligatorio');
    if (!id_empresa) throw new Error('pedidos.helper.recalcularTotales: id_empresa obligatorio (multi-empresa)');

    const { rows } = await client.query(`
        SELECT
            COALESCE(SUM(total_linea - monto_iva), 0) as subtotal_sin_iva,
            COALESCE(SUM(monto_iva), 0) as total_iva,
            COALESCE(SUM(total_linea), 0) as total_final
        FROM pedidoitems
        WHERE id_pedido = $1 AND id_empresa = $2
    `, [id_pedido, id_empresa]);

    const { subtotal_sin_iva, total_iva, total_final } = rows[0];

    const result = await client.query(`
        UPDATE pedidos SET
            subtotal_sin_iva = $1,
            total_iva = $2,
            total_final = $3,
            total = $3,
            descuento_monto = 0,
            subtotal_con_descuento = $1
        WHERE id_pedido = $4 AND id_empresa = $5
        RETURNING subtotal_sin_iva, total_iva, total_final
    `, [subtotal_sin_iva, total_iva, total_final, id_pedido, id_empresa]);

    if (result.rows.length === 0) {
        throw new Error(`pedidos.helper.recalcularTotales: pedido ${id_pedido} no encontrado en empresa ${id_empresa}`);
    }

    return {
        subtotal_sin_iva: parseFloat(subtotal_sin_iva),
        total_iva: parseFloat(total_iva),
        total_final: parseFloat(total_final)
    };
}

