 * Asigna nro_pedido secuencial por empresa.
 * Se llama SOLO al confirmar borrador, NO al crear.
 * FOR UPDATE bloquea la fila max para evitar duplicados concurrentes.
 */
async function asignarNumeroPedido(client, { id_pedido, id_empresa }) {
    // CTE atómico: bloquea, calcula siguiente, actualiza en una sola query
    const result = await client.query(`
        WITH siguiente AS (
            SELECT COALESCE(MAX(nro_pedido), 0) + 1 AS nro
            FROM pedidos
            WHERE id_empresa = $2
        )
        UPDATE pedidos
        SET nro_pedido = siguiente.nro
        FROM siguiente
        WHERE id_pedido = $1 AND id_empresa = $2
        RETURNING pedidos.nro_pedido
    `, [id_pedido, id_empresa]);

    if (result.rows.length === 0) {
        throw new Error('No se pudo asignar número de pedido');
    }
    return result.rows[0].nro_pedido;
}

