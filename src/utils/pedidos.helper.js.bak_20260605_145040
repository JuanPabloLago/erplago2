// REGISTRAR INTERÉS DE CUOTAS (C4 — centralizado)
// Suma interés al total del pedido + registra en ajustes_forma_pago
// ═══════════════════════════════════════════════════════════════════════════
async function registrarInteresCuotas(client, datos) {
    // F1.5: ahora delega al orquestador único aplicarAjusteFormaPago.
    // Antes: hacía UPDATE total_final += interes SIN actualizar subtotal_sin_iva ni total_iva,
    // dejando los pedidos drifteados (Ley 23.349 art.10 — base imponible IVA mal calculada).
    // Ahora: el porcentaje se deriva del coeficiente de la terminal y se aplica con la fórmula
    // multiplicativa correcta sobre items, recalculando subtotal + iva + total_final coherentes.
    const { id_empresa, id_pedido, id_cliente, id_usuario, interes, calculo } = datos;

    const recargoPct = Math.round((calculo.coeficiente - 1) * 10000) / 100;
    const nombreFP = calculo.terminal_nombre + ' ' + calculo.cuotas + ' cuotas';

    // id_forma_pago=2 mantiene compatibilidad con auditoría histórica (Posnet MercadoPago)
    const resultado = await aplicarAjusteFormaPago(client, {
        id_pedido, id_empresa,
        id_forma_pago: 2,
        id_cliente,
        id_usuario,
        porcentaje: recargoPct,
        nombre_forma_pago: nombreFP
    });

    logger.info('[F1.5] registrarInteresCuotas pedido #' + id_pedido + ' delegado a aplicarAjusteFormaPago | ' + recargoPct + '% via ' + calculo.terminal_nombre);
    return { interes, recargoPct, ajusteId: resultado ? resultado.ajusteId : null };
}

