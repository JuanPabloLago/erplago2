/**
 * Obtiene un pedido completo con items.
 * Reutilizable por cualquier controller.
 *
 * @param {Function} queryFn - pool.query o client.query
 * @param {number} id_pedido
 * @param {number} [id_empresa] - si se proporciona, filtra por empresa
 * @returns {Object|null} Pedido con items
 */
async function obtenerPedidoCompleto(queryFn, id_pedido, id_empresa) {
    let query = `
        SELECT p.*,
               c.razon_social as cliente_nombre
        FROM pedidos p
        LEFT JOIN clientes c ON p.id_cliente = c.id_cliente
        WHERE p.id_pedido = $1
    `;
    const params = [id_pedido];

    if (id_empresa) {
        query += ' AND p.id_empresa = $2';
        params.push(id_empresa);
    }

    const pedidoRes = await queryFn(query, params);
    if (pedidoRes.rows.length === 0) return null;

    const itemsRes = await queryFn(`
        SELECT pi.*,
               pr.nombre as producto_nombre,
               pr.sku as producto_codigo,
               pr.url_imagen,
               COALESCE(inv.stock_real, 0) as stock_actual
        FROM pedidoitems pi
        JOIN productos pr ON pi.id_producto = pr.id_producto
        LEFT JOIN inventario inv ON pr.id_producto = inv.id_producto
            AND inv.id_empresa = (SELECT id_empresa FROM pedidos WHERE id_pedido = $1)
        WHERE pi.id_pedido = $1
        ORDER BY pi.id_item ASC
    `, [id_pedido]);

    return {
        ...pedidoRes.rows[0],
        items: itemsRes.rows
    };
}

/**
 * Obtiene solo los items de un pedido.
 *
 * @param {Function} queryFn
 * @param {number} id_pedido
 * @returns {Array} Items
 */
async function obtenerItems(queryFn, id_pedido, id_empresa) {
    const { rows } = await queryFn(`
        SELECT pi.*, pr.nombre as producto_nombre, pr.sku
        FROM pedidoitems pi
        JOIN productos pr ON pi.id_producto = pr.id_producto
        WHERE pi.id_pedido = $1 AND pi.id_empresa = $2
        ORDER BY pi.id_item ASC
    `, [id_pedido, id_empresa]);

    return rows;
}

