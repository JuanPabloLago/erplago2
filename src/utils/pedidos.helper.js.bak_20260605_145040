/**
 * Actualiza cantidad_remitida de un item (despachos).
 *
 * @param {Object} client
 * @param {Object} datos
 * @param {number} datos.id_item
 * @param {number} datos.id_empresa
 * @param {number} datos.cantidad_remitida - nueva cantidad total remitida (o delta si datos.delta=true)
 * @param {boolean} [datos.delta=false] - true = sumar al valor actual
 * @returns {Object} Item actualizado
 */
async function actualizarCantidadRemitida(client, datos) {
    const { id_item, id_empresa, cantidad_remitida, delta = false } = datos;

    if (!id_item || !id_empresa) throw new Error('pedidos.helper.actualizarCantidadRemitida: id_item y id_empresa obligatorios');

    let query;
    if (delta) {
        query = `
            UPDATE pedidoitems SET cantidad_remitida = COALESCE(cantidad_remitida, 0) + $1
            WHERE id_item = $2 AND id_empresa = $3
            RETURNING *
        `;
    } else {
        query = `
            UPDATE pedidoitems SET cantidad_remitida = $1
            WHERE id_item = $2 AND id_empresa = $3
            RETURNING *
        `;
    }

    const { rows: [item] } = await client.query(query, [cantidad_remitida, id_item, id_empresa]);

    if (!item) throw new Error(`pedidos.helper.actualizarCantidadRemitida: item ${id_item} no encontrado`);

    return item;
}

