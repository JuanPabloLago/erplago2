// 7. APLICAR DESCUENTO GENERAL
// ═══════════════════════════════════════════════════════════════════════════
/**
 * Aplica un descuento general (%) al pedido.
 * Recalcula totales con IVA proporcional al descuento.
 *
 * @param {Object} client
 * @param {Object} datos
 * @param {number} datos.id_pedido
 * @param {number} datos.id_empresa
 * @param {number} datos.descuento_general - porcentaje
 * @returns {Object} Totales actualizados
 */
/**
 * Recalcula precio_unitario_final, monto_iva y total_linea de TODOS los items
 * de un pedido, aplicando las 3 capas de descuento guardadas en cada item.
 * Luego actualiza header = SUM(items).
 * @returns {{ subtotal_sin_iva, total_iva, total_final }}
 */
async function _recalcularItemsDesdeDescuentos(client, id_pedido, id_empresa) {
    // Recalcular cada item: precio_final = congelado * (1-desc_item%) * (1-desc_gral%) * (1+desc_fp%)
    await client.query(`
        UPDATE pedidoitems SET
            precio_unitario_final = ROUND(
                precio_unitario_congelado
                * (1 - COALESCE(porcentaje_descuento, 0) / 100)
                * (1 - COALESCE(descuento_general_pct, 0) / 100)
                * (1 + COALESCE(descuento_fp_pct, 0) / 100)
            , 2),
            monto_iva = ROUND(
                ROUND(
                    precio_unitario_congelado
                    * (1 - COALESCE(porcentaje_descuento, 0) / 100)
                    * (1 - COALESCE(descuento_general_pct, 0) / 100)
                    * (1 + COALESCE(descuento_fp_pct, 0) / 100)
                , 2) * cantidad * iva_aplicado / 100
            , 2),
            total_linea = ROUND(
                ROUND(
                    precio_unitario_congelado
                    * (1 - COALESCE(porcentaje_descuento, 0) / 100)
                    * (1 - COALESCE(descuento_general_pct, 0) / 100)
                    * (1 + COALESCE(descuento_fp_pct, 0) / 100)
                , 2) * cantidad
                + ROUND(
                    ROUND(
                        precio_unitario_congelado
                        * (1 - COALESCE(porcentaje_descuento, 0) / 100)
                        * (1 - COALESCE(descuento_general_pct, 0) / 100)
                        * (1 + COALESCE(descuento_fp_pct, 0) / 100)
                    , 2) * cantidad * iva_aplicado / 100
                , 2)
            , 2)
        WHERE id_pedido = $1 AND id_empresa = $2
    `, [id_pedido, id_empresa]);

    // Header = SUM(items)
    const { rows: [totales] } = await client.query(`
        SELECT
            ROUND(SUM(precio_unitario_final * cantidad), 2) as subtotal_sin_iva,
            ROUND(SUM(monto_iva), 2) as total_iva,
            ROUND(SUM(total_linea), 2) as total_final
        FROM pedidoitems WHERE id_pedido = $1 AND id_empresa = $2
    `, [id_pedido, id_empresa]);

    await client.query(`
        UPDATE pedidos SET
            subtotal_sin_iva = $1,
            total_iva = $2,
            total_final = $3,
            total = $3
        WHERE id_pedido = $4 AND id_empresa = $5
    `, [totales.subtotal_sin_iva, totales.total_iva, totales.total_final, id_pedido, id_empresa]);

    return {
        subtotal_sin_iva: parseFloat(totales.subtotal_sin_iva),
        total_iva: parseFloat(totales.total_iva),
        total_final: parseFloat(totales.total_final)
    };
}

async function aplicarDescuentoGeneral(client, datos) {
    const { id_pedido, id_empresa, descuento_general } = datos;

    if (!id_pedido) throw new Error('pedidos.helper.aplicarDescuentoGeneral: id_pedido obligatorio');
    if (!id_empresa) throw new Error('pedidos.helper.aplicarDescuentoGeneral: id_empresa obligatorio');

    const dto = parseFloat(descuento_general) || 0;

    // Guardar % en cada item para trazabilidad
    await client.query(
        'UPDATE pedidoitems SET descuento_general_pct = $1 WHERE id_pedido = $2',
        [dto, id_pedido]
    );

    // Recalcular items + header
    const totales = await _recalcularItemsDesdeDescuentos(client, id_pedido, id_empresa);

    // Actualizar campos informativos del header
    const descMonto = totales.subtotal_sin_iva > 0
        ? Math.round((totales.total_final / (1 - dto / 100) - totales.total_final) * 100) / 100
        : 0;

    await client.query(`
        UPDATE pedidos SET
            descuento_general = $1,
            descuento_monto = $2,
            subtotal_con_descuento = subtotal_sin_iva
        WHERE id_pedido = $3 AND id_empresa = $4
    `, [dto, Math.abs(descMonto), id_pedido, id_empresa]);

    logger.info('[pedidos.helper] Desc general ' + dto + '% aplicado a items pedido #' + id_pedido);

    return {
        subtotal_sin_iva: totales.subtotal_sin_iva,
        descuento_general: dto,
        descuento_monto: Math.abs(descMonto),
        total_iva: totales.total_iva,
        total_final: totales.total_final
    };
}

