        ip_origen]);
}

/**
 * Obtiene historial unificado (pedidos_log + borrador_items_log).
 * Para la vista del "ojo" en facturación.
 */
async function obtenerHistorialPedido(client, id_pedido, id_empresa) {
    const result = await client.query(`
        SELECT created_at AS fecha, accion, 
               detalle_antes, detalle_despues,
               u.nombre AS usuario, 'pedido' AS origen
        FROM pedidos_log pl
        JOIN usuarios u ON pl.id_usuario = u.id_usuario
        WHERE pl.id_pedido = $1 AND pl.id_empresa = $2

        UNION ALL

        SELECT bil.created_at AS fecha, bil.accion,
               jsonb_build_object('cantidad', bil.cantidad_anterior, 'precio', bil.precio_anterior, 'producto', p.nombre) AS detalle_antes,
               jsonb_build_object('cantidad', bil.cantidad, 'precio', bil.precio_unitario, 'producto', p.nombre) AS detalle_despues,
               u.nombre AS usuario, 'item' AS origen
        FROM borrador_items_log bil
        JOIN usuarios u ON bil.id_usuario = u.id_usuario
        LEFT JOIN productos p ON bil.id_producto = p.id_producto
        WHERE bil.id_pedido = $1 AND bil.id_empresa = $2

        ORDER BY fecha DESC
    `, [id_pedido, id_empresa]);

    return result.rows;
}

