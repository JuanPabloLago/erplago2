// 3. ACTUALIZAR ITEM
// ═══════════════════════════════════════════════════════════════════════════
/**
 * Actualiza campos de un item existente (cantidad, precio, descuento).
 * Recalcula IVA y total_linea automáticamente.
 *
 * @param {Object} client
 * @param {Object} datos
 * @param {number} datos.id_item - OBLIGATORIO
 * @param {number} datos.id_empresa - OBLIGATORIO (seguridad)
 * @param {number} [datos.cantidad]
 * @param {number} [datos.precio_unitario_congelado]
 * @param {number} [datos.porcentaje_descuento]
 * @returns {Object} Item actualizado
 */
async function actualizarItem(client, datos) {
    // F5-2026-05-26: acepta monto_iva y total_linea precalculados (mismo contrato que crearItems).
    // Backward compatible: si no vienen, recalcula como antes.
    const { id_item, id_empresa, cantidad, precio_unitario_congelado, porcentaje_descuento,
            monto_iva: montoIvaPrecalc, total_linea: totalLineaPrecalc } = datos;

    if (!id_item) throw new Error('pedidos.helper.actualizarItem: id_item obligatorio');
    if (!id_empresa) throw new Error('pedidos.helper.actualizarItem: id_empresa obligatorio');

    // Obtener item actual
    const { rows: [itemActual] } = await client.query(`
        SELECT * FROM pedidoitems
        WHERE id_item = $1 AND id_empresa = $2
    `, [id_item, id_empresa]);

    if (!itemActual) throw new Error(`pedidos.helper.actualizarItem: item ${id_item} no encontrado para empresa ${id_empresa}`);

    // Determinar nuevos valores (o mantener actuales)
    const nuevaCantidad = cantidad !== undefined ? parseFloat(cantidad) : parseFloat(itemActual.cantidad);
    const nuevoPrecio = precio_unitario_congelado !== undefined ? parseFloat(precio_unitario_congelado) : parseFloat(itemActual.precio_unitario_congelado);
    const nuevoDescuento = porcentaje_descuento !== undefined ? parseFloat(porcentaje_descuento) : parseFloat(itemActual.porcentaje_descuento) || 0;
    const ivaRate = parseFloat(itemActual.iva_aplicado);

    // F5-2026-05-26: si el caller pasó valores precalculados (modo BRUTO_ENTERO), usarlos.
    // Si no, recalculo legacy.
    let montoIva, totalLinea;
    const _mip = parseFloat(montoIvaPrecalc);
    const _tlp = parseFloat(totalLineaPrecalc);
    if (Number.isFinite(_mip) && Number.isFinite(_tlp)) {
        montoIva = _mip;
        totalLinea = _tlp;
    } else {
        const subtotalBruto = nuevoPrecio * nuevaCantidad;
        const descuentoMonto = Math.round(subtotalBruto * nuevoDescuento / 100 * 100) / 100;
        const subtotalNeto = subtotalBruto - descuentoMonto;
        montoIva = Math.round(subtotalNeto * (ivaRate / 100) * 100) / 100;
        totalLinea = Math.round((subtotalNeto + montoIva) * 100) / 100;
    }

    const { rows: [itemActualizado] } = await client.query(`
        UPDATE pedidoitems SET
            cantidad = $1,
            precio_unitario_congelado = $2, precio_unitario_final = $2,
            porcentaje_descuento = $3,
            monto_iva = $4,
            total_linea = $5
        WHERE id_item = $6 AND id_empresa = $7
        RETURNING *
    `, [nuevaCantidad, nuevoPrecio, nuevoDescuento, montoIva, totalLinea, id_item, id_empresa]);

    return {
        item: itemActualizado,
        anterior: {
            cantidad: parseFloat(itemActual.cantidad),
            precio_unitario_congelado: parseFloat(itemActual.precio_unitario_congelado),
            porcentaje_descuento: parseFloat(itemActual.porcentaje_descuento) || 0
        }
    };
}

