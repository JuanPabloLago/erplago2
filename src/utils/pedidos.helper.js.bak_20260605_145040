/**
 * Cambia el estado de un pedido.
 * Usa lookup dinámico (NO hardcodea id_estado numéricos).
 *
 * @param {Object} client
 * @param {Object} datos
 * @param {number} datos.id_pedido
 * @param {number} datos.id_empresa
 * @param {number} datos.nuevo_estado - id_estado numérico (usar PEDIDO_ESTADOS)
 * @param {Object} [datos.campos_extra] - campos adicionales a actualizar junto con el estado
 * @returns {Object} Pedido actualizado
 */
async function cambiarEstado(client, datos) {
    const { id_pedido, id_empresa, nuevo_estado, campos_extra = {} } = datos;

    if (!id_pedido) throw new Error('pedidos.helper.cambiarEstado: id_pedido obligatorio');
    if (!id_empresa) throw new Error('pedidos.helper.cambiarEstado: id_empresa obligatorio');
    if (nuevo_estado === undefined) throw new Error('pedidos.helper.cambiarEstado: nuevo_estado obligatorio');

    // Verificar que el estado existe
    const { rows: estadoRows } = await client.query(
        'SELECT nombre FROM pedidoestados WHERE id_estado = $1',
        [nuevo_estado]
    );
    if (estadoRows.length === 0) throw new Error(`pedidos.helper.cambiarEstado: estado ${nuevo_estado} no existe`);

    // Construir SET dinámico para campos_extra
    const sets = ['id_estado = $1'];
    const params = [nuevo_estado];
    let idx = 2;

    const camposPermitidos = [
        'id_cliente', 'tipo_entrega', 'observaciones', 'descuento_general',
        'estado_entrega', 'domicilio_entrega', 'notas_entrega'
    ];

    for (const [campo, valor] of Object.entries(campos_extra)) {
        if (camposPermitidos.includes(campo)) {
            sets.push(`${campo} = $${idx}`);
            params.push(valor);
            idx++;
        }
    }

    params.push(id_pedido, id_empresa);

    const { rows: [pedido] } = await client.query(`
        UPDATE pedidos SET ${sets.join(', ')}
        WHERE id_pedido = $${idx} AND id_empresa = $${idx + 1}
        RETURNING *
    `, params);

    if (!pedido) throw new Error(`pedidos.helper.cambiarEstado: pedido ${id_pedido} no encontrado`);

    logger.info(`[pedidos.helper] Pedido #${id_pedido} → estado ${nuevo_estado} (${estadoRows[0].nombre})`);
    return pedido;
}

