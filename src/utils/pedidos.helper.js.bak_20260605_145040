// 13. CÁLCULO PURO (sin BD)
// ═══════════════════════════════════════════════════════════════════════════
/**
 * Calcula totales a partir de un array de items.
 * Función pura, sin acceso a BD.
 * Respeta alícuota IVA por item (NO usa 21% flat).
 *
 * @param {Array} items - [{cantidad, precio_unitario, iva_aplicado, porcentaje_descuento, ...}]
 * @param {number} [descuentoPorcentaje=0]
 * @param {number} [descuentoMontoFijo=0]
 * @returns {Object} {items: [...con monto_iva y total_linea], subtotal_sin_iva, descuento_monto, ...}
 */
function calcularTotalesItems(items, descuentoPorcentaje = 0, descuentoMontoFijo = 0) {
    let subtotalSinIva = 0;
    let totalIva = 0;

    const itemsCalculados = items.map(item => {
        const precioUnitario = parseFloat(item.precio_unitario || item.precio_unitario_congelado) || 0;
        const cantidad = parseFloat(item.cantidad) || 0;
        // SOLID: contrato estricto, sin fallback hardcodeado. Acepta 0% válido.
        const alicuotaIvaRaw = parseFloat(item.iva_aplicado);
        if (!Number.isFinite(alicuotaIvaRaw) || alicuotaIvaRaw < 0) {
            throw new Error(`pedidos.helper.calcularTotalesItems: item id_producto=${item.id_producto} sin iva_aplicado válido (recibido: ${item.iva_aplicado})`);
        }
        const alicuotaIva = alicuotaIvaRaw;
        const descuentoLinea = parseFloat(item.porcentaje_descuento) || 0;

        const subtotalLineaSinIva = precioUnitario * cantidad;
        const descuentoLineaMonto = subtotalLineaSinIva * (descuentoLinea / 100);
        const subtotalLineaNeto = subtotalLineaSinIva - descuentoLineaMonto;
        const montoIvaLinea = Math.round(subtotalLineaNeto * (alicuotaIva / 100) * 100) / 100;
        const totalLinea = Math.round((subtotalLineaNeto + montoIvaLinea) * 100) / 100;

        subtotalSinIva += subtotalLineaNeto;
        totalIva += montoIvaLinea;

        return {
            ...item,
            precio_unitario_congelado: precioUnitario,
            monto_iva: montoIvaLinea,
            total_linea: totalLinea,
            iva_aplicado: alicuotaIva,
            porcentaje_descuento: descuentoLinea
        };
    });

    // Descuento general
    const descuentoPorcentajeMonto = subtotalSinIva * (parseFloat(descuentoPorcentaje) / 100);
    const descuentoMonto = descuentoPorcentajeMonto + parseFloat(descuentoMontoFijo || 0);
    const subtotalConDescuento = subtotalSinIva - descuentoMonto;

    // IVA proporcional (respeta alícuotas por item, no aplica 21% flat)
    const proporcion = subtotalSinIva > 0 ? subtotalConDescuento / subtotalSinIva : 1;
    const totalIvaFinal = Math.round(totalIva * proporcion * 100) / 100;
    const totalFinal = Math.round((subtotalConDescuento + totalIvaFinal) * 100) / 100;

    return {
        items: itemsCalculados,
        subtotal_sin_iva: Math.round(subtotalSinIva * 100) / 100,
        descuento_monto: Math.round(descuentoMonto * 100) / 100,
        subtotal_con_descuento: Math.round(subtotalConDescuento * 100) / 100,
        total_iva: totalIvaFinal,
        total_final: totalFinal,
        total: totalFinal
    };
}


