/**
 * Elimina un item de pedidoitems.
 *
 * @param {Object} client
 * @param {Object} datos
 * @param {number} datos.id_item
 * @param {number} datos.id_pedido - para verificación
 * @param {number} datos.id_empresa - seguridad
 * @returns {Object} Item eliminado (para auditoría)
 */
async function eliminarItem(client, datos) {
    const { id_item, id_pedido, id_empresa } = datos;

    if (!id_item) throw new Error('pedidos.helper.eliminarItem: id_item obligatorio');
    if (!id_empresa) throw new Error('pedidos.helper.eliminarItem: id_empresa obligatorio');

    // Obtener antes de eliminar (para auditoría)
    const { rows: [item] } = await client.query(`
        SELECT * FROM pedidoitems
        WHERE id_item = $1 AND id_pedido = $2 AND id_empresa = $3
    `, [id_item, id_pedido, id_empresa]);

    if (!item) throw new Error(`pedidos.helper.eliminarItem: item ${id_item} no encontrado en pedido ${id_pedido}`);

    await client.query(`
        DELETE FROM pedidoitems WHERE id_item = $1 AND id_empresa = $2
    `, [id_item, id_empresa]);

    return item;
}

