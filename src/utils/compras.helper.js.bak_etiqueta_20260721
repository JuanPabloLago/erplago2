async function obtenerHistorialComprasProducto(pool, params) {
    const {
        id_empresa,
        id_producto,
        id_proveedor = null,
        incluir_anulados = false,
        desde = null,
        hasta = null,
        limit = null
    } = params || {};

    if (!id_empresa)  throw new Error('obtenerHistorialComprasProducto: id_empresa requerido');
    if (!id_producto) throw new Error('obtenerHistorialComprasProducto: id_producto requerido');

    // Defaults desde configuraciones_empresa (prefix compras.historial.*)
    const cfg = require('./config.helper');
    const conf = await cfg.getPrefix(pool, id_empresa, 'compras.historial.');
    const limitDefault = parseInt(conf['limit_default'] || '50', 10);
    const limitFinal   = Math.min(Math.max(parseInt(limit, 10) || limitDefault, 1), 500);

    const sql = `
        SELECT
            cc.id_comprobante,
            cc.id_proveedor,
            cc.id_tipo,
            t.nombre           AS tipo_comprobante,
            t.codigo           AS tipo_codigo,
            cc.numero_completo,
            cc.punto_venta,
            cc.numero_comprobante,
            cc.fecha_emision,
            prov.razon_social  AS proveedor_razon_social,
            prov.cuit          AS proveedor_cuit,
            i.cantidad,
            i.precio_unitario,
            COALESCE(i.descuento_porcentaje, 0) AS descuento_porcentaje,
            COALESCE(i.descuento_monto, 0)      AS descuento_monto,
            ROUND(
                (i.precio_unitario
                 * (1 - COALESCE(i.descuento_porcentaje, 0) / 100)
                 - COALESCE(i.descuento_monto, 0))::numeric,
                2
            ) AS precio_neto,
            i.iva_porcentaje,
            i.subtotal,
            i.total,
            COALESCE(m.codigo, 'ARS')      AS moneda_codigo,
            COALESCE(cc.cotizacion, 1)     AS cotizacion,
            -- Snapshot USD del item (nullable — solo compras post-abr/2026)
            i.cotizacion_usada,
            i.precio_unitario_usd,
            i.precio_neto_usd,
            i.total_usd,
            cc.total_moneda_extranjera,
            cc.estado,
            u.nombre AS usuario_carga,
            -- Campos legacy (retrocompat con compras.js viejo)
            prov.razon_social  AS proveedor
        FROM comprobante_compra_items i
        JOIN comprobantes_compra cc      ON cc.id_comprobante = i.id_comprobante
        JOIN comprobante_compra_tipos t  ON t.id_tipo = cc.id_tipo
        JOIN proveedores prov            ON prov.id_proveedor = cc.id_proveedor
        LEFT JOIN monedas m              ON m.id_moneda  = cc.id_moneda
        LEFT JOIN usuarios u             ON u.id_usuario = cc.id_usuario
        WHERE i.id_producto = $1
          AND cc.id_empresa = $2
          AND ($3::boolean = TRUE OR cc.estado <> 'anulado')
          AND ($4::integer IS NULL OR cc.id_proveedor = $4)
          AND ($5::date    IS NULL OR cc.fecha_emision >= $5)
          AND ($6::date    IS NULL OR cc.fecha_emision <= $6)
        ORDER BY cc.fecha_emision DESC, cc.id_comprobante DESC
        LIMIT $7
    `;

    const { rows } = await pool.query(sql, [
        id_producto,
        id_empresa,
        Boolean(incluir_anulados),
        id_proveedor ? parseInt(id_proveedor, 10) : null,
        desde || null,
        hasta || null,
        limitFinal
    ]);
    return rows;
}


