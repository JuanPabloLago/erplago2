const ccProveedores = require('./cc-proveedores.helper');
const cotizacionHelper = require('./cotizacion.helper');
const ivaHelper = require('./iva.helper');
const pool = require('../config/db');
const stockHelper = require('./stock.helper');
const importacionPreciosHelper = require('./importacion-precios.helper');

// ═══════════════════════════════════════════════════════════════
// CONSTANTES
// ═══════════════════════════════════════════════════════════════

const COMPROBANTE_ESTADOS = {
    PENDIENTE: 'pendiente',
    PAGADO_PARCIAL: 'pagado_parcial',
    PAGADO: 'pagado',
    ANULADO: 'anulado'
};

const ORDEN_ESTADOS_VALIDOS = [
    'Borrador', 'Pendiente', 'Confirmada', 'Recibida Parcial',
    'Recibida Total', 'Cancelada', 'Parcial', 'Recibida'
];

// ═══════════════════════════════════════════════════════════════
// ORQUESTADOR PRINCIPAL
// ═══════════════════════════════════════════════════════════════

/**
 * Crea un comprobante completo con todos sus efectos colaterales.
 * Controller solo debe hacer BEGIN → llamar esto → COMMIT/ROLLBACK.
 *
 * @param {pg.Client} client - Cliente de transacción (BEGIN ya hecho)
 * @param {Object} datos - Todos los datos del comprobante
 * @returns {Object} { id_comprobante, numero_completo }
 */
async function crearComprobanteCompleto(client, datos) {
    const {
        id_empresa, id_usuario, id_proveedor, id_tipo,
        punto_venta, numero_comprobante, fecha_emision, fecha_vencimiento,
        items, observaciones,
        // Percepciones (columnas planas)
        percepcion_iva, percepcion_iibb, percepcion_iibb_jurisdiccion,
        impuestos_internos,
        // Opciones
        afecta_stock: opcion_afecta_stock,
        actualizar_precios, marcar_proveedor_preferido,
        nc_devuelve_mercaderia,
        // Moneda
        id_moneda, cotizacion,
        // Vínculos
        // Total del comprobante físico (para diferencia de ajuste)
        total_comprobante: total_comprobante_input
    } = datos;

    // ── 1. Obtener tipo comprobante ──
    const { rows: tipoRows } = await client.query(
        'SELECT * FROM comprobante_compra_tipos WHERE id_tipo = $1', [id_tipo]
    );

    // ── 1-bis. Capturar cotización USD vigente (snapshot inmutable para este comprobante) ──
    // USA pool (no client) para la consulta HTTP a DolarAPI cuando toca sincronizar.
    // Si el front mandó cotizacion explícita la respetamos (override manual).
    let cotizacion_final;
    let cotizacion_meta = null;
    if (cotizacion && parseFloat(cotizacion) > 1) {
        cotizacion_final = parseFloat(cotizacion);
    } else {
        try {
            cotizacion_meta = await cotizacionHelper.obtenerVigenteUSD(pool, id_empresa);
            cotizacion_final = cotizacion_meta && cotizacion_meta.valor > 0 ? cotizacion_meta.valor : null;
        } catch (e) {
            console.warn('[compras.helper] cotización auto falló:', e.message);
            cotizacion_final = null;
        }
    }
    if (tipoRows.length === 0) {
        throw Object.assign(new Error('Tipo de comprobante no encontrado'), { statusCode: 400 });
    }
    const tipo = tipoRows[0];

    // ── 2. Validar items ──
    if (!items || items.length === 0) {
        throw Object.assign(new Error('Debe incluir al menos un item'), { statusCode: 400 });
    }

    // ── 3a. Resolver alícuota IVA por defecto (invariante fiscal: cero hardcoding) ──
    const ivaDef = await ivaHelper.obtenerAlicuotaDefectoParaCreacion(client, id_empresa);
    const iva_pct_default = ivaDef.porcentaje;
    const id_alicuota_default = ivaDef.id_alicuota;

    // ── 3b. Calcular totales server-side (BD manda) ──
    const totales = calcularTotalesServidor(items, {
        discrimina_iva: tipo.discrimina_iva,
        percepcion_iva: percepcion_iva || 0,
        percepcion_iibb: percepcion_iibb || 0,
        impuestos_internos: impuestos_internos || 0,
        iva_porcentaje_default: iva_pct_default
    });

    // ── 4. Crear cabecera ──
    const numeroCompleto = `${tipo.codigo} ${(punto_venta || '').padStart(4, '0')}-${(numero_comprobante || '').padStart(8, '0')}`;
    const diferencia_ajuste = total_comprobante_input
        ? parseFloat((totales.total - total_comprobante_input).toFixed(2))
        : 0;

    const comprobante = await crearComprobante(client, {
        id_empresa, id_proveedor, id_tipo, id_usuario,
        punto_venta, numero_comprobante, numero_completo: numeroCompleto,
        fecha_emision, fecha_vencimiento,
        subtotal: totales.subtotal,
        iva: totales.iva_total,
        iva_21: totales.iva_21,
        iva_105: totales.iva_105,
        iva_27: totales.iva_27,
        iva_0: totales.iva_0,
        percepcion_iva: percepcion_iva || 0,
        percepcion_iibb: percepcion_iibb || 0,
        percepcion_iibb_jurisdiccion: percepcion_iibb_jurisdiccion || null,
        impuestos_internos: impuestos_internos || 0,
        otros_tributos: totales.percepciones,
        total: totales.total,
        total_comprobante: total_comprobante_input || totales.total,
        diferencia_ajuste,
        observaciones,
        afecta_stock: tipo.afecta_stock === true,
        afecta_precios: actualizar_precios || false,
        id_moneda: id_moneda || 1,
        cotizacion: cotizacion_final,        nc_devuelve_mercaderia: nc_devuelve_mercaderia || false,
        total_moneda_extranjera: cotizacion_final && cotizacion_final > 0 ? +(totales.total / cotizacion_final).toFixed(2) : null
    });
    const id_comprobante = comprobante.id_comprobante;

    // ── 5. Preparar e insertar items (server calcula cada línea, incluye USD snapshot) ──
    const _cot = (cotizacion_final && cotizacion_final > 0) ? cotizacion_final : null;
    const itemsCalculados = items.map(item => {
        const dto_pct = parseFloat(item.descuento_porcentaje) || 0;
        const dto_monto = parseFloat(item.descuento_monto) || 0;
        const precio = parseFloat(item.precio_unitario) || 0;
        const cant = parseFloat(item.cantidad) || 1;
        const precioConDescuento = precio * (1 - dto_pct / 100) - dto_monto;
        const subtotalItem = +(precioConDescuento * cant).toFixed(2);
        const iva_pct = parseFloat(item.iva_porcentaje) || iva_pct_default;
        const iva_monto = tipo.discrimina_iva ? +(subtotalItem * iva_pct / 100).toFixed(2) : 0;

        return {
            ...item,
            cantidad: cant,
            precio_unitario: precio,
            descuento_porcentaje: dto_pct,
            descuento_monto: dto_monto,
            iva_porcentaje: iva_pct,
            iva_monto,
            subtotal: subtotalItem,
            total: +(subtotalItem + iva_monto).toFixed(2),
            precioConDescuento: +precioConDescuento.toFixed(4)
        };
    });

    await insertarComprobanteItems(client, {
        id_empresa, id_comprobante, items: itemsCalculados,
        cotizacion_usada: cotizacion_final
    });

    // ── 6. Stock (si el tipo lo permite — la BD manda) ──
    // (regla post-refactor 2026-04: el frontend NO puede saltearse stock)
    if (datos.opcion_afecta_stock !== undefined || datos.afecta_stock !== undefined) {
        console.warn('[compras.helper] flag afecta_stock del body IGNORADO. Tipo: ' + tipo.codigo + ' (afecta_stock=' + tipo.afecta_stock + ')');
    }
    if (tipo.afecta_stock === true) {
        for (const item of itemsCalculados) {
            if (!item.id_producto || item.afecta_stock === false) continue;

            const cantidadStock = parseInt(item.cantidad_stock || item.cantidad);
            const esNC = tipo.codigo === 'NC' && nc_devuelve_mercaderia;
            const multiplicador = esNC ? -1 : 1;

            const id_deposito = await stockHelper.obtenerDepositoUsuario(client, { id_empresa, id_usuario });
            await stockHelper.moverStock(client, {
                id_empresa,
                id_deposito,
                id_producto: item.id_producto,
                cantidad: cantidadStock * multiplicador,
                tipo_movimiento: multiplicador > 0
                    ? stockHelper.TIPOS_MOVIMIENTO.COMPRA
                    : stockHelper.TIPOS_MOVIMIENTO.DEVOLUCION_COMPRA,
                id_usuario,
                documento_referencia: `Comprobante ${numeroCompleto}`,
                id_comprobante_compra: id_comprobante
            });
        }
    }

    // ── 7. Cuenta corriente (si tipo lo permite) ──
    let cuentaPorPagar = null;
    // CC: SOLO la BD decide. afecta_cuenta del tipo de comprobante manda.
    // (regla post-refactor 2026-04: el frontend NO puede saltearse CxP+CC)
    if (datos.genera_deuda_cc !== undefined) {
        console.warn('[compras.helper] flag genera_deuda_cc del body IGNORADO. Tipo: ' + tipo.codigo + ' (afecta_cuenta=' + tipo.afecta_cuenta + ')');
    }
    var generaDeuda = Number(tipo.afecta_cuenta) !== 0;
    if (generaDeuda) {
        // 7a. Cuentas por pagar (deuda con vencimiento)
        const montoMovimiento = Math.abs(totales.total * tipo.afecta_cuenta);
        const tipoMovimiento = tipo.afecta_cuenta > 0 ? 'compra' : 'nota_credito';
        cuentaPorPagar = await crearMovimientoCuenta(client, {
            id_empresa, id_proveedor, id_comprobante,
            tipo_movimiento: tipoMovimiento,
            monto: montoMovimiento,
            fecha_vencimiento: fecha_vencimiento || fecha_emision,
            referencia: numeroCompleto
        });

        // 7b. CC proveedores (libro contable)
        await registrarCompraEnCC(client, {
            id_empresa, id_proveedor, id_comprobante,
            numero_completo: numeroCompleto,
            total: totales.total,
            afecta_cuenta: tipo.afecta_cuenta
        });
    }

    // ── 8. Actualizar precios proveedor ──
    if (actualizar_precios) {
        for (const item of itemsCalculados) {
            if (!item.id_producto) continue;
            await actualizarPrecioCompra(client, {
                id_empresa,
                id_producto: item.id_producto,
                id_proveedor,
                precio_compra: item.precio_unitario,
                descuento_porcentaje: item.descuento_porcentaje,
                precio_neto: item.precioConDescuento
            });
            // Marcar proveedor preferido si se pidió
            if (marcar_proveedor_preferido) {
                // Quitar preferido anterior para este producto
                await client.query(
                    'UPDATE producto_proveedor SET es_proveedor_preferido = false WHERE id_empresa = $1 AND id_producto = $2 AND es_proveedor_preferido = true',
                    [id_empresa, item.id_producto]
                );
                await client.query(
                    'UPDATE producto_proveedor SET es_proveedor_preferido = true WHERE id_empresa = $1 AND id_producto = $2 AND id_proveedor = $3',
                    [id_empresa, item.id_producto, id_proveedor]
                );
            }
            // Actualizar costo_vigente si este es el proveedor preferido
            await importacionPreciosHelper.actualizarCostoVigente(client, {
                id_empresa, id_producto: item.id_producto
            });
        }
    }


    // ── 10. Pago inmediato (opcional — si datos.pago viene con formas_pago) ──
    // Permite que compras.html registre el pago en la misma transacción.
    // Si no viene datos.pago → queda como CC (comportamiento actual sin cambios).
    var resultadoPago = null;
    if (datos.pago && datos.pago.formas_pago && datos.pago.formas_pago.length > 0) {
        // Lazy require: evita dependencia circular compras↔pagos-proveedores
        var pagosProvHelper = require('./pagos-proveedores.helper');

        var totalPago = datos.pago.formas_pago.reduce(function(s, fp) {
            return s + parseFloat(fp.monto || 0);
        }, 0);

        // Si hay CxP recién creado, imputar el pago contra esa deuda
        var facturasAImputar = [];
        if (cuentaPorPagar && cuentaPorPagar.id_cuenta) {
            var montoImputar = Math.min(totalPago, parseFloat(cuentaPorPagar.saldo || cuentaPorPagar.monto));
            facturasAImputar.push({
                id_cuenta: cuentaPorPagar.id_cuenta,
                monto_a_pagar: montoImputar
            });
        }

        var esPagoACuenta = facturasAImputar.length === 0;

        resultadoPago = await pagosProvHelper.registrarPagoProveedorCompleto(client, {
            id_empresa: id_empresa,
            id_proveedor: id_proveedor,
            id_usuario: id_usuario,
            id_comprobante: id_comprobante,
            formas_pago: datos.pago.formas_pago,
            facturas_a_pagar: esPagoACuenta ? undefined : facturasAImputar,
            es_pago_a_cuenta: esPagoACuenta,
            observaciones: datos.pago.observaciones || null
        });
    }

    return {
        id_comprobante: id_comprobante,
        numero_completo: numeroCompleto,
        pago: resultadoPago
    };
}

