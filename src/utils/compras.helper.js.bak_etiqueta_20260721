async function registrarCompraEnCC(client, datos) {
    const { id_empresa, id_proveedor, id_comprobante, numero_completo, total, afecta_cuenta } = datos;
    // La BD manda: afecta_cuenta < 0 (NC) asienta HABER; resto asienta DEBE.
    const fnCC = Number(afecta_cuenta) < 0 ? ccProveedores.registrarNotaCredito : ccProveedores.registrarCompra;
    await fnCC(client, {
        id_empresa, id_proveedor,
        id_comprobante_compra: id_comprobante,
        numero_completo, total
    });
}

async function anularCompraEnCC(client, datos) {
    const { id_empresa, id_proveedor, id_comprobante, numero_completo, total, afecta_cuenta } = datos;
    // La BD manda: anular una NC asienta DEBE (revierte el haber); resto asienta HABER.
    const fnCC = Number(afecta_cuenta) < 0 ? ccProveedores.anularNotaCredito : ccProveedores.anularCompra;
    await fnCC(client, {
        id_empresa, id_proveedor,
        id_comprobante_compra: id_comprobante,
        numero_completo, total
    });
}


