async function crearMovimientoCuenta(client, datos) {
    const {
        id_empresa, id_proveedor, id_comprobante, tipo_movimiento,
        monto, saldo, fecha_vencimiento, referencia, observaciones
    } = datos;

    const result = await client.query(`
        INSERT INTO cuentas_por_pagar (
            id_empresa, id_proveedor, id_comprobante, tipo_movimiento,
            monto, saldo, fecha_vencimiento, referencia, observaciones
        ) VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)
        RETURNING *
    `, [
        id_empresa, id_proveedor, id_comprobante || null, tipo_movimiento,
        monto, saldo !== undefined ? saldo : monto,
        fecha_vencimiento || null, referencia || null, observaciones || null
    ]);
    return result.rows[0];
}

async function eliminarMovimientoCuenta(client, datos) {
    const { id_comprobante, id_empresa } = datos;
    // H19: id_empresa OBLIGATORIO. Sin filtro multi-empresa, un DELETE
    // podria borrar CxP de OTRA empresa que tenga el mismo id_comprobante.
    if (!id_empresa) {
        throw Object.assign(
            new Error('compras.helper.eliminarMovimientoCuenta: id_empresa obligatorio'),
            { statusCode: 500, code: 'ID_EMPRESA_REQUIRED' }
        );
    }
    if (!id_comprobante) {
        throw Object.assign(
            new Error('compras.helper.eliminarMovimientoCuenta: id_comprobante obligatorio'),
            { statusCode: 500, code: 'ID_COMPROBANTE_REQUIRED' }
        );
    }
    await client.query(
        'DELETE FROM cuentas_por_pagar WHERE id_comprobante = $1 AND id_empresa = $2',
        [id_comprobante, id_empresa]
    );
}

async function revertirSaldoCuenta(client, datos) {
    const { id_cuenta, monto } = datos;
    await client.query(
        `UPDATE cuentas_por_pagar SET saldo = saldo + $1 WHERE id_cuenta = $2`,
        [monto, id_cuenta]
    );
}

