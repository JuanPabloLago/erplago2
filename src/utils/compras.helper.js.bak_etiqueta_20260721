    var idx = 2;
    if (q)       { where.push('cc.busqueda_texto ILIKE $' + idx); params.push('%' + q + '%'); idx++; }
    if (id_tipo) { where.push('cc.id_tipo = $' + idx); params.push(id_tipo); idx++; }
    if (estado)  { where.push('cc.estado = $' + idx); params.push(estado); idx++; }
    if (desde)   { where.push('cc.fecha_emision >= $' + idx); params.push(desde); idx++; }
    if (hasta)   { where.push('cc.fecha_emision <= $' + idx); params.push(hasta); idx++; }

    var sql = 'SELECT cc.numero_completo, t.nombre AS tipo, prov.razon_social AS proveedor,' +
        ' cc.fecha_emision, prod.codigo AS codigo_producto, i.descripcion,' +
        ' i.cantidad, i.precio_unitario, i.descuento_porcentaje, i.iva_porcentaje,' +
        ' i.subtotal, i.total, cc.estado' +
        ' FROM comprobante_compra_items i' +
        ' JOIN comprobantes_compra cc ON cc.id_comprobante = i.id_comprobante' +
        ' JOIN comprobante_compra_tipos t ON t.id_tipo = cc.id_tipo' +
        ' JOIN proveedores prov ON prov.id_proveedor = cc.id_proveedor' +
        ' LEFT JOIN productos prod ON prod.id_producto = i.id_producto' +
        ' WHERE ' + where.join(' AND ') +
        ' ORDER BY cc.fecha_emision DESC, cc.id_comprobante, i.id_item';
    var { rows } = await pool.query(sql, params);
    return rows;
}

