// ANULAR COMPROBANTE COMPLETO
// ═══════════════════════════════════════════════════════════════

/**
 * Anulación completa: revierte stock, CC, cuentas por pagar.
 * Controller solo hace BEGIN → llamar esto → COMMIT/ROLLBACK.
 */
async function anularComprobanteCompleto(client, datos) {
    const { id_comprobante, id_empresa, id_usuario, motivo } = datos;

    // 1. Obtener comprobante + tipo
    const { rows } = await client.query(`
        SELECT cc.*, cct.afecta_stock as tipo_afecta_stock, cct.afecta_cuenta as tipo_afecta_cuenta, cct.codigo as tipo_codigo
        FROM comprobantes_compra cc
        JOIN comprobante_compra_tipos cct ON cct.id_tipo = cc.id_tipo
        WHERE cc.id_comprobante = $1 AND cc.id_empresa = $2
    `, [id_comprobante, id_empresa]);

    if (rows.length === 0) {
        throw Object.assign(new Error('Comprobante no encontrado'), { statusCode: 404 });
    }
    const comp = rows[0];

    if (comp.estado === COMPROBANTE_ESTADOS.ANULADO) {
        throw Object.assign(new Error('El comprobante ya está anulado'), { statusCode: 400 });
    }

    // 2. Revertir stock
    if (comp.tipo_afecta_stock && comp.afecta_stock) {
        const { rows: items } = await client.query(
            'SELECT * FROM comprobante_compra_items WHERE id_comprobante = $1 AND id_empresa = $2', [id_comprobante, id_empresa]
        );

        for (const item of items) {
            if (!item.id_producto || !item.afecta_stock) continue;
            const cantidadStock = parseFloat(item.cantidad_stock || item.cantidad);
            const multiplicador = comp.tipo_codigo === 'NC' ? 1 : -1;
            const id_deposito = await stockHelper.obtenerDepositoUsuario(client, { id_empresa, id_usuario });

            await stockHelper.moverStock(client, {
                id_empresa, id_deposito,
                id_producto: item.id_producto,
                cantidad: cantidadStock * multiplicador,
                tipo_movimiento: stockHelper.TIPOS_MOVIMIENTO.ANULACION,
                id_usuario,
                documento_referencia: `Anulación ${comp.numero_completo}`,
                id_comprobante_compra: id_comprobante
            });
        }
    }

    // 3. Revertir CC + cuentas por pagar
    if (Number(comp.tipo_afecta_cuenta) !== 0) {
        await eliminarMovimientoCuenta(client, { id_comprobante, id_empresa });
        await anularCompraEnCC(client, {
            id_empresa,
            id_proveedor: comp.id_proveedor,
            id_comprobante,
            numero_completo: comp.numero_completo,
            total: parseFloat(comp.total),
            afecta_cuenta: comp.tipo_afecta_cuenta
        });
    }

    // 4. Marcar como anulado
    await anularComprobante(client, { id_comprobante, motivo });

    return { id_comprobante, estado: COMPROBANTE_ESTADOS.ANULADO };
}

