async function obtenerComprobantesParaExport(pool, { id_empresa, filtros = {} }) {
    var { q, id_tipo, estado, desde, hasta } = filtros;
    var where = ['cc.id_empresa = $1'];
    var params = [id_empresa];
    var idx = 2;
    if (q)       { where.push('cc.busqueda_texto ILIKE $' + idx); params.push('%' + q + '%'); idx++; }
    if (id_tipo) { where.push('cc.id_tipo = $' + idx); params.push(id_tipo); idx++; }
    if (estado)  { where.push('cc.estado = $' + idx); params.push(estado); idx++; }
    if (desde)   { where.push('cc.fecha_emision >= $' + idx); params.push(desde); idx++; }
    if (hasta)   { where.push('cc.fecha_emision <= $' + idx); params.push(hasta); idx++; }

    var sql = 'SELECT cc.numero_completo, t.nombre AS tipo, p.razon_social AS proveedor, p.cuit,' +
        ' cc.fecha_emision, cc.fecha_vencimiento, cc.subtotal, cc.iva,' +
        ' cc.percepcion_iva, cc.percepcion_iibb, cc.impuestos_internos,' +
        ' cc.otros_tributos, cc.total, cc.estado, cc.cae, cc.observaciones' +
        ' FROM comprobantes_compra cc' +
        ' JOIN comprobante_compra_tipos t ON t.id_tipo = cc.id_tipo' +
        ' JOIN proveedores p ON p.id_proveedor = cc.id_proveedor' +
        ' WHERE ' + where.join(' AND ') +
        ' ORDER BY cc.fecha_emision DESC, cc.id_comprobante DESC';
    var { rows } = await pool.query(sql, params);
    return rows;
}

async function obtenerItemsParaExport(pool, { id_empresa, filtros = {} }) {
    var { q, id_tipo, estado, desde, hasta } = filtros;
