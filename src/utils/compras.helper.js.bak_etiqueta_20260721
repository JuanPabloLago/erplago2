async function obtenerUltimoComprobante(pool, { id_empresa, id_proveedor }) {
    const { rows } = await pool.query(`
        SELECT cc.id_comprobante, cc.numero_completo, cc.punto_venta,
               cc.numero_comprobante, cc.fecha_emision, cc.total, cc.estado,
               cct.codigo as tipo_codigo, cct.nombre as tipo_nombre
        FROM comprobantes_compra cc
        JOIN comprobante_compra_tipos cct ON cct.id_tipo = cc.id_tipo
        WHERE cc.id_empresa = $1 AND cc.id_proveedor = $2 AND cc.estado != 'anulado'
        ORDER BY cc.fecha_emision DESC, cc.id_comprobante DESC
        LIMIT 1
    `, [id_empresa, id_proveedor]);
    return rows[0] || null;
}

async function sugerirSiguienteNumero(pool, { id_empresa, id_proveedor, punto_venta }) {
    const { rows } = await pool.query(`
        SELECT MAX(numero_comprobante::bigint) as ultimo_numero
        FROM comprobantes_compra
        WHERE id_empresa = $1 AND id_proveedor = $2
          AND punto_venta = $3 AND estado != 'anulado'
    `, [id_empresa, id_proveedor, punto_venta]);
    const ultimo = rows[0] && rows[0].ultimo_numero ? parseInt(rows[0].ultimo_numero) : 0;
    return String(ultimo + 1).padStart(8, '0');
}

async function validarNumeroExistente(pool, { id_empresa, id_proveedor, punto_venta, numero_comprobante }) {
    const { rows } = await pool.query(`
        SELECT id_comprobante, numero_completo, estado, total, fecha_emision
        FROM comprobantes_compra
        WHERE id_empresa = $1 AND id_proveedor = $2
          AND punto_venta = $3 AND numero_comprobante = $4
        LIMIT 1
    `, [id_empresa, id_proveedor, punto_venta, numero_comprobante]);
    return rows[0] || null;
}

async function obtenerConfigsCompras(pool, { id_empresa }) {
    // Lee de configuraciones_empresa con prefijo compras.* (post-refactor 2026-04)
    // Las claves se devuelven SIN el prefijo "compras." para uso simplificado en frontend.
    const { rows } = await pool.query(`
        SELECT clave, valor FROM configuraciones_empresa
        WHERE clave LIKE 'compras.%' AND id_empresa = $1
    `, [id_empresa]);
    const configs = {};
    rows.forEach(r => {
        // "compras.punto_venta_default" -> "compras_punto_venta_default" (compatibilidad frontend)
        const claveCompat = r.clave.replace(/\./g, '_');
        configs[claveCompat] = r.valor;
        // Tambien con prefijo punto para uso directo
        configs[r.clave] = r.valor;
    });
    return configs;
}

