/**
 * Calcula totales desde items. Frontend puede sugerir, pero esto manda.
 */
function calcularTotalesServidor(items, config = {}) {
    const { discrimina_iva = true, percepcion_iva = 0, percepcion_iibb = 0, impuestos_internos = 0,
            iva_porcentaje_default } = config;

    // Invariante fiscal: el caller DEBE resolver la alícuota default via
    // ivaHelper.obtenerAlicuotaDefectoParaCreacion(client, id_empresa).
    // Esta función es PURA y no accede a BD.
    if (discrimina_iva && (iva_porcentaje_default === undefined || iva_porcentaje_default === null)) {
        throw new Error('compras.helper.calcularTotalesServidor: config.iva_porcentaje_default es obligatorio cuando discrimina_iva=true');
    }

    let subtotal = 0, iva_21 = 0, iva_105 = 0, iva_27 = 0, iva_0 = 0;

    for (const item of items) {
        const precio = parseFloat(item.precio_unitario) || 0;
        const cant = parseFloat(item.cantidad) || 1;
        const dto_pct = parseFloat(item.descuento_porcentaje) || 0;
        const dto_monto = parseFloat(item.descuento_monto) || 0;
        const precioConDto = precio * (1 - dto_pct / 100) - dto_monto;
        const subtotalItem = +(precioConDto * cant).toFixed(2);
        subtotal += subtotalItem;

        if (discrimina_iva) {
            const iva_pct = parseFloat(item.iva_porcentaje) || iva_porcentaje_default;
            const ivaMonto = +(subtotalItem * iva_pct / 100).toFixed(2);
            if (iva_pct === 21) iva_21 += ivaMonto;
            else if (iva_pct === 10.5) iva_105 += ivaMonto;
            else if (iva_pct === 27) iva_27 += ivaMonto;
            else iva_0 += ivaMonto;
        }
    }

    const iva_total = +(iva_21 + iva_105 + iva_27).toFixed(2);
    const percepciones = +(percepcion_iva + percepcion_iibb + impuestos_internos).toFixed(2);
    const total = +(subtotal + iva_total + percepciones).toFixed(2);

    return {
        subtotal: +subtotal.toFixed(2),
        iva_21: +iva_21.toFixed(2),
        iva_105: +iva_105.toFixed(2),
        iva_27: +iva_27.toFixed(2),
        iva_0: +iva_0.toFixed(2),
        iva_total,
        percepciones,
        total
    };
}

