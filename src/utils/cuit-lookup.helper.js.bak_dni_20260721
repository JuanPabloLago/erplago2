/**
 * ═══════════════════════════════════════════════════════════════
 * CUIT LOOKUP HELPER — ERP LAGO
 * Reutilizable para proveedores Y clientes
 *
 * Estrategia de búsqueda:
 *   1. BD local (proveedores + clientes)
 *   2. AFIP oficial: Constancia de Inscripcion -> A13 (fallback)
 *
 * CONSUMIDORES: compras.controller, clientes.controller, proveedores.controller
 * ═══════════════════════════════════════════════════════════════
 */

var https = require('https');
var http = require('http');

var CONDICION_IVA_MAP = {
    'IVA Responsable Inscripto': 1,
    'Responsable Inscripto': 1,
    'IVA Responsable No Inscripto': 1,
    'Responsable Monotributo': 2,
    'Monotributo': 2,
    'Monotributo Social': 2,
    'IVA Sujeto Exento': 3,
    'Exento': 3,
    'Consumidor Final': 4,
    'IVA No Alcanzado': 3
};

function limpiarCuit(cuit) {
    return (cuit || '').replace(/[-\s]/g, '').trim();
}

function validarCuit(cuit) {
    var limpio = limpiarCuit(cuit);
    if (!/^\d{11}$/.test(limpio)) return false;
    var mult = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2];
    var sum = 0;
    for (var i = 0; i < 10; i++) sum += parseInt(limpio[i]) * mult[i];
    var mod = 11 - (sum % 11);
    if (mod === 11) mod = 0;
    if (mod === 10) mod = 9;
    return mod === parseInt(limpio[10]);
}

function formatearCuit(cuit) {
    var l = limpiarCuit(cuit);
    if (l.length === 11) return l.substring(0, 2) + '-' + l.substring(2, 10) + '-' + l.substring(10);
    return cuit;
}

/**
 * Buscar en BD local (proveedores y clientes)
 */
async function buscarEnLocal(pool, id_empresa, cuit) {
    var cuitLimpio = limpiarCuit(cuit);
    var cuitFormateado = formatearCuit(cuit);

    // Buscar en proveedores
    var resProv = await pool.query(
        "SELECT id_proveedor as id, razon_social, nombre_fantasia, cuit, id_condicion_iva, telefono, email, domicilio, 'proveedor' as origen FROM proveedores WHERE id_empresa = $1 AND (REPLACE(cuit, '-', '') = $2 OR cuit = $3) AND activo = true LIMIT 1",
        [id_empresa, cuitLimpio, cuitFormateado]
    );
    if (resProv.rows.length > 0) return resProv.rows[0];

    // Buscar en clientes
    var resCli = await pool.query(
        "SELECT id_cliente as id, razon_social, razon_social as nombre_fantasia, cuit_cuil as cuit, id_condicion_iva, telefono, email, domicilio, 'cliente' as origen FROM clientes WHERE id_empresa = $1 AND (REPLACE(cuit_cuil, '-', '') = $2 OR cuit_cuil = $3) AND activo = true LIMIT 1",
        [id_empresa, cuitLimpio, cuitFormateado]
    );
    if (resCli.rows.length > 0) return resCli.rows[0];

    return null;
}

/**
 * Consulta AFIP pura (sin BD local). Para botones "Buscar AFIP" de modales.
 * Cascada: Constancia de Inscripcion (datos completos + IVA derivada)
 *          -> A13 (solo identidad; IVA se fuerza a null porque A13 no
 *             trae datos impositivos y su parser tiene default legacy)
 * Lanza error si ambos servicios fallan.
 */
async function consultarPadron(cuit) {
    var cuitLimpio = limpiarCuit(cuit);
    var afipService = require('../services/afip.service');
    try {
        return await afipService.consultarConstancia(cuitLimpio);
    } catch (e) {
        console.error('AFIP Constancia error, fallback A13:', e.message);
        var datos = await afipService.consultarPadronA5(cuitLimpio);
        datos.id_condicion_iva = null;
        datos.condicion_iva_descripcion = null;
        datos.origen = 'afip_a13';
        return datos;
    }
}

/**
 * Buscar via AFIP Padrón A5 (SOAP con certificados propios)
 */
function buscarEnAPI(cuit) {
    var cuitLimpio = limpiarCuit(cuit);
    return new Promise(function(resolve) {
        var timeout = setTimeout(function() { resolve(null); }, 15000);
        try {
            consultarPadron(cuitLimpio).then(function(datos) {
                clearTimeout(timeout);
                resolve(datos);
            }).catch(function(err) {
                clearTimeout(timeout);
                console.error('AFIP Padron error:', err.message);
                resolve(null);
            });
        } catch(e) {
            clearTimeout(timeout);
            console.error('AFIP require error:', e.message);
            resolve(null);
        }
    });
}

/**
 * Búsqueda principal: local → API
 * @returns {Object|null} { razon_social, cuit, id_condicion_iva, ..., origen: 'proveedor'|'cliente'|'afip' }
 */
async function buscarCuit(pool, id_empresa, cuit) {
    if (!validarCuit(cuit)) {
        return { error: 'CUIT inválido (debe tener 11 dígitos y pasar validación)' };
    }

    // 1. Local
    var local = await buscarEnLocal(pool, id_empresa, cuit);
    if (local) return local;

    // 2. API externa
    var externo = await buscarEnAPI(cuit);
    if (externo) return externo;

    // 3. Nada encontrado
    return { cuit: formatearCuit(cuit), origen: 'no_encontrado' };
}

module.exports = {
    buscarCuit: buscarCuit,
    consultarPadron: consultarPadron,
    validarCuit: validarCuit,
    formatearCuit: formatearCuit,
    limpiarCuit: limpiarCuit
};
