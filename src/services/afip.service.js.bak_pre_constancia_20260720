/**
 * Mapea porcentaje IVA a ID de alícuota AFIP
 */
function alicuotaAFIP(porcentajeIva) {
    const mapeo = {
        0: 3,
        2.5: 9,
        5: 8,
        10.5: 4,
        21: 5,
        27: 6,
    };
    return mapeo[parseFloat(porcentajeIva)] || 5; // default 21%
}

/**
 * Agrupa items por alícuota IVA para el detalle de AFIP
 * @param {Array} items - Array de items con { subtotal, porcentaje_iva, iva_calculado }
 * @returns {Array} [{ id_alicuota, base_imponible, importe }]
 */
function agruparIVAPorAlicuota(items) {
    const grupos = {};

    items.forEach(item => {
        const _pctRaw = item.porcentaje_iva ?? item.iva_aplicado;
        if (_pctRaw == null || isNaN(parseFloat(_pctRaw))) {
            throw new Error(`agruparIVAPorAlicuota: item sin alicuota IVA resoluble: ${JSON.stringify(item)}`);
        }
        const pct = parseFloat(_pctRaw);
        const idAlic = alicuotaAFIP(pct);

        if (!grupos[idAlic]) {
            grupos[idAlic] = { id_alicuota: idAlic, base_imponible: 0, importe: 0 };
        }
        // Calcular base: total_linea - monto_iva, o precio * cantidad
        const base = parseFloat(item.subtotal || item.neto || 0) 
            || (parseFloat(item.total_linea || 0) - parseFloat(item.monto_iva || 0))
            || (parseFloat(item.precio_unitario_congelado || item.precio_unitario || 0) * parseFloat(item.cantidad || 1));
        grupos[idAlic].base_imponible += base;
        grupos[idAlic].importe += parseFloat(item.iva_calculado || item.monto_iva || 0);
    });

    // Redondear a 2 decimales
    return Object.values(grupos).map(g => ({
        id_alicuota: g.id_alicuota,
        base_imponible: Math.round(g.base_imponible * 100) / 100,
        importe: Math.round(g.importe * 100) / 100,
    }));
}

/**
 * Carga configuración AFIP desde BD
 */
async function cargarConfiguracion(pool, id_empresa) {
    try {
        const { rows } = await pool.query(`
            SELECT clave, valor FROM configuraciones_empresa
            WHERE id_empresa = $1
              AND clave IN ('afip_cuit', 'afip_cert_path', 'afip_key_path', 'afip_env', 'afip_offline')
        `, [id_empresa]);

        rows.forEach(r => {
            switch (r.clave) {
                case 'afip_cuit': config.cuit = r.valor; break;
                case 'afip_cert_path': config.certPath = r.valor; break;
                case 'afip_key_path': config.keyPath = r.valor; break;
                case 'afip_env': config.env = r.valor; break;
                case 'afip_offline': config.modoOffline = r.valor === 'true'; break;
            }
        });

        logger.info(`AFIP: Config cargada - env=${config.env}, cuit=${config.cuit}, offline=${config.modoOffline}`);
    } catch (error) {
        logger.warn('AFIP: No se pudo cargar config de BD, usando env vars:', error.message);
    }
}

/**
 * Formatea fecha a YYYYMMDD para AFIP
 */
function formatearFechaAFIP(fecha) {
    if (!fecha) {
        const hoy = new Date();
        return hoy.toISOString().split('T')[0].replace(/-/g, '');
    }
    if (fecha instanceof Date) {
        return fecha.toISOString().split('T')[0].replace(/-/g, '');
    }
    return String(fecha).replace(/-/g, '').substring(0, 8);
}

/**
 * Parsea fecha AFIP (YYYYMMDD) a Date
 */
function parsearFechaAFIP(fechaStr) {
    if (!fechaStr || fechaStr.length < 8) return null;
    const y = fechaStr.substring(0, 4);
    const m = fechaStr.substring(4, 6);
    const d = fechaStr.substring(6, 8);
    return new Date(`${y}-${m}-${d}`);
}

