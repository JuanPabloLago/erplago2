/**
 * Genera el TRA (Ticket de Requerimiento de Acceso) firmado
 */
function generarTRA(service = 'wsfe') {
    const now = new Date();
    const expiration = new Date(now.getTime() + 12 * 60 * 60 * 1000); // 12 horas

    const tra = `<?xml version="1.0" encoding="UTF-8"?>
<loginTicketRequest version="1.0">
    <header>
        <uniqueId>${Math.floor(Date.now() / 1000)}</uniqueId>
        <generationTime>${now.toISOString()}</generationTime>
        <expirationTime>${expiration.toISOString()}</expirationTime>
    </header>
    <service>${service}</service>
</loginTicketRequest>`;

    return tra;
}

/**
 * Firma el TRA con el certificado y clave privada usando CMS (PKCS#7)
 */
function firmarTRA(tra) {
    const certContent = fs.readFileSync(config.certPath, 'utf8');
    const keyContent = fs.readFileSync(config.keyPath, 'utf8');

    // Crear firma PKCS#7 (CMS)
    const sign = crypto.createSign('RSA-SHA256');
    sign.update(tra);
    const signature = sign.sign(keyContent);

    // Construir CMS manualmente o usar openssl
    // NOTA: Node.js nativo no soporta CMS/PKCS7 directamente.
    // Usamos openssl via child_process como método más confiable.
    const { execSync } = require('child_process');
    const tmpDir = '/tmp/afip_' + Date.now();
    fs.mkdirSync(tmpDir, { recursive: true });

    const traPath = path.join(tmpDir, 'tra.xml');
    const cmsPath = path.join(tmpDir, 'tra.cms');

    fs.writeFileSync(traPath, tra);

    try {
        execSync(
            `openssl cms -sign -in "${traPath}" -out "${cmsPath}" -signer "${config.certPath}" ` +
            `-inkey "${config.keyPath}" -nodetach -outform PEM`,
            { timeout: 10000 }
        );

        let cms = fs.readFileSync(cmsPath, 'utf8');
        // Limpiar headers PEM
        cms = cms.replace(/-----BEGIN CMS-----/g, '')
                 .replace(/-----END CMS-----/g, '')
                 .replace(/\r?\n/g, '');

        return cms;
    } finally {
        // Limpiar archivos temporales
        try {
            fs.rmSync(tmpDir, { recursive: true });
        } catch (e) { /* ignorar */ }
    }
}

/**
 * Obtiene Token y Sign del WSAA
 * Se cachea por 12 horas
 */
async function obtenerTokenSign() {
    // Verificar cache
    if (tokenCache.token && tokenCache.expiresAt && new Date() < tokenCache.expiresAt) {
        return { token: tokenCache.token, sign: tokenCache.sign };
    }

    logger.info('AFIP: Solicitando nuevo token WSAA...');

    const tra = generarTRA('wsfe');
    const cms = firmarTRA(tra);

    const urls = URLS[config.env];
    const client = await soap.createClientAsync(urls.wsaa);

    const result = await client.loginCmsAsync({ in0: cms });
    const loginResult = result[0]?.loginCmsReturn;

    if (!loginResult) {
        throw new Error('AFIP WSAA: Respuesta vacía');
    }

    // Parsear XML de respuesta
    const parsed = await parseStringPromise(loginResult);
    const credentials = parsed.loginTicketResponse?.credentials?.[0];

    if (!credentials) {
        throw new Error('AFIP WSAA: No se obtuvieron credenciales');
    }

    tokenCache = {
        token: credentials.token[0],
        sign: credentials.sign[0],
        expiresAt: new Date(Date.now() + 11 * 60 * 60 * 1000), // 11hs (margen)
    };

    logger.info('AFIP: Token WSAA obtenido correctamente');

    return { token: tokenCache.token, sign: tokenCache.sign };
}

