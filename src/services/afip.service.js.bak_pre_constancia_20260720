/**
 * Valida tope de Consumidor Final según RG vigente
 * @param {number} total - Monto total de la operación
 * @param {number} idCondicionIva - Condición IVA del cliente
 * @param {string} metodoPago - 'efectivo', 'tarjeta', etc.
 * @returns {{ valido: boolean, mensaje?: string }}
 */
function validarTopeConsumidorFinal(total, idCondicionIva, metodoPago, topesConfig = null) {
    // Condición IVA 4 = Consumidor Final (según tabla condicionesiva)
    // Topes se leen de configuraciones_empresa (clave afip_tope_cf_efectivo / afip_tope_cf_otros)
    // El caller pasa topesConfig = { efectivo: N, otros: N } leído de BD
    const TOPE_EFECTIVO_DEFAULT = 116046;
    const TOPE_OTROS_DEFAULT = 116046;

    const TOPE_EFECTIVO = topesConfig?.efectivo || TOPE_EFECTIVO_DEFAULT;
    const TOPE_OTROS = topesConfig?.otros || TOPE_OTROS_DEFAULT;

    const esConsumidorFinal = idCondicionIva === 4;

    if (!esConsumidorFinal) {
        return { valido: true };
    }

    const tope = (metodoPago === 'efectivo') ? TOPE_EFECTIVO : TOPE_OTROS;

    if (total > tope) {
        return {
            valido: false,
            mensaje: `Venta a Consumidor Final supera tope (${tope.toLocaleString('es-AR')}). Se requiere identificación del comprador (DNI).`,
            tope,
        };
    }

    return { valido: true };
}

/**
 * Determina tipo de factura según condición IVA del emisor y receptor
 * LAGO como Responsable Inscripto:
 *   RI → A, Monotributista → A, Exento → B, CF → B
 */
function determinarTipoFactura(idCondicionIvaCliente) {
    // Mapeo según tabla condicionesiva de la BD
    // 1 = RI, 2 = Monotributista, 3 = Exento, 4 = CF
    switch (idCondicionIvaCliente) {
        case 1: // Responsable Inscripto
        case 2: // Monotributista
            return 1; // Factura A
        case 3: // Exento
        case 4: // Consumidor Final
        default:
            return 2; // Factura B
    }
}


/**
 * Carga topes de Consumidor Final desde configuraciones_empresa
 * @param {object} pool - Pool de conexiones
 * @param {number} id_empresa
 * @returns {Promise<{efectivo: number, otros: number}>}
 */
async function cargarTopesConsumidorFinal(pool, id_empresa) {
    try {
        const { rows } = await pool.query(`
            SELECT clave, valor FROM configuraciones_empresa
            WHERE id_empresa = $1
              AND clave IN ('afip_tope_cf_efectivo', 'afip_tope_cf_otros')
        `, [id_empresa]);

        const topes = { efectivo: 116046, otros: 116046 };
        rows.forEach(r => {
            if (r.clave === 'afip_tope_cf_efectivo') topes.efectivo = parseFloat(r.valor);
            if (r.clave === 'afip_tope_cf_otros') topes.otros = parseFloat(r.valor);
        });
        return topes;
    } catch (e) {
        logger.warn('AFIP: No se pudieron cargar topes CF:', e.message);
        return { efectivo: 116046, otros: 116046 };
    }
}


