const CONDICION_IVA_AFIP = {
    'AC': 1,  // IVA Responsable Inscripto
    'RI': 1,
    'MT': 2,  // Monotributo
    'MN': 2,
    'EX': 3,  // Exento
    'NA': 3,  // No Alcanzado
    'CF': 4,  // Consumidor Final
    'NR': 1,  // No Responsable -> RI por defecto
};

async function obtenerTokenPadron() {
    if (padronTokenCache.token && padronTokenCache.expiresAt && new Date() < padronTokenCache.expiresAt) {
        return { token: padronTokenCache.token, sign: padronTokenCache.sign };
    }
    logger.info('AFIP: Solicitando token WSAA para ws_sr_padron_a13...');
    const tra = generarTRA('ws_sr_padron_a13');
    const cms = firmarTRA(tra);
    const urls = URLS[config.env];
    const client = await soap.createClientAsync(urls.wsaa);
    const result = await client.loginCmsAsync({ in0: cms });
    const loginResult = result[0]?.loginCmsReturn;
    if (!loginResult) throw new Error('AFIP WSAA Padron: Respuesta vacía');
    const parsed = await parseStringPromise(loginResult);
    const credentials = parsed.loginTicketResponse?.credentials?.[0];
    if (!credentials) throw new Error('AFIP WSAA Padron: No se obtuvieron credenciales');
    padronTokenCache = {
        token: credentials.token[0],
        sign: credentials.sign[0],
        expiresAt: new Date(Date.now() + 11 * 60 * 60 * 1000),
    };
    logger.info('AFIP: Token Padron obtenido correctamente');
    return { token: padronTokenCache.token, sign: padronTokenCache.sign };
}

async function consultarPadronA5(cuit) {
    if (config.modoOffline) throw new Error('AFIP en modo offline');
    const cuitLimpio = cuit.toString().replace(/[-\s]/g, '');
    const { token, sign } = await obtenerTokenPadron();
    const urls = URLS[config.env];
    const client = await soap.createClientAsync(urls.padron);
    const params = {
        token: token,
        sign: sign,
        cuitRepresentada: config.cuit,
        idPersona: cuitLimpio
    };
    const result = await client.getPersonaAsync(params);
    const persona = result[0]?.personaReturn?.persona;
    if (!persona) throw new Error('AFIP Padron: Persona no encontrada');
    // Extraer datos
    var razon_social = '';
    var tipo_persona = persona.tipoPersona || '';
    if (tipo_persona === 'JURIDICA') {
        razon_social = persona.razonSocial || '';
    } else {
        razon_social = ((persona.apellido || '') + ' ' + (persona.nombre || '')).trim();
    }
    // Condición IVA
    var id_condicion_iva = 4; // default CF
    var condicion_iva_desc = 'Consumidor Final';
    if (persona.datosRegimenGeneral && persona.datosRegimenGeneral.impuesto) {
        var impuestos = Array.isArray(persona.datosRegimenGeneral.impuesto) 
            ? persona.datosRegimenGeneral.impuesto 
            : [persona.datosRegimenGeneral.impuesto];
        for (var imp of impuestos) {
            if (imp.idImpuesto === '30' || imp.idImpuesto === 30) {
                id_condicion_iva = 1;
                condicion_iva_desc = 'Responsable Inscripto';
                break;
            }
            if (imp.idImpuesto === '32' || imp.idImpuesto === 32) {
                id_condicion_iva = 3;
                condicion_iva_desc = 'Exento';
                break;
            }
        }
    }
    if (persona.datosMonotributo) {
        id_condicion_iva = 2;
        condicion_iva_desc = 'Monotributo';
    }
    // Domicilio fiscal
    var domicilio = '';
    var localidad = '';
    var provincia = '';
    var codigo_postal = '';
    if (persona.domicilio && persona.domicilio.length > 0) {
        var dom = Array.isArray(persona.domicilio) ? persona.domicilio[0] : persona.domicilio;
        var partes = [];
        if (dom.direccion) partes.push(dom.direccion);
        if (dom.localidad) { partes.push(dom.localidad); localidad = dom.localidad; }
        if (dom.descripcionProvincia) { partes.push(dom.descripcionProvincia); provincia = dom.descripcionProvincia; }
        if (dom.codPostal) codigo_postal = dom.codPostal;
        domicilio = partes.join(', ');
    }
    return {
        cuit: cuitLimpio.replace(/(\d{2})(\d{8})(\d{1})/, '$1-$2-$3'),
        razon_social: razon_social,
        nombre_fantasia: persona.nombreFantasia || null,
        tipo_persona: tipo_persona,
        id_condicion_iva: id_condicion_iva,
        condicion_iva_descripcion: condicion_iva_desc,
        domicilio: domicilio || null,
        localidad: localidad || null,
        provincia: provincia || null,
        codigo_postal: codigo_postal || null,
        estado_cuit: persona.estadoClave || 'ACTIVO',
        origen: 'afip'
    };
}

