/**
 * Obtiene el último comprobante autorizado para un punto de venta y tipo
 * @param {number} puntoVenta - Punto de venta
 * @param {number} cbteTipo - Tipo de comprobante AFIP (1=FacA, 6=FacB, 11=FacC, etc.)
 * @returns {number} Último número autorizado
 */
async function ultimoComprobante(puntoVenta, cbteTipo) {
    if (config.modoOffline) return 0;

    const { token, sign } = await obtenerTokenSign();
    const urls = URLS[config.env];
    const client = await soap.createClientAsync(urls.wsfe);

    const result = await client.FECompUltimoAutorizadoAsync({
        Auth: { Token: token, Sign: sign, Cuit: config.cuit },
        PtoVta: puntoVenta,
        CbteTipo: cbteTipo,
    });

    const response = result[0]?.FECompUltimoAutorizadoResult;
    if (response?.Errors) {
        const errMsg = response.Errors.Err.map(e => `${e.Code}: ${e.Msg}`).join('; ');
        throw new Error(`AFIP FECompUltimoAutorizado: ${errMsg}`);
    }

    return response?.CbteNro || 0;
}

/**
 * Mapea tipo de factura interno a código AFIP
 */
function tipoFacturaAFIP(id_tipo_factura) {
    // Ajustar estos IDs según la tabla factura_tipos de tu BD
    const mapeo = {
        1: 1,    // Factura A  → AFIP tipo 1
        2: 6,    // Factura B  → AFIP tipo 6
        3: 11,   // Factura C  → AFIP tipo 11
        // Notas de crédito
        4: 3,    // NC A       → AFIP tipo 3
        5: 8,    // NC B       → AFIP tipo 8
        6: 13,   // NC C       → AFIP tipo 13
        // Notas de débito
        7: 2,    // ND A       → AFIP tipo 2
        8: 7,    // ND B       → AFIP tipo 7
        9: 12,   // ND C       → AFIP tipo 12
    };
    return mapeo[id_tipo_factura] || null;
}

/**
 * Mapea condición IVA a código de documento AFIP
 * 80 = CUIT, 96 = DNI, 99 = Sin identificar
 */
function tipoDocumentoAFIP(condicionIva, cuit) {
    if (cuit && cuit.length >= 11) return 80; // CUIT
    if (cuit && cuit.length >= 7) return 96;  // DNI
    return 99; // Sin identificar (Consumidor Final sin datos)
}

/**
 * Solicita CAE a AFIP para una factura
 *
 * @param {Object} factura - Datos de la factura
 * @param {number} factura.punto_venta
 * @param {number} factura.id_tipo_factura - ID interno (1=A, 2=B, 3=C)
 * @param {number} factura.numero_factura
 * @param {string} factura.cuit_cliente
 * @param {number} factura.id_condicion_iva_cliente
 * @param {number} factura.neto_gravado - Base imponible (sin IVA)
 * @param {number} factura.total_iva - Monto IVA
 * @param {number} factura.total
 * @param {Array}  factura.iva_detalle - [{id_alicuota, base_imponible, importe}]
 * @param {string} [factura.fecha_emision] - YYYYMMDD
 *
 * @returns {Object} { cae, cae_vencimiento, numero_comprobante, resultado }
 */
async function solicitarCAE(factura) {
    // MODO OFFLINE: devolver CAE interno (solo para desarrollo)
    if (config.modoOffline) {
        logger.warn('AFIP: Modo offline - generando CAE interno (NO VÁLIDO FISCALMENTE)');
        const vto = new Date();
        vto.setDate(vto.getDate() + 10);
        return {
            cae: 'OFFLINE-' + Date.now(),
            cae_vencimiento: vto.toISOString().split('T')[0],
            numero_comprobante: factura.numero_factura,
            resultado: 'A',
            offline: true,
        };
    }

    const { token, sign } = await obtenerTokenSign();
    const urls = URLS[config.env];
    const client = await soap.createClientAsync(urls.wsfe);

    // Si viene cbte_tipo_afip directo (ej: desde notas NC/ND), usarlo sin mapear
    const cbteTipoAFIP = factura.cbte_tipo_afip || tipoFacturaAFIP(factura.id_tipo_factura);
    if (!cbteTipoAFIP) {
        throw new Error(`Tipo de factura ${factura.id_tipo_factura} no mapeado a AFIP`);
    }

    const fechaEmision = factura.fecha_emision ||
        new Date().toISOString().split('T')[0].replace(/-/g, '');

    const docTipo = tipoDocumentoAFIP(
        factura.id_condicion_iva_cliente,
        factura.cuit_cliente
    );
    const docNro = factura.cuit_cliente
        ? factura.cuit_cliente.replace(/[^0-9]/g, '')
        : '0';

    // Construir detalle de IVA (alícuotas)
    // Alícuotas AFIP: 3=0%, 4=10.5%, 5=21%, 6=27%, 8=5%, 9=2.5%
    const ivaDetalleRaw = (factura.iva_detalle || []).map(iva => ({
        Id: iva.id_alicuota,
        BaseImp: iva.base_imponible,
        Importe: iva.importe,
    }));

    // Normalizar para que BaseImp sume exactamente ImpNeto y Importe sume ImpIVA
    // (evita rechazos AFIP 10061/10048 por centavos de redondeo)
    const impNeto = Math.round((factura.total - (factura.total_iva || 0)) * 100) / 100;
    const impIVA = Math.round((factura.total_iva || 0) * 100) / 100;

    const ivaDetalle = ivaDetalleRaw.map(d => ({ ...d, BaseImp: Math.round(d.BaseImp * 100) / 100, Importe: Math.round(d.Importe * 100) / 100 }));
    if (ivaDetalle.length > 0) {
        const sumaBase = ivaDetalle.reduce((s, d) => s + d.BaseImp, 0);
        const sumaImp = ivaDetalle.reduce((s, d) => s + d.Importe, 0);
        const diffBase = Math.round((impNeto - sumaBase) * 100) / 100;
        const diffImp = Math.round((impIVA - sumaImp) * 100) / 100;
        if (diffBase !== 0) ivaDetalle[0].BaseImp = Math.round((ivaDetalle[0].BaseImp + diffBase) * 100) / 100;
        if (diffImp !== 0) ivaDetalle[0].Importe = Math.round((ivaDetalle[0].Importe + diffImp) * 100) / 100;
    }

    // En Factura B: AFIP no quiere IVA discriminado (va todo en total)
    const esFacturaB = cbteTipoAFIP === 6 || cbteTipoAFIP === 8 || cbteTipoAFIP === 7;

    const feDetReq = {
        FeCabReq: {
            CantReg: 1,
            PtoVta: factura.punto_venta,
            CbteTipo: cbteTipoAFIP,
        },
        FeDetReq: {
            FECAEDetRequest: [{
                Concepto: 1, // 1=Productos, 2=Servicios, 3=Ambos
                DocTipo: docTipo,
                DocNro: parseInt(docNro) || 0,
                CbteDesde: parseInt(factura.numero_factura),
                CbteHasta: parseInt(factura.numero_factura),
                CbteFch: fechaEmision,
                ImpTotal: factura.total,
                ImpTotConc: 0, // No gravado
                // Neto e IVA: ImpNeto = Total - IVA (garantiza ImpTotal = suma)
                ImpNeto: Math.round((factura.total - (factura.total_iva || 0)) * 100) / 100,
                ImpOpEx: 0,    // Exento
                ImpIVA: Math.round((factura.total_iva || 0) * 100) / 100,
                ImpTrib: 0,    // Otros tributos
                MonId: 'PES',  // Pesos argentinos
                MonCotiz: 1,
                // IVA: obligatorio cuando ImpNeto > 0 (incluso Factura B desde 2024)
                ...(ivaDetalle.length > 0 ? {
                    Iva: { AlicIva: ivaDetalle }
                } : {}),
                // NC/ND requieren comprobante asociado (solo campos base)
                ...(factura.cbte_asoc ? {
                    CbtesAsoc: { CbteAsoc: [{
                        Tipo:   parseInt(factura.cbte_asoc.tipo),
                        PtoVta: parseInt(factura.cbte_asoc.punto_venta),
                        Nro:    parseInt(factura.cbte_asoc.numero),
                    }]}
                } : {}),
            }]
        }
    };

    const result = await client.FECAESolicitarAsync({
        Auth: { Token: token, Sign: sign, Cuit: config.cuit },
        FeCAEReq: feDetReq,
    });

    const response = result[0]?.FECAESolicitarResult;

    // Verificar errores globales
    if (response?.Errors) {
        const errMsg = response.Errors.Err.map(e => `${e.Code}: ${e.Msg}`).join('; ');
        throw new Error(`AFIP FECAESolicitar: ${errMsg}`);
    }

    // Obtener resultado del comprobante
    const detResponse = response?.FeDetResp?.FECAEDetResponse?.[0];
    if (!detResponse) {
        throw new Error('AFIP: Respuesta vacía de FECAESolicitar');
    }

    if (detResponse.Resultado !== 'A') {
        // Rechazado
        const obs = detResponse.Observaciones?.Obs?.map(o => `${o.Code}: ${o.Msg}`).join('; ') || 'Sin detalle';
        throw new Error(`AFIP rechazó comprobante: ${obs}`);
    }

    return {
        cae: detResponse.CAE,
        cae_vencimiento: detResponse.CAEFchVto, // YYYYMMDD
        numero_comprobante: detResponse.CbteHasta,
        resultado: detResponse.Resultado,
        offline: false,
    };
}

