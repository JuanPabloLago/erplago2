/**
 * SERVICIO DE CONSULTA AL PADRÓN AFIP
 * ERP LAGO v13.0
 * 
 * Consulta el Padrón A5 de AFIP para obtener datos fiscales de un CUIT
 * Endpoints utilizados:
 * - Padrón A5 (gratuito): https://afip.tangofactura.com/Rest/GetContribuyenteFull
 * - Alternativa: API de AFIP directo con certificados
 */

const axios = require('axios');

// Mapeo de códigos de AFIP a nuestras condiciones IVA
const MAPEO_CONDICION_IVA = {
    'AC': 1, // Responsable Inscripto
    'RI': 1, // Responsable Inscripto
    'MT': 2, // Monotributo
    'EX': 3, // Exento
    'CF': 4, // Consumidor Final
    'RS': 2, // Monotributo (Responsable Monotributo)
    'NI': 4, // No Inscripto / Consumidor Final
};

// Mapeo de códigos de actividad a descripción
const TIPOS_PERSONA = {
    'F': 'fisica',
    'J': 'juridica'
};

/**
 * Consulta el Padrón A5 de AFIP (servicio gratuito de terceros)
 * @param {string} cuit - CUIT a consultar (sin guiones)
 * @returns {Object} Datos normalizados del contribuyente
 */
async function consultarPadronA5(cuit) {
    // Limpiar CUIT (quitar guiones y espacios)
    const cuitLimpio = cuit.replace(/[-\s]/g, '');
    
    // Validar formato básico
    if (!/^\d{11}$/.test(cuitLimpio)) {
        throw new Error('CUIT inválido. Debe tener 11 dígitos.');
    }

    try {
        // Servicio gratuito de TangoFactura
        const response = await axios.get(
            `https://afip.tangofactura.com/Rest/GetContribuyenteFull?cuit=${cuitLimpio}`,
            { 
                timeout: 10000,
                headers: {
                    'Accept': 'application/json'
                }
            }
        );

        const data = response.data;

        // Verificar si hubo error
        if (data.errorGetData) {
            throw new Error(data.errorMessage || 'CUIT no encontrado en el padrón de AFIP');
        }

        // Normalizar datos para nuestro sistema
        return normalizarDatosAFIP(data, cuitLimpio);

    } catch (error) {
        // Intentar con servicio alternativo si falla el principal
        if (error.response?.status === 429 || error.code === 'ECONNABORTED') {
            console.log('⚠️ Servicio principal ocupado, intentando alternativa...');
            return consultarPadronAlternativo(cuitLimpio);
        }
        throw error;
    }
}

/**
 * Servicio alternativo para consulta de CUIT
 * @param {string} cuit - CUIT limpio
 */
async function consultarPadronAlternativo(cuit) {
    try {
        // Servicio alternativo: CUIT Online
        const response = await axios.get(
            `https://www.cuitonline.com/constancia/inscripcion/${cuit}`,
            { 
                timeout: 10000,
                headers: {
                    'User-Agent': 'ERP-LAGO/1.0',
                    'Accept': 'text/html'
                }
            }
        );

        // Nota: Este servicio devuelve HTML, habría que parsearlo
        // Por ahora devolvemos error si el principal falla
        throw new Error('Servicio AFIP temporalmente no disponible. Intente nuevamente en unos minutos.');
        
    } catch (error) {
        throw new Error('No se pudo consultar el CUIT en AFIP. Intente más tarde.');
    }
}

/**
 * Normaliza los datos de AFIP al formato de nuestro sistema
 * @param {Object} data - Datos crudos de AFIP
 * @param {string} cuit - CUIT consultado
 * @returns {Object} Datos normalizados
 */
function normalizarDatosAFIP(data, cuit) {
    // Extraer condición IVA del listado de impuestos
    let condicionIVACodigo = 'CF'; // Default: Consumidor Final
    
    if (data.datosRegimenGeneral?.impuesto) {
        // Buscar inscripción en IVA (impuesto 30)
        const inscripcionIVA = data.datosRegimenGeneral.impuesto.find(
            i => i.idImpuesto === 30 || i.descripcionImpuesto?.includes('IVA')
        );
        if (inscripcionIVA) {
            condicionIVACodigo = 'RI'; // Responsable Inscripto
        }
    }
    
    if (data.datosMonotributo?.impuesto) {
        condicionIVACodigo = 'MT'; // Monotributo
    }

    // Mapear a nuestro ID de condición IVA
    const id_condicion_iva = MAPEO_CONDICION_IVA[condicionIVACodigo] || 4;

    // Construir dirección completa
    const domicilio = data.domicilioFiscal || {};
    const direccionCompleta = [
        domicilio.direccion,
        domicilio.localidad,
        domicilio.descripcionProvincia
    ].filter(Boolean).join(', ');

    // Determinar razón social
    let razonSocial = '';
    let tipoPersona = 'juridica';
    
    if (data.tipoPersona === 'FISICA' || data.tipoClave === 'CUIL') {
        tipoPersona = 'fisica';
        razonSocial = [data.apellido, data.nombre].filter(Boolean).join(' ');
    } else {
        razonSocial = data.razonSocial || data.nombre || '';
    }

    return {
        cuit: cuit,
        razon_social: razonSocial.toUpperCase(),
        nombre_fantasia: data.nombreFantasia || null,
        tipo_persona: tipoPersona,
        id_condicion_iva: id_condicion_iva,
        condicion_iva_descripcion: obtenerDescripcionCondicionIVA(id_condicion_iva),
        domicilio: domicilio.direccion || null,
        localidad: domicilio.localidad || null,
        provincia: domicilio.descripcionProvincia || null,
        codigo_postal: domicilio.codPostal || null,
        direccion_completa: direccionCompleta || null,
        estado_cuit: data.estadoClave || 'ACTIVO',
        fecha_inscripcion: data.fechaInscripcion || null,
        actividad_principal: data.actividadPrincipal || null,
        // Datos adicionales útiles
        es_empleador: data.empleador || false,
        datos_originales: data // Para debug si es necesario
    };
}

/**
 * Obtiene descripción de condición IVA por ID
 */
function obtenerDescripcionCondicionIVA(id) {
    const descripciones = {
        1: 'Responsable Inscripto',
        2: 'Monotributo',
        3: 'Exento',
        4: 'Consumidor Final'
    };
    return descripciones[id] || 'Desconocido';
}

/**
 * Valida un CUIT/CUIL según algoritmo oficial
 * @param {string} cuit - CUIT a validar
 * @returns {boolean} true si es válido
 */
function validarCUIT(cuit) {
    const cuitLimpio = cuit.replace(/[-\s]/g, '');
    
    if (!/^\d{11}$/.test(cuitLimpio)) {
        return false;
    }

    // Algoritmo de validación CUIT
    const multiplicadores = [5, 4, 3, 2, 7, 6, 5, 4, 3, 2];
    let suma = 0;
    
    for (let i = 0; i < 10; i++) {
        suma += parseInt(cuitLimpio[i]) * multiplicadores[i];
    }
    
    const resto = suma % 11;
    const digitoVerificador = resto === 0 ? 0 : resto === 1 ? 9 : 11 - resto;
    
    return parseInt(cuitLimpio[10]) === digitoVerificador;
}

/**
 * Formatea CUIT con guiones
 * @param {string} cuit - CUIT sin formato
 * @returns {string} CUIT formateado (XX-XXXXXXXX-X)
 */
function formatearCUIT(cuit) {
    const limpio = cuit.replace(/[-\s]/g, '');
    if (limpio.length !== 11) return cuit;
    return `${limpio.slice(0, 2)}-${limpio.slice(2, 10)}-${limpio.slice(10)}`;
}

module.exports = {
    consultarPadronA5,
    validarCUIT,
    formatearCUIT,
    MAPEO_CONDICION_IVA
};
