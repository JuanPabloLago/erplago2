exports.duplicarComoFactura = async (req, res) => {
    const { id_empresa, id_usuario } = req.usuario;
    const { id } = req.params;
    const { id_tipo_destino, punto_venta, numero_comprobante, fecha_emision, fecha_vencimiento } = req.body;

    if (!id_tipo_destino || !numero_comprobante || !fecha_emision) {
        return res.status(400).json({ error: 'Faltan datos: tipo destino, número y fecha emisión' });
    }

    const client = await pool.connect();
    try {
        await client.query('BEGIN');

        const resultado = await comprasHelper.duplicarComoFactura(client, {
            id_comprobante_origen: parseInt(id),
            id_empresa, id_usuario,
            id_tipo_destino: parseInt(id_tipo_destino),
            punto_venta: punto_venta || '0001',
            numero_comprobante,
            fecha_emision,
            fecha_vencimiento: fecha_vencimiento || null
        });

        await client.query('COMMIT');
        logger.info(`Presupuesto ${id} duplicado como ${resultado.numero_completo}`);
        res.json({ success: true, message: `Factura ${resultado.numero_completo} creada desde presupuesto`, data: resultado });

    } catch (error) {
        await client.query('ROLLBACK');
        logger.error('duplicarComoFactura:', error.message);
        res.status(error.statusCode || 500).json({ error: error.message });
    } finally {
        client.release();
    }
};

