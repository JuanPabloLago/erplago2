exports.getCuentaCorriente = async (req, res) => {
    const { id_empresa } = req.usuario;
    const { id_proveedor } = req.params;
    const { limit = 100, offset = 0 } = req.query;
    try {
        // Movimientos con saldo corrido desde CC proveedores
        const { rows: movimientos } = await pool.query(`
            SELECT
                cc.id_movimiento_cc_proveedor as id,
                cc.fecha, cc.concepto,
                cc.debe, cc.haber, cc.saldo,
                cc.id_comprobante_compra, cc.id_pago_proveedor, cc.id_orden_compra,
                comp.numero_completo as comprobante_numero,
                cct.nombre as tipo_comprobante
            FROM cuentacorrienteproveedores cc
            LEFT JOIN comprobantes_compra comp ON comp.id_comprobante = cc.id_comprobante_compra
            LEFT JOIN comprobante_compra_tipos cct ON cct.id_tipo = comp.id_tipo
            WHERE cc.id_proveedor = $1 AND cc.id_empresa = $2
            ORDER BY cc.fecha DESC, cc.id_movimiento_cc_proveedor DESC
            LIMIT $3 OFFSET $4
        `, [id_proveedor, id_empresa, parseInt(limit), parseInt(offset)]);

        // Saldo total
        const { rows: saldoRows } = await pool.query(`
            SELECT COALESCE(SUM(debe), 0) - COALESCE(SUM(haber), 0) as saldo_total,
                   COALESCE(SUM(debe), 0) as total_debe,
                   COALESCE(SUM(haber), 0) as total_haber,
                   COUNT(*) as total_movimientos
            FROM cuentacorrienteproveedores
            WHERE id_proveedor = $1 AND id_empresa = $2
        `, [id_proveedor, id_empresa]);

        // Cheques pendientes de este proveedor
        const { rows: chequesPendientes } = await pool.query(`
            SELECT 'propio' as tipo, cp.numero_cheque, b.nombre as banco,
                   cp.fecha_vencimiento, cp.monto, cp.estado,
                   cp.fecha_vencimiento - CURRENT_DATE as dias_para_vencer
            FROM cheques_propios cp
            JOIN bancos b ON b.id_banco = cp.id_banco
            WHERE cp.id_proveedor = $1 AND cp.id_empresa = $2
                AND cp.estado IN ('emitido', 'entregado')
            UNION ALL
            SELECT 'tercero' as tipo, ct.numero_cheque, COALESCE(b.nombre, ct.banco_nombre) as banco,
                   ct.fecha_vencimiento, ct.monto, ct.estado,
                   ct.fecha_vencimiento - CURRENT_DATE as dias_para_vencer
            FROM cheques_terceros ct
            LEFT JOIN bancos b ON b.id_banco = ct.id_banco
            WHERE ct.id_proveedor = $1 AND ct.id_empresa = $2
                AND ct.estado = 'endosado'
            ORDER BY fecha_vencimiento ASC
        `, [id_proveedor, id_empresa]);

        const resumen = saldoRows[0];
        res.json({
            success: true,
            data: {
                movimientos,
                saldo_total: parseFloat(resumen.saldo_total),
                total_debe: parseFloat(resumen.total_debe),
                total_haber: parseFloat(resumen.total_haber),
                total_movimientos: parseInt(resumen.total_movimientos),
                cheques_pendientes: chequesPendientes
            }
        });
    } catch (error) {
        console.error('Error getCuentaCorriente proveedores:', error.message);
        res.status(500).json({ error: 'Error al obtener cuenta corriente' });
    }
};


// ═══════════════════════════════════════════════════════════════
// ALERTAS DE CHEQUES PRÓXIMOS A VENCER
// ═══════════════════════════════════════════════════════════════

exports.alertasCheques = async (req, res) => {
    const { id_empresa } = req.usuario;
    const { dias = 7 } = req.query;
    try {
        const alertas = await ccProveedores.obtenerAlertasCheques(pool, id_empresa, parseInt(dias));
        const vencidos = alertas.filter(a => a.dias_para_vencer < 0);
        const proximos = alertas.filter(a => a.dias_para_vencer >= 0);
        res.json({
            success: true,
            data: {
                vencidos, proximos,
                total_vencido: vencidos.reduce((s, a) => s + parseFloat(a.monto), 0),
                total_proximo: proximos.reduce((s, a) => s + parseFloat(a.monto), 0)
            }
        });
    } catch (error) {
        console.error('Error alertasCheques:', error.message);
        res.status(500).json({ error: 'Error al obtener alertas de cheques' });
    }
};

module.exports = exports;
