exports.listarPagos = async (req, res) => {
    const { id_empresa } = req.usuario; const { id_proveedor, fecha_desde, fecha_hasta, limit = 50, offset = 0 } = req.query;
    try {
        let whereClause = 'pp.id_empresa = $1'; const params = [id_empresa]; let paramIndex = 2;
        if (id_proveedor) { whereClause += ` AND pp.id_proveedor = $${paramIndex}`; params.push(parseInt(id_proveedor)); paramIndex++; }
        if (fecha_desde) { whereClause += ` AND pp.fecha_pago >= $${paramIndex}`; params.push(fecha_desde); paramIndex++; }
        if (fecha_hasta) { whereClause += ` AND pp.fecha_pago <= $${paramIndex}`; params.push(fecha_hasta); paramIndex++; }
        const query = `SELECT pp.id_pago_proveedor, pp.numero_pago, pp.fecha_pago, pp.monto, pp.referencia_pago, pp.es_pago_a_cuenta, pp.estado, p.razon_social as proveedor, p.cuit as proveedor_cuit, u.nombre as usuario, (SELECT json_agg(json_build_object('forma', fp.nombre, 'monto', ppi.monto)) FROM pago_proveedor_items ppi INNER JOIN formas_pago fp ON fp.id_forma_pago = ppi.id_forma_pago WHERE ppi.id_pago = pp.id_pago_proveedor) as formas_pago FROM pagosaproveedores pp INNER JOIN proveedores p ON p.id_proveedor = pp.id_proveedor LEFT JOIN usuarios u ON u.id_usuario = pp.id_usuario WHERE ${whereClause} ORDER BY pp.fecha_pago DESC, pp.id_pago_proveedor DESC LIMIT $${paramIndex} OFFSET $${paramIndex + 1}`;
        params.push(parseInt(limit), parseInt(offset));
        const { rows } = await pool.query(query, params);
        res.json({ success: true, data: rows });
    } catch (error) { res.status(500).json({ error: 'Error al listar pagos' }); }
};

exports.getPago = async (req, res) => {
    const { id_empresa } = req.usuario; const { id } = req.params;
    try {
        const { rows: pagoRows } = await pool.query(`SELECT pp.*, p.razon_social as proveedor, p.cuit as proveedor_cuit, u.nombre as usuario FROM pagosaproveedores pp INNER JOIN proveedores p ON p.id_proveedor = pp.id_proveedor LEFT JOIN usuarios u ON u.id_usuario = pp.id_usuario WHERE pp.id_pago_proveedor = $1 AND pp.id_empresa = $2`, [id, id_empresa]);
        if (pagoRows.length === 0) return res.status(404).json({ error: 'Pago no encontrado' });
        const { rows: itemsRows } = await pool.query(`SELECT ppi.*, fp.nombre as forma_pago, b.nombre as banco, m.codigo as moneda_codigo FROM pago_proveedor_items ppi INNER JOIN formas_pago fp ON fp.id_forma_pago = ppi.id_forma_pago LEFT JOIN bancos b ON b.id_banco = ppi.id_banco LEFT JOIN monedas m ON m.id_moneda = ppi.id_moneda WHERE ppi.id_pago = $1`, [id]);
        const { rows: imputacionesRows } = await pool.query(`SELECT ipp.*, cc.numero_completo as comprobante, cc.fecha_emision FROM imputacion_pagos_proveedor ipp INNER JOIN cuentas_por_pagar cpp ON cpp.id_cuenta = ipp.id_cuenta LEFT JOIN comprobantes_compra cc ON cc.id_comprobante = cpp.id_comprobante WHERE ipp.id_pago = $1`, [id]);
        res.json({ success: true, data: { ...pagoRows[0], formas_pago: itemsRows, imputaciones: imputacionesRows } });
    } catch (error) { res.status(500).json({ error: 'Error al obtener pago' }); }
};

