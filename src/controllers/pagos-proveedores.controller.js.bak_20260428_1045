exports.getFormData = async (req, res) => {
    const { id_empresa } = req.usuario;
    try {
        const [formasPago, bancos, monedas] = await Promise.all([
            pool.query('SELECT * FROM formas_pago WHERE id_empresa = $1 AND activo = true ORDER BY nombre', [id_empresa]),
            pool.query('SELECT * FROM bancos WHERE activo = true ORDER BY nombre'),
            pool.query('SELECT * FROM monedas WHERE activo = true ORDER BY id_moneda')
        ]);
        res.json({ success: true, data: { formasPago: formasPago.rows, bancos: bancos.rows, monedas: monedas.rows } });
    } catch (error) { res.status(500).json({ error: 'Error al obtener datos del formulario' }); }
};

exports.getProveedoresConSaldo = async (req, res) => {
    const { id_empresa } = req.usuario; const { q } = req.query;
    try {
        let whereClause = 'p.id_empresa = $1 AND p.activo = true'; const params = [id_empresa];
        if (q && q.trim().length >= 2) { q.trim().toLowerCase().split(/\s+/).forEach((termino, idx) => { params.push(`%${termino}%`); whereClause += ` AND p.busqueda_texto ILIKE $${idx + 2}`; }); }
        const { rows } = await pool.query(`SELECT p.id_proveedor, p.cuit, p.razon_social, p.nombre_fantasia, COALESCE(SUM(cpp.saldo), 0)::numeric as saldo_total, COUNT(CASE WHEN cpp.saldo > 0 THEN 1 END)::integer as facturas_pendientes, MIN(cpp.fecha_vencimiento) FILTER (WHERE cpp.saldo > 0) as proxima_vencimiento FROM proveedores p LEFT JOIN cuentas_por_pagar cpp ON cpp.id_proveedor = p.id_proveedor AND cpp.saldo > 0 WHERE ${whereClause} GROUP BY p.id_proveedor ORDER BY COALESCE(SUM(cpp.saldo), 0) DESC LIMIT 50`, params);
        res.json({ success: true, data: rows });
    } catch (error) { res.status(500).json({ error: 'Error al obtener proveedores' }); }
};

exports.getFacturasPendientes = async (req, res) => {
    const { id_empresa } = req.usuario; const { id_proveedor } = req.params;
    try {
        const { rows } = await pool.query(`SELECT cpp.id_cuenta, cpp.id_comprobante, cc.numero_completo, cct.codigo as tipo_codigo, cct.nombre as tipo_nombre, cc.fecha_emision, cpp.fecha_vencimiento, cpp.monto as total, cpp.saldo, cpp.tipo_movimiento, CASE WHEN cpp.fecha_vencimiento < CURRENT_DATE THEN 'vencida' WHEN cpp.fecha_vencimiento <= CURRENT_DATE + 7 THEN 'proxima' ELSE 'vigente' END as estado_vencimiento, (CURRENT_DATE - cpp.fecha_vencimiento) as dias_vencida FROM cuentas_por_pagar cpp INNER JOIN comprobantes_compra cc ON cc.id_comprobante = cpp.id_comprobante INNER JOIN comprobante_compra_tipos cct ON cct.id_tipo = cc.id_tipo WHERE cpp.id_proveedor = $1 AND cpp.id_empresa = $2 AND cpp.saldo > 0 ORDER BY cpp.fecha_vencimiento ASC, cc.fecha_emision ASC`, [id_proveedor, id_empresa]);
        const totales = { total_pendiente: rows.reduce((sum, f) => sum + parseFloat(f.saldo), 0), cantidad_facturas: rows.length, vencidas: rows.filter(f => f.estado_vencimiento === 'vencida').length, proximas: rows.filter(f => f.estado_vencimiento === 'proxima').length };
        res.json({ success: true, data: rows, totales });
    } catch (error) { res.status(500).json({ error: 'Error al obtener facturas pendientes' }); }
};

exports.getChequesCartera = async (req, res) => {
    const { id_empresa } = req.usuario;
    try {
        const { rows } = await pool.query(`SELECT ct.id_cheque, ct.numero_cheque, COALESCE(b.nombre, ct.banco_nombre) as banco, ct.cuit_librador, ct.nombre_librador, ct.fecha_vencimiento, ct.monto, ct.fecha_recepcion, c.razon_social as cliente_origen, CASE WHEN ct.fecha_vencimiento < CURRENT_DATE THEN 'vencido' WHEN ct.fecha_vencimiento <= CURRENT_DATE + 7 THEN 'proximo' ELSE 'vigente' END as estado_vencimiento FROM cheques_terceros ct LEFT JOIN bancos b ON b.id_banco = ct.id_banco LEFT JOIN clientes c ON c.id_cliente = ct.id_cliente WHERE ct.id_empresa = $1 AND ct.estado = 'en_cartera' ORDER BY ct.fecha_vencimiento ASC`, [id_empresa]);
        res.json({ success: true, data: rows });
    } catch (error) { res.status(500).json({ error: 'Error al obtener cheques en cartera' }); }
};

// ═══════════════════════════════════════════════════════════════
// REGISTRAR PAGO — MIGRADO A HELPER
// ═══════════════════════════════════════════════════════════════

exports.registrarPago = async (req, res) => {
    const { id_empresa, id_usuario } = req.usuario;
    const { id_proveedor, facturas_a_pagar, formas_pago, es_pago_a_cuenta, observaciones, id_comprobante } = req.body;

    // Validación DTO mínima (lógica de negocio → helper)
    if (!id_proveedor) return res.status(400).json({ error: 'Falta el proveedor' });
    if (!formas_pago || formas_pago.length === 0) return res.status(400).json({ error: 'Debe especificar al menos una forma de pago' });
    if (!es_pago_a_cuenta && (!facturas_a_pagar || facturas_a_pagar.length === 0)) {
        return res.status(400).json({ error: 'Debe seleccionar facturas a pagar o marcar como pago a cuenta' });
    }

    const client = await pool.connect();
    try {
        await client.query('BEGIN');

        // ★ ORQUESTADOR — toda la lógica está en el helper
        const resultado = await pagosHelper.registrarPagoProveedorCompleto(client, {
            id_empresa, id_proveedor, id_usuario,
            formas_pago, facturas_a_pagar,
            es_pago_a_cuenta, observaciones, id_comprobante
        });

        await client.query('COMMIT');
        res.json({
            success: true,
            message: 'Pago registrado correctamente',
            data: resultado
        });
    } catch (error) {
        await client.query('ROLLBACK');
        console.error('❌ Error en registrarPago:', error.message);
        res.status(error.statusCode || 500).json({ error: error.message || 'Error al registrar pago' });
    } finally { client.release(); }
};

