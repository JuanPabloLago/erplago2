// =======================================================================
// 1. CONFIGURACIÓN E IMPORTACIONES
// =======================================================================
require('dotenv').config();
const express = require('express');
const { Pool } = require('pg');

const app = express();
const port = 3000;

// Middleware para que Express entienda JSON
app.use(express.json());

// =======================================================================
// 2. CONEXIÓN A LA BASE DE DATOS
// =======================================================================
const pool = new Pool({
    user: process.env.DB_USER,
    host: process.env.DB_HOST,
    database: process.env.DB_DATABASE,
    password: process.env.DB_PASSWORD,
    port: process.env.DB_PORT
});

pool.query('SELECT NOW()', (err, res) => {
    if (err) {
        console.error('Error al conectar a la base de datos:', err.stack);
    } else {
        console.log('Conexión a PostgreSQL exitosa!');
    }
});

// =======================================================================
// 3. RUTAS DE LA API
// =======================================================================

// -------------------------------------------------------
// MODULO DE EMPRESAS
// -------------------------------------------------------
app.post('/api/empresas', async (req, res) => {
    const { cuit, razon_social, domicilio_fiscal, id_condicion_iva } = req.body;
    if (!cuit || !razon_social || !domicilio_fiscal || !id_condicion_iva) {
        return res.status(400).json({ error: 'CUIT, razón social, domicilio e id_condicion_iva son obligatorios.' });
    }
    try {
        const text = 'INSERT INTO empresas(cuit, razon_social, domicilio_fiscal, id_condicion_iva) VALUES($1, $2, $3, $4) RETURNING *';
        const values = [cuit, razon_social, domicilio_fiscal, id_condicion_iva];
        const result = await pool.query(text, values);
        res.status(201).json(result.rows[0]);
    } catch (err) {
        console.error('Error al insertar la empresa:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

app.get('/api/empresas', async (req, res) => {
    try {
        const result = await pool.query('SELECT * FROM empresas ORDER BY id_empresa ASC');
        res.json(result.rows);
    } catch (err) {
        console.error('Error al obtener las empresas:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});


// -------------------------------------------------------
// MODULO DE PRODUCTOS
// -------------------------------------------------------
app.get('/api/productos', async (req, res) => {
    try {
        const result = await pool.query('SELECT * FROM productos ORDER BY id_producto ASC');
        res.json(result.rows);
    } catch (err) {
        console.error('Error al obtener los productos:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

app.post('/api/productos', async (req, res) => {
    const { sku, nombre, descripcion, id_categoria, marca } = req.body;
    if (!sku || !nombre) {
        return res.status(400).json({ error: 'El SKU y el nombre son obligatorios.' });
    }
    try {
        const text = 'INSERT INTO productos(sku, nombre, descripcion, id_categoria, marca) VALUES($1, $2, $3, $4, $5) RETURNING *';
        const values = [sku, nombre, descripcion, id_categoria, marca];
        const result = await pool.query(text, values);
        res.status(201).json(result.rows[0]);
    } catch (err) {
        console.error('Error al insertar el producto:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

app.put('/api/productos/:id', async (req, res) => {
    const id = parseInt(req.params.id);
    const { sku, nombre, descripcion, id_categoria, marca, activo } = req.body;
    if (isNaN(id)) {
        return res.status(400).send('El ID debe ser un número válido.');
    }
    try {
        const text = 'UPDATE productos SET sku = $1, nombre = $2, descripcion = $3, id_categoria = $4, marca = $5, activo = $6, fecha_modificacion = now() WHERE id_producto = $7 RETURNING *';
        const values = [sku, nombre, descripcion, id_categoria, marca, activo, id];
        const result = await pool.query(text, values);
        if (result.rows.length === 0) {
            return res.status(404).send('Producto no encontrado.');
        }
        res.json(result.rows[0]);
    } catch (err) {
        console.error('Error al actualizar el producto:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

app.delete('/api/productos/:id', async (req, res) => {
    const id = parseInt(req.params.id);
    if (isNaN(id)) {
        return res.status(400).send('El ID debe ser un número válido.');
    }
    try {
        const text = 'DELETE FROM productos WHERE id_producto = $1 RETURNING *';
        const result = await pool.query(text, [id]);
        if (result.rows.length === 0) {
            return res.status(404).send('Producto no encontrado.');
        }
        res.status(200).json({ message: 'Producto eliminado exitosamente', producto: result.rows[0] });
    } catch (err) {
        console.error('Error al eliminar el producto:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});


