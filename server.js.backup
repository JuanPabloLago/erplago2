        const text = 'UPDATE proveedores SET cuit = $1, razon_social = $2, id_condicion_iva = $3, email = $4, telefono = $5, domicilio = $6, activo = $7, fecha_modificacion = now() WHERE id_proveedor = $8 RETURNING *';
        const values = [cuit, razon_social, id_condicion_iva, email, telefono, domicilio, activo, id];
        const result = await pool.query(text, values);
        if (result.rows.length === 0) {
            return res.status(404).send('Proveedor no encontrado.');
        }
        res.json(result.rows[0]);
    } catch (err) {
        console.error('Error al actualizar el proveedor:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

// --- ELIMINAR UN PROVEEDOR ---
app.delete('/api/proveedores/:id', async (req, res) => {
    const id = parseInt(req.params.id);
    if (isNaN(id)) {
        return res.status(400).send('El ID debe ser un número válido.');
    }
    try {
        const text = 'DELETE FROM proveedores WHERE id_proveedor = $1 RETURNING *';
        const result = await pool.query(text, [id]);
        if (result.rows.length === 0) {
            return res.status(404).send('Proveedor no encontrado.');
        }
        res.status(200).json({ message: 'Proveedor eliminado exitosamente', proveedor: result.rows[0] });
    } catch (err) {
        console.error('Error al eliminar el proveedor:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

// =======================================================================
//                        RUTAS API PARA PEDIDOS
// =======================================================================

// --- CREAR UN NUEVO PEDIDO (CON TRANSACCIÓN) ---
app.post('/api/pedidos', async (req, res) => {
    // Obtenemos los datos de la cabecera y el array de items del cuerpo de la petición.
    const { id_empresa, id_cliente, id_estado, total, items } = req.body;

    // Verificamos que los datos mínimos estén.
    if (!id_empresa || !id_cliente || !id_estado || !items || !Array.isArray(items) || items.length === 0) {
        return res.status(400).json({ error: 'Faltan datos de la cabecera o los items del pedido.' });
    }

    const client = await pool.connect();

    try {
        // --- INICIA LA TRANSACCIÓN ---
        await client.query('BEGIN');

        // 1. Insertar la cabecera del pedido y obtener el ID generado.
        const pedidoQuery = 'INSERT INTO pedidos(id_empresa, id_cliente, id_estado, total) VALUES($1, $2, $3, $4) RETURNING id_pedido';
        const pedidoResult = await client.query(pedidoQuery, [id_empresa, id_cliente, id_estado, total]);
        const nuevoPedidoId = pedidoResult.rows[0].id_pedido;

        // 2. Insertar cada uno de los items del pedido, vinculándolos con el ID de la cabecera.
        const itemQuery = 'INSERT INTO pedidoitems(id_pedido, id_producto, cantidad, precio_unitario_congelado, monto_iva, total_linea) VALUES($1, $2, $3, $4, $5, $6)';
        
        for (const item of items) {
            const values = [
                nuevoPedidoId,
                item.id_producto,
                item.cantidad,
                item.precio_unitario, // Asumimos que estos datos vienen calculados desde el frontend
                item.monto_iva,
                item.total_linea
            ];
            await client.query(itemQuery, values);
        }

        // --- SI TODO SALIÓ BIEN, CONFIRMA LA TRANSACCIÓN ---
        await client.query('COMMIT');

        res.status(201).json({ message: 'Pedido creado exitosamente', id_pedido: nuevoPedidoId });

    } catch (err) {
        // --- SI ALGO FALLÓ, DESHACE TODOS LOS CAMBIOS ---
        await client.query('ROLLBACK');
        console.error('Error al crear el pedido:', err.stack);
        res.status(500).send('Error interno del servidor al crear el pedido');
    } finally {
        // Libera la conexión para que pueda ser usada por otras peticiones.
        client.release();
    }
});

// --- OBTENER TODOS LOS PEDIDOS (Cabeceras) ---
app.get('/api/pedidos', async (req, res) => {
    try {
        const result = await pool.query('SELECT * FROM pedidos ORDER BY id_pedido DESC');
        res.json(result.rows);
    } catch (err) {
        console.error('Error al obtener los pedidos:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

// =======================================================================
//                    RUTA API PARA AJUSTE DE INVENTARIO
// =======================================================================

app.put('/api/inventario/ajuste', async (req, res) => {
    // Para ajustar el stock, necesitamos saber de qué empresa y de qué producto se trata.
    const { id_empresa, id_producto, nuevo_stock } = req.body;

    // Verificamos que los datos necesarios estén presentes y sean números.
    if (!id_empresa || !id_producto || nuevo_stock === undefined) {
        return res.status(400).json({ error: 'Se requieren id_empresa, id_producto y nuevo_stock.' });
    }

    if (isNaN(parseInt(nuevo_stock))) {
        return res.status(400).json({ error: 'El nuevo_stock debe ser un número.' });
    }

    try {
        // La consulta actualiza el campo stock_real en la tabla Inventario
        // para la combinación específica de empresa y producto.
        const text = 'UPDATE inventario SET stock_real = $1 WHERE id_empresa = $2 AND id_producto = $3 RETURNING *';
        const values = [nuevo_stock, id_empresa, id_producto];

        const result = await pool.query(text, values);

        // Si la consulta no devuelve ninguna fila, significa que ese producto
        // no estaba cargado en el inventario de esa empresa.
        if (result.rows.length === 0) {
            return res.status(404).send('No se encontró el producto en el inventario de la empresa especificada.');
        }

        res.status(200).json({ message: 'Stock actualizado exitosamente', inventario: result.rows[0] });

    } catch (err) {
        console.error('Error al ajustar el stock:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});
// =======================================================================
// 4. INICIO DEL SERVIDOR
// =======================================================================
app.listen(port, '0.0.0.0', () => {
    console.log(`Servidor Express escuchando en http://0.0.0.0:${port}`);
});

