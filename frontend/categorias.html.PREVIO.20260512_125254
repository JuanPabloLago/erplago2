<!DOCTYPE html>
<html lang="es">
<head>
    <script src="js/config.js"></script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categorías - ERP LAGO</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .categoria-principal {
            background-color: #f8f9fa;
            border-left: 4px solid #0d6efd;
        }
        .subcategoria {
            margin-left: 30px;
            border-left: 3px solid #6c757d;
            padding-left: 15px;
        }
    </style>
</head>
<body>
    <script src="js/connection-indicator.js"></script>
    <nav class="navbar navbar-dark" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
        <div class="container-fluid">
            <a class="navbar-brand" href="dashboard.html">
                <i class="bi bi-arrow-left-circle"></i> ERP LAGO
            </a>
            <span class="navbar-text text-white">
                <i class="bi bi-tags"></i> Gestión de Categorías
            </span>
            <button class="btn btn-outline-light btn-sm" onclick="cerrarSesion()">
                <i class="bi bi-box-arrow-right"></i> Salir
            </button>
        </div>
    </nav>

    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-plus-circle"></i> Acciones
                    </div>
                    <div class="card-body">
                        <button class="btn btn-success w-100 mb-2" onclick="abrirModalNueva()">
                            <i class="bi bi-plus-circle"></i> Nueva Categoría Principal
                        </button>
                        <button class="btn btn-info w-100" onclick="cargarCategorias()">
                            <i class="bi bi-arrow-clockwise"></i> Recargar
                        </button>
                    </div>
                </div>

                <div class="card shadow-sm mt-3">
                    <div class="card-header bg-info text-white">
                        <i class="bi bi-info-circle"></i> Resumen
                    </div>
                    <div class="card-body">
                        <p class="mb-2"><strong>Total Categorías:</strong> <span id="totalCategorias">0</span></p>
                        <p class="mb-2"><strong>Principales:</strong> <span id="principales">0</span></p>
                        <p class="mb-0"><strong>Subcategorías:</strong> <span id="subcategorias">0</span></p>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <i class="bi bi-diagram-3"></i> Árbol de Categorías
                    </div>
                    <div class="card-body">
                        <div id="arbolCategorias">
                            <div class="text-center">
                                <div class="spinner-border spinner-border-sm" role="status"></div>
                                Cargando categorías...
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Crear/Editar Categoría -->
    <div class="modal fade" id="modalCategoria" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="modalTitulo">
                        <i class="bi bi-plus-circle"></i> Nueva Categoría
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="formCategoria">
                        <input type="hidden" id="idCategoria">
                        
                        <div class="mb-3">
                            <label class="form-label">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="nombre" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="descripcion" rows="2"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Categoría Padre</label>
                            <select class="form-select" id="categoriaPadre">
                                <option value="">Sin categoría padre (Principal)</option>
                            </select>
                            <small class="text-muted">Dejar vacío para crear una categoría principal</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Orden</label>
                            <input type="number" class="form-control" id="orden" value="0" min="0">
                            <small class="text-muted">Para ordenar las categorías en la lista</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="guardarCategoria()">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const API_URL = window.CONFIG?.API_BASE_URL || '/api';
        let categorias = [];
        let modalCategoria;

        document.addEventListener('DOMContentLoaded', async () => {
            const token = localStorage.getItem('authToken');
            if (!token) {
                window.location.href = 'login.html';
                return;
            }

            modalCategoria = new bootstrap.Modal(document.getElementById('modalCategoria'));
            await cargarCategorias();
        });

        async function cargarCategorias() {
            try {
                const response = await fetch(`${API_URL}/categorias/arbol`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
                });

                if (response.status === 403 || response.status === 401) {
                    window.location.href = 'login.html';
                    return;
                }

                categorias = await response.json();
                mostrarArbol();
                actualizarResumen();
                await cargarSelectPadres();
            } catch (error) {
                console.error('Error al cargar categorías:', error);
                document.getElementById('arbolCategorias').innerHTML = 
                    '<div class="alert alert-danger">Error al cargar categorías</div>';
            }
        }

        function mostrarArbol() {
            const container = document.getElementById('arbolCategorias');
            
            if (categorias.length === 0) {
                container.innerHTML = '<div class="alert alert-info">No hay categorías creadas</div>';
                return;
            }

            let html = '';
            categorias.forEach(cat => {
                html += `
                    <div class="card categoria-principal mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-1">
                                        <i class="bi bi-folder-fill text-primary"></i> ${cat.nombre}
                                    </h5>
                                    <small class="text-muted">${cat.descripcion || 'Sin descripción'}</small>
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-success" onclick="abrirModalSubcategoria(${cat.id_categoria})" title="Agregar subcategoría">
                                        <i class="bi bi-plus-circle"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="editarCategoria(${cat.id_categoria})" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="eliminarCategoria(${cat.id_categoria}, '${cat.nombre}')" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>`;

                if (cat.subcategorias && cat.subcategorias.length > 0) {
                    html += '<div class="mt-3">';
                    cat.subcategorias.forEach(sub => {
                        html += `
                            <div class="subcategoria card mb-2">
                                <div class="card-body py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <i class="bi bi-folder text-secondary"></i> ${sub.nombre}
                                            <small class="text-muted ms-2">${sub.descripcion || ''}</small>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm btn-warning" onclick="editarCategoria(${sub.id_categoria})" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger" onclick="eliminarCategoria(${sub.id_categoria}, '${sub.nombre}')" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
                    });
                    html += '</div>';
                }

                html += '</div></div>';
            });

            container.innerHTML = html;
        }

        async function cargarSelectPadres() {
            const select = document.getElementById('categoriaPadre');
            const idActual = document.getElementById('idCategoria').value;
            
            select.innerHTML = '<option value="">Sin categoría padre (Principal)</option>';
            
            categorias.forEach(cat => {
                if (!idActual || cat.id_categoria != idActual) {
                    select.innerHTML += `<option value="${cat.id_categoria}">${cat.nombre}</option>`;
                }
            });
        }

        function actualizarResumen() {
            let totalSub = 0;
            categorias.forEach(cat => {
                if (cat.subcategorias) totalSub += cat.subcategorias.length;
            });

            document.getElementById('totalCategorias').textContent = categorias.length + totalSub;
            document.getElementById('principales').textContent = categorias.length;
            document.getElementById('subcategorias').textContent = totalSub;
        }

        function abrirModalNueva() {
            document.getElementById('formCategoria').reset();
            document.getElementById('idCategoria').value = '';
            document.getElementById('categoriaPadre').value = '';
            document.getElementById('modalTitulo').innerHTML = '<i class="bi bi-plus-circle"></i> Nueva Categoría Principal';
            cargarSelectPadres();
            modalCategoria.show();
        }

        function abrirModalSubcategoria(idPadre) {
            document.getElementById('formCategoria').reset();
            document.getElementById('idCategoria').value = '';
            document.getElementById('categoriaPadre').value = idPadre;
            document.getElementById('modalTitulo').innerHTML = '<i class="bi bi-plus-circle"></i> Nueva Subcategoría';
            cargarSelectPadres();
            modalCategoria.show();
        }

        async function editarCategoria(id) {
            try {
                const response = await fetch(`${API_URL}/categorias`, {
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
                });

                const todasCat = await response.json();
                const categoria = todasCat.find(c => c.id_categoria === id);

                if (!categoria) {
                    alert('Categoría no encontrada');
                    return;
                }

                document.getElementById('idCategoria').value = categoria.id_categoria;
                document.getElementById('nombre').value = categoria.nombre;
                document.getElementById('descripcion').value = categoria.descripcion || '';
                document.getElementById('orden').value = categoria.orden || 0;
                
                await cargarSelectPadres();
                document.getElementById('categoriaPadre').value = categoria.id_categoria_padre || '';

                document.getElementById('modalTitulo').innerHTML = '<i class="bi bi-pencil"></i> Editar Categoría';
                modalCategoria.show();
            } catch (error) {
                console.error('Error al cargar categoría:', error);
                alert('Error al cargar datos de la categoría');
            }
        }

        async function guardarCategoria() {
            const id = document.getElementById('idCategoria').value;
            const datos = {
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                id_categoria_padre: document.getElementById('categoriaPadre').value || null,
                orden: parseInt(document.getElementById('orden').value) || 0
            };

            if (!datos.nombre) {
                alert('El nombre es requerido');
                return;
            }

            try {
                const url = id ? `${API_URL}/categorias/${id}` : `${API_URL}/categorias`;
                const method = id ? 'PUT' : 'POST';

                const response = await fetch(url, {
                    method,
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${localStorage.getItem('authToken')}`
                    },
                    body: JSON.stringify(datos)
                });

                const result = await response.json();

                if (response.ok) {
                    alert(result.message);
                    modalCategoria.hide();
                    await cargarCategorias();
                } else {
                    alert(result.error || 'Error al guardar categoría');
                }
            } catch (error) {
                console.error('Error al guardar categoría:', error);
                alert('Error al guardar categoría');
            }
        }

        async function eliminarCategoria(id, nombre) {
            if (!confirm(`¿Está seguro que desea eliminar la categoría "${nombre}"?`)) {
                return;
            }

            try {
                const response = await fetch(`${API_URL}/categorias/${id}`, {
                    method: 'DELETE',
                    headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
                });

                const result = await response.json();

                if (response.ok) {
                    alert(result.message);
                    await cargarCategorias();
                } else {
                    alert(result.error || 'Error al eliminar categoría');
                }
            } catch (error) {
                console.error('Error al eliminar categoría:', error);
                alert('Error al eliminar categoría');
            }
        }

        function cerrarSesion() {
            localStorage.removeItem('authToken');
            localStorage.removeItem('username');
            window.location.href = 'login.html';
        }
    </script>
    <script src="js/auth.js"></script>
</body>
</html>
