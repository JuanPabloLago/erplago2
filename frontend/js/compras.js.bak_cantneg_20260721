async function guardarComprobante() {
    if (guardando) return;
    if (!proveedorSeleccionado) { toast('Seleccione un proveedor (F3)', 'warning'); document.getElementById('inputProv').focus(); return; }
    var id_tipo = document.getElementById('selTipo').value;
