async function guardarNuevoCliente() {
    const cuit = document.getElementById('nuevoCuit')?.value?.trim();
    const nombre = document.getElementById('nuevoNombre')?.value?.trim();
    if (!nombre) { mostrarToast('Razón Social obligatoria', 'warning'); return; }

    // FIX M8: Inferir condición IVA según CUIT/selector
    // Si hay selector de condición IVA en el form, usarlo
    var condIvaEl = document.getElementById('nuevoCondicionIva');
    var id_condicion_iva = condIvaEl ? parseInt(condIvaEl.value) || 4 : 4;

    // Si no hay selector pero hay CUIT con formato empresa (30/33/34), probablemente RI
    if (!condIvaEl && cuit) {
        var cuitLimpio = cuit.replace(/[-\s]/g, '');
        if (cuitLimpio.length >= 11) {
            var prefijo = cuitLimpio.substring(0, 2);
            if (['30', '33', '34'].includes(prefijo)) {
                id_condicion_iva = 1; // Responsable Inscripto (empresa)
            }
        }
    }

    try {
        const response = await fetch(API_URL + '/clientes', {
            method: 'POST',
            headers: authHeaders(true),
            body: JSON.stringify({
                cuit_cuil: cuit || null,
                razon_social: nombre,
                domicilio: document.getElementById('nuevaDireccion')?.value?.trim() || '',
                telefono: document.getElementById('nuevoTelefono')?.value?.trim() || '',
                email: document.getElementById('nuevoEmail')?.value?.trim() || '',
                id_condicion_iva: id_condicion_iva,
                activo: true
            })
        });
        const result = await response.json();
        if (response.ok) {
            const modal = bootstrap.Modal.getInstance(document.getElementById('modalNuevoCliente'));
            if (modal) modal.hide();
            await cargarClientes();
            seleccionarCliente(result.id_cliente, nombre);
            mostrarToast('\u2705 Cliente creado' + (id_condicion_iva === 1 ? ' (Resp. Inscripto)' : ''), 'success');
        } else throw new Error(result.error || 'Error');
    } catch (error) {
        mostrarToast('Error: ' + error.message, 'error');
    }
}
