async function suspenderVenta() {
    if (itemsVentaArray.length === 0) { mostrarToast('No hay productos', 'warning'); return; }
    if (!borradorId) { mostrarToast('Error: sin borrador', 'error'); return; }
    setLoading('btnSuspender', true, 'Suspendiendo...');
    try {
        // FIX C1: Endpoint atómico — cambia estado en UNA transacción
        // Los items ya están en BD (son del borrador), no se recrean
        const observacionesEl = document.getElementById('observaciones');
        const response = await fetch(API_URL + '/borrador/' + borradorId + '/suspender', {
            method: 'POST',
            headers: authHeaders(true),
            body: JSON.stringify({
                observaciones: observacionesEl?.value || ''
            })
        });
        const result = await response.json();
        if (response.ok) {
            mostrarToast('✅ Suspendido #' + (result.id_pedido || borradorId), 'success');
            limpiarVentaLocal();
        } else {
            throw new Error(result.error || 'Error al suspender');
        }
    } catch (error) {
        mostrarToast('Error: ' + error.message, 'error');
    } finally {
        setLoading('btnSuspender', false);
    }
}

async function mostrarSuspendidos() { const modalSuspendidos = document.getElementById('modalSuspendidos'); const modal = modalSuspendidos ? new bootstrap.Modal(modalSuspendidos) : null; const listaEl = document.getElementById('listaSuspendidos'); if (listaEl) listaEl.innerHTML = '<div class="text-center py-4"><span class="spinner-border spinner-border-sm"></span> Cargando...</div>'; if (modal) modal.show(); try { const response = await fetch(API_URL + '/pedidos/suspendidos', { headers: authHeaders() }); if (!response.ok) throw new Error('Error'); const suspendidos = await response.json(); if (listaEl) { if (!suspendidos || suspendidos.length === 0) listaEl.innerHTML = '<div class="text-center py-4 text-muted"><i class="bi bi-inbox" style="font-size:40px;"></i><br>No hay ventas suspendidas</div>'; else listaEl.innerHTML = suspendidos.map(p => '<div class="list-group-item d-flex justify-content-between align-items-center"><div><strong>#'+(p.nro_pedido||p.id_pedido)+'</strong> - '+(p.cliente || p.cliente_nombre || p.razon_social || 'S/N')+'<br><small class="text-success">$'+parseFloat(p.total || p.total_final || 0).toFixed(2)+'</small></div><button class="btn btn-sm btn-success" onclick="recuperarSuspendido('+p.id_pedido+')"><i class="bi bi-arrow-clockwise"></i></button></div>').join(''); } } catch (error) { if (listaEl) listaEl.innerHTML = '<div class="alert alert-danger">'+error.message+'</div>'; } }

async function recuperarSuspendido(idPedido) {
    // v6.0: Si hay borrador activo, suspenderlo primero
    if (borradorId && itemsVentaArray.length > 0) {
        const confirma = await mostrarConfirmacion('¿Suspender venta actual?', 'Tiene ' + itemsVentaArray.length + ' items. Se suspenderá para recuperar el pedido #' + idPedido);
        if (!confirma) return;
        await suspenderVenta();
    }
    try {
        const response = await fetch(API_URL + '/pedidos/' + idPedido + '/recuperar', { method: 'POST', headers: authHeaders(true) });
        if (!response.ok) throw new Error('Error');
        const data = await response.json();
        const pedido = data.pedido; const items = data.items || [];
        if (items.length > 0) {
            itemsVentaArray = items.map(item => ({ id_producto: item.id_producto, id_item: item.id_item || null, sku: item.sku || '', nombre: item.descripcion_congelada || item.producto_nombre || 'Producto', precio_unitario: parseFloat(item.precio_unitario_congelado) || 0, cantidad: parseFloat(item.cantidad) || 1, descuento_porcentaje: parseFloat(item.porcentaje_descuento) || 0, descuento_monto: 0 }));
        }
        // El recuperado ya tiene id_pedido, usarlo como borrador
        borradorId = idPedido;
        if (pedido?.id_cliente) seleccionarCliente(pedido.id_cliente, pedido.razon_social || 'Cliente');
        mostrarItemsVenta(); calcularTotal();
        const modalSuspendidos = document.getElementById('modalSuspendidos'); const modal = bootstrap.Modal.getInstance(modalSuspendidos); if (modal) modal.hide();
        mostrarToast('✅ Recuperado #' + idPedido, 'success');
    } catch (error) { mostrarToast('Error: ' + error.message, 'error'); }
}

