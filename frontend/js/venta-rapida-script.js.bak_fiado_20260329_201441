}

async function agregarProductoPorId(idProducto) {
    let producto = productosCache.get(idProducto);
    if (!producto) producto = productos.find(p => p.id_producto === idProducto);
    if (!producto) { try { const response = await fetch(API_URL + '/productos/' + idProducto + '?id_lista_precio=' + listaSeleccionada, { headers: authHeaders() }); if (response.ok) { producto = await response.json(); productosCache.set(idProducto, producto); } } catch (error) { console.error('Error:', error); } }
    if (producto) agregarProductoDirecto(producto);
    else mostrarToast('Producto no encontrado', 'error');
}

// Normalizar texto: quitar acentos para búsqueda
function normalizarTexto(texto) { return (texto || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase(); }
function escapeHtml(text) { var d = document.createElement('div'); d.textContent = text || ''; return d.innerHTML; }
function busquedaCoincide(texto, busqueda) { const textoNorm = normalizarTexto(texto); const palabras = normalizarTexto(busqueda).split(/\s+/).filter(p => p.length > 0); return palabras.every(palabra => textoNorm.includes(palabra)); }

function filtrarProductosLocal(codigo) {
    const busqueda = codigo.trim();
    if (busqueda.length < 2) return [];
    return productos.filter(p => {
        const sku = p.sku || ''; const nombre = p.nombre || ''; const codigoBarras = p.codigo_barras || ''; const marca = p.marca || '';
        return busquedaCoincide(sku, busqueda) || busquedaCoincide(nombre, busqueda) || busquedaCoincide(codigoBarras, busqueda) || busquedaCoincide(marca + ' ' + nombre, busqueda);
    }).slice(0, 10);
}

function manejarTeclasCodigo(event) {
    const codigo = event.target.value.trim().toUpperCase();
    if (event.key === 'Enter') {
        event.preventDefault();
        if (indiceSeleccionado >= 0 && resultadosProductosFiltrados[indiceSeleccionado]) agregarProductoDirecto(resultadosProductosFiltrados[indiceSeleccionado]);
        else if (codigo) buscarYAgregarProducto(codigo);
    } else if (event.key === 'ArrowDown') { event.preventDefault(); if (resultadosProductosFiltrados.length > 0) { indiceSeleccionado = Math.min(indiceSeleccionado + 1, resultadosProductosFiltrados.length - 1); resaltarProductoSeleccionado(); }
    } else if (event.key === 'ArrowUp') { event.preventDefault(); indiceSeleccionado = Math.max(indiceSeleccionado - 1, 0); resaltarProductoSeleccionado();
    } else if (event.key === ' ') {
        if (event.target.value.trim() === '' && productoRecienAgregado && itemsVentaArray.length > 0) {
            event.preventDefault(); productoRecienAgregado = false;
            const lastInput = document.getElementById('cantidad_' + (itemsVentaArray.length - 1));
            if (lastInput) { lastInput.focus(); lastInput.select(); }
        }
    } else if (event.key === 'Escape') {
        event.preventDefault(); event.target.value = '';
        const sugerenciasEl = document.getElementById('sugerenciasProductos');
        if (sugerenciasEl) sugerenciasEl.innerHTML = '';
        resultadosProductosFiltrados = []; indiceSeleccionado = -1; productoRecienAgregado = false;
    } else { if (event.key.length === 1) productoRecienAgregado = false; }
}

function _pagarTotalYGuardar(forma) {
    if (itemsVentaArray.length === 0) { mostrarToast('No hay productos', 'warning'); return; }
    var total = obtenerTotalVenta();
    var pagado = obtenerTotalPagado();
    var saldo = total - pagado;
    if (saldo > 0) { registrarPago(forma, saldo); actualizarVisualizacionPagos(); actualizarEstadoBloqueo(); }
    guardarVenta();
}

function manejarAtajosGlobales(event) {
    if (event.key === 'F1') { event.preventDefault(); _pagarTotalYGuardar('efectivo'); }
