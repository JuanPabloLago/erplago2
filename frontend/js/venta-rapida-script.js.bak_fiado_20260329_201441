// TERMINAL / CUOTAS — Modal de selección
// ═══════════════════════════════════════════════════════════════
var _terminalesCache = null;
var _terminalModalForma = null;
var _terminalModalSaldo = 0;
var _terminalSeleccionadaId = null;

async function abrirModalTerminal(forma, saldo) {
    _terminalModalForma = forma;
    _terminalModalSaldo = saldo;
    var modal = document.getElementById('modalTerminalCuotas');
    if (!modal) { registrarPago(forma, saldo); actualizarVisualizacionPagos(); actualizarEstadoBloqueo(); return; }

    var tituloEl = document.getElementById('terminalModalTitulo');
    if (tituloEl) tituloEl.textContent = forma === 'credito' ? 'Crédito — Seleccionar terminal' : 'Débito — Seleccionar terminal';

    document.getElementById('terminalPaso1').style.display = 'block';
    document.getElementById('terminalPaso2').style.display = 'none';

    try {
        if (!_terminalesCache) {
            var resp = await fetch((window.CONFIG?.API_BASE_URL || '/api') + '/terminales/activas', { headers: authHeaders() });
            _terminalesCache = await resp.json();
        }

        var terminales = _terminalesCache.filter(function(t) {
            if (forma === 'credito') return t.tipo === 'credito' || t.tipo === 'ambos';
            if (forma === 'debito') return t.tipo === 'debito' || t.tipo === 'ambos';
            return true;
        });

        var listaEl = document.getElementById('listaTerminales');
        if (terminales.length === 0) {
            listaEl.innerHTML = '<div class="text-muted text-center py-3">No hay terminales configuradas</div>';
        } else if (terminales.length === 1 && forma === 'credito') {
            // Auto-seleccionar si hay 1 sola terminal
            seleccionarTerminal(terminales[0].id_terminal, terminales[0].nombre);
        } else if (terminales.length === 1 && forma === 'debito') {
            // Débito con 1 terminal: registrar directo
            registrarPago(forma, saldo, { id_terminal: terminales[0].id_terminal });
            actualizarVisualizacionPagos(); actualizarEstadoBloqueo();
            if (obtenerTotalPagado() >= obtenerTotalVenta()) mostrarToast('✅ Pago completo', 'success');
            return;
        } else {
            listaEl.innerHTML = terminales.map(function(t) {
                return '<button class="btn btn-outline-primary w-100 mb-2 text-start" onclick="seleccionarTerminal('+t.id_terminal+',this.dataset.nombre)" data-nombre="'+t.nombre.replace(/"/g,'&quot;')+'"><i class="bi bi-credit-card me-2"></i><strong>'+t.nombre+'</strong><br><small class="text-muted">'+t.procesador+' — Comisión: '+(forma==='credito' ? t.comision_credito_pct : t.comision_debito_pct)+'%</small></button>';
            }).join('');
        }

        var bsModal = new bootstrap.Modal(modal);
        bsModal.show();
    } catch (err) {
        console.error('Error cargando terminales:', err);
        registrarPago(forma, saldo);
        actualizarVisualizacionPagos(); actualizarEstadoBloqueo();
    }
}

async function seleccionarTerminal(idTerminal, nombreTerminal) {
    _terminalSeleccionadaId = idTerminal;
    var forma = _terminalModalForma;
    var saldo = _terminalModalSaldo;

    if (forma === 'debito') {
        registrarPago(forma, saldo, { id_terminal: idTerminal });
        actualizarVisualizacionPagos(); actualizarEstadoBloqueo();
        cerrarModalTerminal();
        if (obtenerTotalPagado() >= obtenerTotalVenta()) mostrarToast('✅ Pago completo', 'success');
        return;
    }

    // Crédito: cargar planes de cuotas
    document.getElementById('terminalPaso1').style.display = 'none';
    document.getElementById('terminalPaso2').style.display = 'block';
    document.getElementById('terminalSeleccionada').textContent = nombreTerminal;
    document.getElementById('montoBaseCuotas').textContent = '$' + saldo.toFixed(2);

    var planesEl = document.getElementById('listaCuotas');
    planesEl.innerHTML = '<div class="text-center py-3"><div class="spinner-border spinner-border-sm"></div> Cargando...</div>';

    try {
        var resp = await fetch((window.CONFIG?.API_BASE_URL || '/api') + '/terminales/' + idTerminal + '/preview/' + saldo, { headers: authHeaders() });
        var planes = await resp.json();

        planesEl.innerHTML = planes.map(function(p) {
            var esDestacado = p.cuotas === 1;
            var clase = esDestacado ? 'btn-success' : 'btn-outline-success';
            var intLabel = p.interes > 0 ? '<small class="text-warning">'+p.interes_porcentaje.toFixed(2)+'% (+$'+p.interes.toFixed(0)+')</small>' : '<small class="text-success">Sin interés</small>';
            return '<button class="btn '+clase+' w-100 mb-2 py-2 text-start" data-plan="'+p.id_plan+'" data-cuotas="'+p.cuotas+'" data-coef="'+p.coeficiente+'" data-final="'+p.monto_final+'" data-base="'+saldo+'" data-nombre="'+p.nombre.replace(/"/g,'&quot;')+'" onclick="confirmarCuota(+this.dataset.plan,+this.dataset.cuotas,+this.dataset.coef,+this.dataset.final,+this.dataset.base,this.dataset.nombre)">'
                + '<div class="d-flex justify-content-between align-items-center">'
                + '<div><strong>'+p.nombre+'</strong><br>'+intLabel+'</div>'
                + '<div class="text-end"><strong>$'+p.monto_final.toFixed(0)+'</strong>'+(p.cuotas > 1 ? '<br><small>'+p.cuotas+' x $'+p.valor_cuota.toFixed(0)+'</small>' : '')+'</div>'
                + '</div></button>';
        }).join('');
    } catch (err) {
        planesEl.innerHTML = '<div class="text-danger">Error al cargar planes</div>';
    }
}

function confirmarCuota(idPlan, cuotas, coeficiente, montoFinal, montoOriginal, nombrePlan) {
    // 1. Inflar RESUMEN visual (subtotal + recargo + total)
    var recargoPct = (coeficiente - 1) * 100;
    var recargoEl = document.getElementById('recargoCuotasPorcentaje');
    if (recargoEl) recargoEl.value = recargoPct.toFixed(4);
    calcularTotal();
    // 2. Registrar pago con monto FINAL (posnet) + base como monto_original
    var base = _terminalModalSaldo;
    registrarPago('credito', montoFinal, {
        id_plan: idPlan,
        id_terminal: _terminalSeleccionadaId,
        cuotas: cuotas,
        coeficiente: coeficiente,
        nombre_plan: nombrePlan,
        monto_original: base
    });
    actualizarVisualizacionPagos();
    actualizarEstadoBloqueo();
    cerrarModalTerminal();
    if (obtenerTotalPagado() >= obtenerTotalVenta()) mostrarToast('Pago completo', 'success');
}
