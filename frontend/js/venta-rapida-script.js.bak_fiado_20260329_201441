async function quitarItem(index) {
    if (tienePagosRegistrados()) { mostrarAlertaBloqueo(); return; }
    const item = itemsVentaArray[index];
    if (!item || !item.id_item || !borradorId) return;

    const control = configBorrador.control_eliminacion || 'con_autorizacion';

    let bodyData = {};

    if (control === 'con_autorizacion') {
        // Pedir clave de supervisor
        const auth = await pedirAutorizacionSupervisor('Eliminar: ' + item.nombre);
        if (!auth) return; // Canceló
        bodyData.id_usuario_autorizo = auth.id_usuario_autorizo;
        bodyData.motivo = auth.motivo;
    } else if (control === 'con_log') {
        // Solo pedir motivo opcionalmente
        bodyData.motivo = 'Eliminado por vendedor';
    }
    // Si es 'libre', no pide nada

    try {
        const response = await fetch(API_URL + '/borrador/' + borradorId + '/items/' + item.id_item, {
            method: 'DELETE',
            headers: authHeaders(true),
            body: JSON.stringify(bodyData)
        });
        const data = await response.json();
        if (!response.ok) {
            mostrarToast(data.error || 'Error al eliminar', 'error');
            return;
        }
        sincronizarDesdeRespuesta(data);
        mostrarToast('Eliminado: ' + (item.nombre?.substring(0, 20) || ''), 'info', 1500);
    } catch (error) {
        console.error('Error eliminando item:', error);
        mostrarToast('Error de conexión', 'error');
    }
}

function calcularTotal() {
    let subtotal_con_dto_items = 0;
    itemsVentaArray.forEach(item => { const subtotal_bruto = item.cantidad * item.precio_unitario; let descuento_item = 0; if (item.descuento_porcentaje > 0) descuento_item = subtotal_bruto * (item.descuento_porcentaje / 100); else if (item.descuento_monto > 0) descuento_item = item.descuento_monto * item.cantidad; subtotal_con_dto_items += (subtotal_bruto - descuento_item); });
    const descuentoPercEl = document.getElementById('descuentoGeneralPorcentaje'); const descuentoMontoEl = document.getElementById('descuentoGeneralMonto');
    const dto_gral_porcentaje = descuentoPercEl ? (parseFloat(descuentoPercEl.value) || 0) : 0; const dto_gral_monto = descuentoMontoEl ? (parseFloat(descuentoMontoEl.value) || 0) : 0;
    let descuento_general = 0; if (dto_gral_porcentaje > 0) descuento_general = subtotal_con_dto_items * (dto_gral_porcentaje / 100); if (dto_gral_monto > 0) descuento_general += dto_gral_monto;
    const subtotal_post_dto = subtotal_con_dto_items - descuento_general;
    var recargoCuotasEl = document.getElementById('recargoCuotasPorcentaje'); var recargo_pct = recargoCuotasEl ? (parseFloat(recargoCuotasEl.value) || 0) : 0;
    var _ivaTotal = 0; if (subtotal_con_dto_items > 0) { itemsVentaArray.forEach(function(it) { var sb = it.cantidad * it.precio_unitario; var d = 0; if (it.descuento_porcentaje > 0) d = sb * (it.descuento_porcentaje / 100); else if (it.descuento_monto > 0) d = it.descuento_monto * it.cantidad; _ivaTotal += (sb - d) * ((it.iva_porcentaje || 21) / 100); }); _ivaTotal = _ivaTotal * (subtotal_post_dto / subtotal_con_dto_items); } const iva = _ivaTotal; const total_sin_recargo = Math.round(subtotal_post_dto + iva); var recargo_monto = recargo_pct > 0 ? Math.round(total_sin_recargo * recargo_pct / 100 * 100) / 100 : 0; const subtotal_final = subtotal_post_dto; const total = recargo_monto > 0 ? Math.round((total_sin_recargo + recargo_monto) * 100) / 100 : total_sin_recargo;
    const esRI = clienteActual && clienteActual.id_condicion_iva === 1;
    const resumenSubtotalEl = document.getElementById('resumenSubtotal'); const resumenNetoEl = document.getElementById('resumenNeto'); const resumenIVAEl = document.getElementById('resumenIVA'); const totalVentaFinalEl = document.getElementById('totalVentaFinal');
