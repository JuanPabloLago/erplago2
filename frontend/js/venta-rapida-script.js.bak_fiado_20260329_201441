    var _ivaPctItem = (itemsVentaArray[index]?.iva_porcentaje || 21); var precioNeto = esRI ? nuevoPrecio : nuevoPrecio / (1 + _ivaPctItem / 100);

    // FIX C6: BD primero, UI después (patrón de cambiarCantidad)
    try {
        var response = await fetch(API_URL + '/borrador/' + borradorId + '/items/' + item.id_item, {
            method: 'PUT',
            headers: authHeaders(true),
            body: JSON.stringify({ precio_unitario: precioNeto })
        });
        var data = await response.json();
        if (!response.ok) {
            mostrarToast(data.error || 'Error al actualizar precio', 'error');
            mostrarItemsVenta(); // Revertir UI
            return;
        }
        sincronizarDesdeRespuesta(data);
    } catch (err) {
        console.error('Error cambiando precio:', err);
        mostrarToast('Error de conexión', 'error');
        mostrarItemsVenta(); // Revertir UI
    }
}


