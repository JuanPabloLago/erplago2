// HISTORIAL VENTAS PRODUCTO → CLIENTE
// ═══════════════════════════════════════════════════════
async function verHistorialProductoCliente(index) {
    var _item = itemsVentaArray[index];
    if (!_item) return;
    var idProducto = _item.id_producto;
    var nombreProducto = _item.nombre;
    var precioActual = _item.precio_unitario;
    var idCliente = clienteActual ? clienteActual.id_cliente : null;
    var nombreCliente = clienteActual ? clienteActual.razon_social : 'Sin cliente';
    var modalEl = document.getElementById('modalHistorialProducto');
    if (!modalEl) return;
    document.getElementById('histProductoNombre').textContent = nombreProducto || 'Producto';
    document.getElementById('histClienteNombre').textContent = nombreCliente;
    document.getElementById('histPrecioActual').textContent = '$' + (precioActual ? (precioActual * 1.21).toFixed(0) : '0');
    var bodyEl = document.getElementById('historialProductoBody');
    bodyEl.innerHTML = '<tr><td colspan="5" class="text-center py-3"><span class="spinner-border spinner-border-sm"></span> Buscando...</td></tr>';
    var modal = new bootstrap.Modal(modalEl);
    modal.show();
    try {
        var url = API_URL + '/pedidos/historial-producto-cliente?id_producto=' + idProducto;
        if (idCliente) url += '&id_cliente=' + idCliente;
        var resp = await fetch(url, { headers: authHeaders() });
        if (!resp.ok) throw new Error('Error');
        var data = await resp.json();
        if (!data || data.length === 0) {
            bodyEl.innerHTML = '<tr><td colspan="5" class="text-center py-3 text-muted">Sin ventas anteriores</td></tr>';
            return;
        }
        bodyEl.innerHTML = data.map(function(v) {
            var precioConIva = Math.round(parseFloat(v.precio_unitario_congelado) * (1 + (parseFloat(v.iva_aplicado) || 21) / 100));
            var totalConIva = Math.round(parseFloat(v.total_linea));
            var fecha = new Date(v.fecha_creacion).toLocaleDateString('es-AR');
            var badge = precioConIva === Math.round(precioActual * 1.21) ? '' : (precioConIva < Math.round(precioActual * 1.21) ? '<span style="color:var(--lago-success);font-size:10px;"> ↓</span>' : '<span style="color:var(--lago-danger);font-size:10px;"> ↑</span>');
            return '<tr><td>' + fecha + '</td><td>#' + (v.nro_pedido || v.id_pedido) + '</td><td class="text-center">' + parseFloat(v.cantidad) + '</td><td class="text-end" style="font-weight:700;">$' + precioConIva + badge + '</td><td class="text-end">$' + totalConIva + '</td></tr>';
        }).join('');
    } catch (e) {
        bodyEl.innerHTML = '<tr><td colspan="5" class="text-center text-danger">Error al buscar historial</td></tr>';
    }
}
window.verHistorialProductoCliente = verHistorialProductoCliente;

