function actualizarVisualizacionPagos() { const total = obtenerTotalVenta(); const pagado = obtenerTotalPagado(); const saldo = total - pagado; const saldoInfo = document.getElementById('saldoRestanteInfo'); if (saldoInfo) saldoInfo.textContent = saldo.toFixed(2); const resumenEl = document.getElementById('resumenPagos'); const totalAPagarEl = document.getElementById('totalAPagar'); const totalPagadoEl = document.getElementById('totalPagado'); const saldoRestanteEl = document.getElementById('saldoRestante'); if (resumenEl) { resumenEl.style.display = pagosRegistrados.length > 0 ? 'block' : 'none'; let listaPagosEl = document.getElementById('listaPagosRegistrados'); if (!listaPagosEl && pagosRegistrados.length > 0) { listaPagosEl = document.createElement('div'); listaPagosEl.id = 'listaPagosRegistrados'; listaPagosEl.className = 'mt-2'; resumenEl.appendChild(listaPagosEl); } if (listaPagosEl) { if (pagosRegistrados.length === 0) listaPagosEl.innerHTML = ''; else listaPagosEl.innerHTML = '<small><strong>Pagos:</strong></small><br>' + pagosRegistrados.map((p, idx) => '<span class="badge bg-success me-1 mb-1">'+formatearFormaPago(p.forma)+(p.cuotas && p.cuotas > 1 ? ' '+p.cuotas+'c' : '')+': $'+p.monto.toFixed(2)+(p.coeficiente && p.coeficiente > 1 ? ' <small>(posnet $'+(p.monto * p.coeficiente).toFixed(0)+')</small>' : '')+(p.monto_original && p.monto_original !== p.monto ? ' <small>(base $'+p.monto_original.toFixed(2)+')</small>' : '')+' <span style="cursor:pointer;margin-left:3px;" onclick="eliminarPago('+idx+')">×</span></span>').join(''); } } if (totalAPagarEl) totalAPagarEl.textContent = total.toFixed(2); if (totalPagadoEl) totalPagadoEl.textContent = pagado.toFixed(2); if (saldoRestanteEl) saldoRestanteEl.textContent = saldo.toFixed(2); const alertaSaldoEl = document.getElementById('alertaSaldoPendiente'); const montoPendienteEl = document.getElementById('montoPendiente'); if (alertaSaldoEl) alertaSaldoEl.style.display = (pagado > 0 && saldo > 0) ? 'block' : 'none'; if (montoPendienteEl) montoPendienteEl.textContent = saldo.toFixed(2); document.querySelectorAll('.forma-pago-btn[data-forma]').forEach(btn => { const forma = btn.getAttribute('data-forma'); const usado = pagosRegistrados.some(p => p.forma === forma); btn.classList.remove('btn-success','btn-outline-success','btn-outline-primary','btn-outline-warning','btn-outline-info','btn-outline-secondary','btn-outline-dark'); if (usado) btn.classList.add('btn-success'); else { const clases = {efectivo:'btn-outline-success',debito:'btn-outline-primary',credito:'btn-outline-warning',transferencia:'btn-outline-info',mercadopago:'btn-outline-secondary',mercadopago_qr:'btn-outline-dark'}; btn.classList.add(clases[forma] || 'btn-outline-secondary'); } }); }
