function pedirAutorizacionSupervisor(motivo) {
    return new Promise((resolve) => {
        const overlay = document.createElement('div');
        overlay.className = 'modal-autorizar-overlay';
        overlay.innerHTML = '<div class="modal-autorizar-box">' +
            '<h5 style="margin-bottom:15px;"><i class="bi bi-shield-lock" class="vr-descuento-info"></i> Autorización requerida</h5>' +
            '<p class="text-muted" style="font-size:14px;">Para eliminar un item se necesita clave de supervisor.</p>' +
            '<div class="mb-3"><label class="form-label small">Usuario supervisor</label>' +
            '<input type="text" id="authSuperUser" class="form-control" placeholder="Usuario" autocomplete="off"></div>' +
            '<div class="mb-3"><label class="form-label small">Contraseña</label>' +
            '<input type="password" id="authSuperPass" class="form-control" placeholder="Contraseña"></div>' +
            '<div class="mb-3"><label class="form-label small">Motivo</label>' +
            '<input type="text" id="authSuperMotivo" class="form-control" placeholder="¿Por qué eliminar?" value="' + (motivo || '') + '"></div>' +
            '<div class="d-flex gap-2 justify-content-end">' +
            '<button id="authCancelBtn" class="btn btn-secondary">Cancelar</button>' +
            '<button id="authConfirmBtn" class="btn btn-danger">Autorizar</button>' +
            '</div></div>';
        document.body.appendChild(overlay);

        const userInput = overlay.querySelector('#authSuperUser');
        const passInput = overlay.querySelector('#authSuperPass');
        const motivoInput = overlay.querySelector('#authSuperMotivo');
        setTimeout(() => userInput.focus(), 100);

        function cerrar(result) {
            overlay.remove();
            resolve(result);
        }

        overlay.querySelector('#authCancelBtn').addEventListener('click', () => cerrar(null));
        overlay.addEventListener('click', (e) => { if (e.target === overlay) cerrar(null); });

        async function intentarAutorizar() {
            const user = userInput.value.trim();
            const pass = passInput.value;
            const mot = motivoInput.value.trim();
            if (!user || !pass) { mostrarToast('Complete usuario y contraseña', 'warning'); return; }
            if (!mot) { mostrarToast('Indique el motivo', 'warning'); motivoInput.focus(); return; }

            try {
                const response = await fetch(API_URL + '/borrador/autorizar-eliminacion', {
                    method: 'POST',
                    headers: authHeaders(true),
                    body: JSON.stringify({ username: user, password: pass })
                });
                const data = await response.json();
                if (data.autorizado) {
                    cerrar({ id_usuario_autorizo: data.id_usuario_autorizo, motivo: mot });
                } else {
                    mostrarToast(data.error || 'No autorizado', 'error');
                    passInput.value = '';
                    passInput.focus();
                }
            } catch (error) {
                mostrarToast('Error de conexión', 'error');
            }
        }

        overlay.querySelector('#authConfirmBtn').addEventListener('click', intentarAutorizar);
        passInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') intentarAutorizar(); });
    });
}

