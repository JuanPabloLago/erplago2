// GUARDAR VENTA - AHORA CONFIRMA EL BORRADOR EN BD
// ═══════════════════════════════════════════════════════════════════════════════
async function guardarVenta() {
    if (itemsVentaArray.length === 0) { mostrarToast('No hay productos', 'warning'); return; }
    if (!borradorId) { mostrarToast('Error: sin borrador activo', 'error'); return; }

    const totalVentaFinalEl = document.getElementById('totalVentaFinal');
    const total = parseFloat((totalVentaFinalEl?.textContent || '$0').replace('$', '').trim()) || 0;
    const totalPagado = obtenerTotalPagado();
    const saldoPendiente = total - totalPagado;

    if (saldoPendiente > 0.01) {
        const clienteNombreEl = document.getElementById('clienteNombre');
        const nombreCliente = clienteNombreEl?.value || 'Cliente';
        if (nombreCliente.toLowerCase().includes('consumidor final')) {
            mostrarToast('Falta pagar $' + saldoPendiente.toFixed(2), 'error', 5000); return;
        }
        const confirma = await mostrarConfirmacion('¿Cuenta Corriente?', 'Saldo pendiente: $' + saldoPendiente.toFixed(2) + '\n\nDeuda de: ' + nombreCliente);
        if (!confirma) { mostrarToast('Complete el pago', 'info'); return; }
        pagosRegistrados.push({ forma: 'cuenta_corriente', monto: saldoPendiente, fecha: new Date().toISOString() }); sincronizarPagosABD();
    }

    setLoading('btnGuardar', true, 'Guardando...');

    const idClienteEl = document.getElementById('idCliente');
    const observacionesEl = document.getElementById('observaciones');
    const descuentoPercEl = document.getElementById('descuentoGeneralPorcentaje');
    const dto_gral_porcentaje = parseFloat(descuentoPercEl?.value) || 0;

    try {
        // v6.0: Confirmar borrador en BD
        const response = await fetch(API_URL + '/borrador/' + borradorId + '/confirmar', {
            method: 'POST',
            headers: authHeaders(true),
            body: JSON.stringify({
                id_cliente: parseInt(idClienteEl?.value) || (clienteActual ? clienteActual.id_cliente : null),
                tipo_entrega: tipoEntrega,
                observaciones: observacionesEl?.value || '',
                descuento_general: dto_gral_porcentaje,
                pagos: pagosRegistrados.map(p => {
                    const mapeo = {efectivo:1,mercadopago:2,mercadopago_qr:2,transferencia:3,credito:4,debito:5,cuenta_corriente:6};
                    var pago = {id_metodo_pago: mapeo[p.forma] || 1, monto: p.monto};
                    if (p.id_terminal) pago.id_terminal = p.id_terminal;
                    if (p.id_plan) { pago.id_plan = p.id_plan; pago.cuotas = p.cuotas; pago.coeficiente = p.coeficiente; pago.monto_original = p.monto_original || p.monto; }
                    return pago;
                })
            })
        });

        const responseData = await response.json();
        if (!response.ok) throw new Error(responseData.error || 'Error');

        const idPedidoReal = responseData.pedido?.id_pedido || borradorId;
        const nroPedidoDisplay = responseData.nro_pedido || responseData.pedido?.nro_pedido || idPedidoReal;
        mostrarModalVentaGuardada(idPedidoReal, nroPedidoDisplay, total, tipoEntrega);
        limpiarVentaLocal();

    } catch (error) {
        mostrarToast('Error: ' + error.message, 'error', 5000);
    } finally {
        setLoading('btnGuardar', false);
    }
}

// Limpia estado local sin tocar BD (el borrador ya fue confirmado o descartado)
