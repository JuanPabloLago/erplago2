// ═══════════════════════════════════════════════════════
// DETECTOR DE LECTOR DE CÓDIGO DE BARRAS
// Si recibe 6+ caracteres en menos de 100ms c/u → scanner
// Auto-busca y agrega sin esperar Enter
// ═══════════════════════════════════════════════════════
let _scanBuffer = '';
let _scanTimer = null;
let _lastKeyTime = 0;
const SCAN_CHAR_MAX_MS = 80;
const SCAN_MIN_CHARS = 6;

function detectarScanner(e) {
    var codigoEl = document.getElementById('codigoProducto');
    if (!codigoEl || document.activeElement !== codigoEl) return;
    if (e.key === 'Enter' || e.key === 'Tab' || e.key === 'Shift') return;
    if (e.key.length !== 1) return;

    var ahora = Date.now();
    var delta = ahora - _lastKeyTime;
    _lastKeyTime = ahora;

    if (delta < SCAN_CHAR_MAX_MS) {
        _scanBuffer += e.key;
    } else {
        _scanBuffer = e.key;
    }

    if (_scanTimer) clearTimeout(_scanTimer);
    _scanTimer = setTimeout(function() {
        if (_scanBuffer.length >= SCAN_MIN_CHARS) {
            var codigo = _scanBuffer.trim().toUpperCase();
            _scanBuffer = '';
            codigoEl.value = codigo;
            // Limpiar sugerencias y buscar directo
            var sug = document.getElementById('sugerenciasProductos');
            if (sug) sug.innerHTML = '';
            resultadosProductosFiltrados = [];
            indiceSeleccionado = -1;
            buscarYAgregarProducto(codigo);
        }
        _scanBuffer = '';
    }, 150);
}
document.addEventListener('keydown', detectarScanner);

