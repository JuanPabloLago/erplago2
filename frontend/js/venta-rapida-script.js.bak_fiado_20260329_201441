// ═══════════════════════════════════════════════════════════════════════════════
let _heartbeatOk = true;

function iniciarHeartbeat() {
    setInterval(async () => {
        try {
            const resp = await fetch(API_URL + '/auth/perfil', {
                headers: authHeaders(), signal: AbortSignal.timeout(5000)
            });
            if (!_heartbeatOk && resp.ok) { mostrarToast('Conexión restaurada', 'success', 2000); }
            _heartbeatOk = resp.ok;
        } catch (e) {
            if (_heartbeatOk) { mostrarToast('Sin conexión al servidor', 'error', 10000); }
            _heartbeatOk = false;
        }
        // Indicador visual en navbar
        var indicador = document.getElementById('indicadorConexion');
        if (!indicador) {
            indicador = document.createElement('span');
            indicador.id = 'indicadorConexion';
            indicador.style.cssText = 'margin-left:12px;font-size:10px;';
            var nav = document.querySelector('.navbar-text, .navbar-brand');
            if (nav && nav.parentElement) nav.parentElement.appendChild(indicador);
        }
        indicador.textContent = _heartbeatOk ? '🟢' : '🔴';
        indicador.title = _heartbeatOk ? 'Conectado' : 'Sin conexión';
    }, 30000); // Cada 30 segundos
}

