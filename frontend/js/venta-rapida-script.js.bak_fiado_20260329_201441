function authHeaders(json = false) {
    const h = { 'Authorization': 'Bearer ' + localStorage.getItem('authToken') };
    if (json) h['Content-Type'] = 'application/json';
    return h;
}

async function cargarBorradorActivo() {
    // Si borradorId apunta a un pedido inválido, limpiar
    // VR-3 FIX: Pre-check eliminado (GET /borrador/:id no existe como ruta)
    // La validación real la hace GET /borrador (obtenerBorradorActivo)
    try {
        const response = await fetch(API_URL + '/borrador', { headers: authHeaders() });
        if (!response.ok) return;
        const data = await response.json();

        if (data.configs) {
            configBorrador = data.configs;
            // Sincronizar con configUsuario existente
            if (window.configUsuario) {
                window.configUsuario.permitir_venta_sin_stock = configBorrador.permitir_venta_sin_stock;
                window.configUsuario.permitir_cambiar_precio = configBorrador.permitir_cambiar_precio;
            }
        }

        if (data.borrador) {
            borradorId = data.borrador.id_pedido;
            // Restaurar items desde BD
            itemsVentaArray = (data.borrador.items || []).map(item => ({
                id_producto: item.id_producto,
                id_item: item.id_item,
                sku: item.producto_codigo || item.sku || 'S/C',
                nombre: item.descripcion_congelada || item.producto_nombre || 'Producto',
                cantidad: parseFloat(item.cantidad) || 1,
                precio_unitario: parseFloat(item.precio_unitario_congelado) || 0,
                descuento_porcentaje: parseFloat(item.porcentaje_descuento) || 0,
                descuento_monto: 0,
                stock_actual: parseFloat(item.stock_actual) || 0,
                iva_porcentaje: parseFloat(item.iva_aplicado) || 21
            }));
            // Restaurar cliente si tenía
            if (data.borrador.id_cliente) {
                const cl = clientes.find(c => c.id_cliente === data.borrador.id_cliente);
                if (cl) seleccionarCliente(cl.id_cliente, cl.razon_social);
            }
            mostrarItemsVenta();
            calcularTotal();
            if (itemsVentaArray.length > 0) {
                mostrarToast('Borrador recuperado: ' + itemsVentaArray.length + ' items', 'info', 2000);
            }
        }

        // FIX I3: Restaurar pagos provisorios
        if (data.pagos_provisorios && Array.isArray(data.pagos_provisorios) && data.pagos_provisorios.length > 0) {
            pagosRegistrados = data.pagos_provisorios;
            actualizarVisualizacionPagos();
            actualizarEstadoBloqueo();
            mostrarToast('Pagos recuperados: ' + pagosRegistrados.length, 'info', 2000);
        }
    } catch (error) {
        console.error('Error cargando borrador:', error);
    }
}

async function crearBorradorSiNoExiste() {
    if (borradorId) return borradorId;
    try {
        const response = await fetch(API_URL + '/borrador', {
            method: 'POST',
            headers: authHeaders(true),
            body: JSON.stringify({})
        });
        if (!response.ok) throw new Error('Error creando borrador');
        const data = await response.json();
        borradorId = data.borrador.id_pedido;
        return borradorId;
    } catch (error) {
        console.error('Error creando borrador:', error);
        mostrarToast('Error de conexión', 'error');
        return null;
    }
}

function sincronizarDesdeRespuesta(data) {
    if (!data.borrador) return;
    borradorId = data.borrador.id_pedido;
    itemsVentaArray = (data.borrador.items || []).map(item => ({
        id_producto: item.id_producto,
        id_item: item.id_item,
        sku: item.producto_codigo || item.sku || 'S/C',
        nombre: item.descripcion_congelada || item.producto_nombre || 'Producto',
        cantidad: parseFloat(item.cantidad) || 1,
        precio_unitario: parseFloat(item.precio_unitario_congelado) || 0,
        descuento_porcentaje: parseFloat(item.porcentaje_descuento) || 0,
        descuento_monto: 0,
        stock_actual: parseFloat(item.stock_actual) || 0,
        iva_porcentaje: parseFloat(item.iva_aplicado) || 21
    }));
    mostrarItemsVenta();
    calcularTotal();

    // FIX M5: Si la BD envía total_final, usarlo como fuente de verdad
    // total_final en BD ya incluye IVA — NO multiplicar de nuevo
    if (data.borrador.total_final !== undefined && data.borrador.total_final !== null) {
        var totalBD = parseFloat(data.borrador.total_final);
        if (totalBD > 0) {
            var totalEl = document.getElementById('totalVentaFinal');
            if (totalEl) totalEl.textContent = '$' + Math.round(totalBD).toFixed(2);
        }
    }
    if (typeof mostrarImagenProducto === "function") mostrarImagenProducto(itemsVentaArray[itemsVentaArray.length - 1]);
}

