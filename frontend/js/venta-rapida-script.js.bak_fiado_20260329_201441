// CAMBIAR CANTIDAD - AHORA VA A BD
// ═══════════════════════════════════════════════════════════════════════════════
// FIX M4: Timer por índice para evitar requests duplicados al tipear rápido
const _cantidadTimers = new Map();

async function cambiarCantidad(index, cantidad) {
    if (tienePagosRegistrados()) { mostrarAlertaBloqueo(); mostrarItemsVenta(); return; }
    const item = itemsVentaArray[index];
    if (!item || !item.id_item || !borradorId) return;

    const nuevaCantidad = parseFloat(cantidad) || 0.01;

    // Debounce: esperar 500ms antes de enviar al servidor
    if (_cantidadTimers.has(index)) clearTimeout(_cantidadTimers.get(index));
    _cantidadTimers.set(index, setTimeout(async () => {
        _cantidadTimers.delete(index);
        _enviarCambiarCantidad(index, nuevaCantidad);
    }, 500));
}

async function _enviarCambiarCantidad(index, nuevaCantidad) {
    const item = itemsVentaArray[index];
    if (!item || !item.id_item || !borradorId) return;

    try {
        const response = await fetch(API_URL + '/borrador/' + borradorId + '/items/' + item.id_item, {
            method: 'PUT',
            headers: authHeaders(true),
            body: JSON.stringify({ cantidad: nuevaCantidad })
        });
        const data = await response.json();
        if (!response.ok) {
            mostrarToast(data.error || 'Error al modificar', 'error');
            mostrarItemsVenta(); // Revertir UI
            return;
        }
        sincronizarDesdeRespuesta(data);
    } catch (error) {
        console.error('Error modificando cantidad:', error);
        mostrarToast('Error de conexión', 'error');
        mostrarItemsVenta();
    }
}

async function cambiarDescuento(index, descuento) {
