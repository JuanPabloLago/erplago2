async function cambiarPrecio(index, nuevoPrecio, esRI) {
    if (tienePagosRegistrados()) { mostrarAlertaBloqueo(); mostrarItemsVenta(); return; }
    nuevoPrecio = parseFloat(nuevoPrecio);
    if (isNaN(nuevoPrecio) || nuevoPrecio <= 0) { mostrarToast('Precio inválido', 'warning'); mostrarItemsVenta(); return; }
    var item = itemsVentaArray[index];
    if (!item || !item.id_item || !borradorId) return;

