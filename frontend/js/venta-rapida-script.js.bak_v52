window.mostrarFormNuevoCliente = mostrarFormNuevoCliente;
window.guardarNuevoCliente = guardarNuevoCliente;
window.confirmarDireccionEntrega = confirmarDireccionEntrega;
window.cancelarEntrega = cancelarEntrega;
