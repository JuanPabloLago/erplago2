// ═══════════════════════════════════════════════════════════════════════════════
// FUNCIONES DE IMPRESIÓN Y ENVÍO
// ═══════════════════════════════════════════════════════════════════════════════

let ultimoPedidoGuardado = null;

function mostrarModalVentaGuardada(idPedido, total, tipoEntrega) {
    ultimoPedidoGuardado = idPedido;
    const numEl = document.getElementById('numeroPedidoGuardado');
    const totalEl = document.getElementById('totalPedidoGuardado');
    const infoEl = document.getElementById('infoEntregaGuardado');
    
    if (numEl) numEl.textContent = idPedido;
    if (totalEl) totalEl.textContent = parseFloat(total).toFixed(2);
    if (infoEl) {
        infoEl.textContent = tipoEntrega === 'retira' ? '🏪 Cliente retira en local' : '🚚 Para entregar';
    }
    
    const modal = new bootstrap.Modal(document.getElementById('modalVentaGuardada'));
    modal.show();
}

function imprimirComprobante() {
    if (!ultimoPedidoGuardado) return;
    const token = localStorage.getItem('authToken');
    const url = API_URL + '/print/comprobante/' + ultimoPedidoGuardado + '/html?token=' + token;
    const ventana = window.open(url, '_blank', 'width=800,height=600');
    ventana.onload = function() {
        setTimeout(() => ventana.print(), 500);
    };
}

function verComprobante() {
    if (!ultimoPedidoGuardado) return;
    const token = localStorage.getItem('authToken');
    window.open(API_URL + '/print/comprobante/' + ultimoPedidoGuardado + '/html?token=' + token, '_blank');
}

function enviarPorWhatsApp() {
    if (!ultimoPedidoGuardado) return;
    const clienteNombre = document.getElementById('clienteNombre')?.value || 'Cliente';
    const total = document.getElementById('totalPedidoGuardado')?.textContent || '0';
    const mensaje = encodeURIComponent(
        '🧾 *Comprobante de Venta*\n\n' +
        '📋 Pedido #' + ultimoPedidoGuardado + '\n' +
        '👤 ' + clienteNombre + '\n' +
        '💰 Total: $' + total + '\n\n' +
        '¡Gracias por su compra!'
    );
    window.open('https://wa.me/?text=' + mensaje, '_blank');
}

// Exponer funciones globalmente
window.imprimirComprobante = imprimirComprobante;
window.verComprobante = verComprobante;
window.enviarPorWhatsApp = enviarPorWhatsApp;
window.mostrarModalVentaGuardada = mostrarModalVentaGuardada;

// ═══════════════════════════════════════════════════════════════════════════════
// EDITAR CLIENTE
// ═══════════════════════════════════════════════════════════════════════════════
async function editarCliente(idCliente) {
    const cliente = clientes.find(c => c.id_cliente === idCliente);
    if (!cliente) { mostrarToast('Cliente no encontrado', 'error'); return; }
    
    document.getElementById('editClienteId').value = cliente.id_cliente;
    document.getElementById('editClienteCuit').value = cliente.cuit_cuil || '';
    document.getElementById('editClienteNombre').value = cliente.razon_social || '';
    document.getElementById('editClienteFantasia').value = cliente.nombre_fantasia || '';
    document.getElementById('editClienteDireccion').value = cliente.domicilio || '';
    document.getElementById('editClienteLocalidad').value = cliente.localidad || '';
    document.getElementById('editClienteTelefono').value = cliente.telefono || '';
    document.getElementById('editClienteEmail').value = cliente.email || '';
    
    const modalEditar = new bootstrap.Modal(document.getElementById('modalEditarCliente'));
    modalEditar.show();
}

async function guardarEdicionCliente() {
    const idCliente = document.getElementById('editClienteId').value;
    const cliente = clientes.find(c => c.id_cliente === parseInt(idCliente));
    const datos = {
        cuit_cuil: document.getElementById("editClienteCuit").value.trim(),
        razon_social: document.getElementById("editClienteNombre").value.trim(),
        nombre_fantasia: document.getElementById("editClienteFantasia").value.trim(),
        domicilio: document.getElementById("editClienteDireccion").value.trim(),
        localidad: document.getElementById("editClienteLocalidad").value.trim(),
        telefono: document.getElementById("editClienteTelefono").value.trim(),
        email: document.getElementById("editClienteEmail").value.trim(),
        id_condicion_iva: cliente?.id_condicion_iva || 5
    };
    
    if (!datos.razon_social) { mostrarToast('Razón Social obligatoria', 'warning'); return; }
    
    try {
        const response = await fetch(API_URL + '/clientes/' + idCliente, {
            method: 'PUT',
            headers: { 'Authorization': 'Bearer ' + localStorage.getItem('authToken'), 'Content-Type': 'application/json' },
            body: JSON.stringify(datos)
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Error al actualizar');
        
        // Actualizar caché local
        const idx = clientes.findIndex(c => c.id_cliente === parseInt(idCliente));
        if (idx >= 0) { Object.assign(clientes[idx], datos); }
        
        // Si es el cliente actual, actualizar display
        if (clienteActual && clienteActual.id_cliente === parseInt(idCliente)) {
            clienteActual = clientes[idx];
            document.getElementById('clienteNombre').value = datos.razon_social;
        }
        
        const modal = bootstrap.Modal.getInstance(document.getElementById('modalEditarCliente'));
        if (modal) modal.hide();
        
        mostrarClientesFiltrados(clientes);
        mostrarToast('✅ Cliente actualizado', 'success');
    } catch (error) {
        mostrarToast('Error: ' + error.message, 'error');
    }
}

window.editarCliente = editarCliente;
window.guardarEdicionCliente = guardarEdicionCliente;

// ═══════════════════════════════════════════════════════════════════════════════
// EDITAR CLIENTE
// ═══════════════════════════════════════════════════════════════════════════════
async function editarCliente(idCliente) {
    const cliente = clientes.find(c => c.id_cliente === idCliente);
    if (!cliente) { mostrarToast('Cliente no encontrado', 'error'); return; }
    
    document.getElementById('editClienteId').value = cliente.id_cliente;
    document.getElementById('editClienteCuit').value = cliente.cuit_cuil || '';
    document.getElementById('editClienteNombre').value = cliente.razon_social || '';
    document.getElementById('editClienteFantasia').value = cliente.nombre_fantasia || '';
    document.getElementById('editClienteDireccion').value = cliente.domicilio || '';
    document.getElementById('editClienteLocalidad').value = cliente.localidad || '';
    document.getElementById('editClienteTelefono').value = cliente.telefono || '';
    document.getElementById('editClienteEmail').value = cliente.email || '';
    
    const modalEditar = new bootstrap.Modal(document.getElementById('modalEditarCliente'));
    modalEditar.show();
}

