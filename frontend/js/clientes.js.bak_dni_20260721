async function cambiarEstadoMasivo(activo) {
    if (clientesSeleccionados.size === 0) return;

    try {
        const response = await fetch(`${API_URL}/api/clientes/masivo/cambiar-estado`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('authToken')}`
            },
            body: JSON.stringify({
                ids: Array.from(clientesSeleccionados),
                activo
            })
        });

        const result = await response.json();

        if (!response.ok) throw new Error(result.error);

        mostrarToast('Éxito', result.message, 'success');
        clientesSeleccionados.clear();
        actualizarBarraAcciones();
        buscarClientes();

    } catch (error) {
        console.error('Error en acción masiva:', error);
        mostrarToast('Error', error.message, 'danger');
    }
}

async function asignarListaMasivo(idLista) {
    if (clientesSeleccionados.size === 0) return;

    try {
        const response = await fetch(`${API_URL}/api/clientes/masivo/asignar-lista`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('authToken')}`
            },
            body: JSON.stringify({
                ids: Array.from(clientesSeleccionados),
                id_lista_precio: idLista
            })
        });

        const result = await response.json();

        if (!response.ok) throw new Error(result.error);

        mostrarToast('Éxito', result.message, 'success');
        clientesSeleccionados.clear();
        actualizarBarraAcciones();
        buscarClientes();

    } catch (error) {
        console.error('Error asignando lista:', error);
        mostrarToast('Error', error.message, 'danger');
    }
}

function abrirModalDescuento() {
    if (clientesSeleccionados.size === 0) return;
    document.getElementById('cantDescuento').textContent = clientesSeleccionados.size;
    document.getElementById('descuentoMasivo').value = 0;
