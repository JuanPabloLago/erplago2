// IMPORTACIÓN EXCEL
// ============================================================================

let datosPreview = [];

function configurarImportacion() {
    // Abrir modal
    document.getElementById('btnImportar').addEventListener('click', () => {
        document.getElementById('importPaso1').style.display = 'block';
        document.getElementById('importPaso2').style.display = 'none';
        document.getElementById('importPaso3').style.display = 'none';
        document.getElementById('archivoImportar').value = '';
        new bootstrap.Modal(document.getElementById('modalImportar')).show();
    });

    // Descargar plantilla
    document.getElementById('btnDescargarPlantilla').addEventListener('click', async (e) => {
        e.preventDefault();
        try {
            const response = await fetch(`${API_URL}/api/clientes/import/plantilla`, {
                headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` }
            });
            const blob = await response.blob();
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'plantilla_clientes.xlsx';
            a.click();
            URL.revokeObjectURL(url);
        } catch (error) {
            mostrarToast('Error', 'No se pudo descargar la plantilla', 'danger');
        }
    });

    // Analizar archivo
    document.getElementById('btnAnalizarArchivo').addEventListener('click', analizarArchivo);
    
    // Volver al paso 1
    document.getElementById('btnVolverPaso1').addEventListener('click', () => {
        document.getElementById('importPaso1').style.display = 'block';
        document.getElementById('importPaso2').style.display = 'none';
    });

    // Ejecutar importación
    document.getElementById('btnEjecutarImport').addEventListener('click', ejecutarImportacion);
}

async function analizarArchivo() {
    const input = document.getElementById('archivoImportar');
    if (!input.files[0]) {
        mostrarToast('Error', 'Seleccioná un archivo', 'warning');
        return;
    }

    const formData = new FormData();
    formData.append('archivo', input.files[0]);

    try {
        mostrarToast('Info', 'Analizando archivo...', 'info');
        
        const response = await fetch(`${API_URL}/api/clientes/import/preview`, {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${localStorage.getItem('authToken')}` },
            body: formData
        });

        const result = await response.json();
        if (!response.ok) throw new Error(result.error);

        datosPreview = result.registros;
        mostrarPreview(result);

    } catch (error) {
        console.error('Error:', error);
        mostrarToast('Error', error.message, 'danger');
    }
}

function mostrarPreview(result) {
    // Mostrar resumen
    const resumen = document.getElementById('importResumen');
    resumen.innerHTML = `
        <strong>Resumen:</strong> ${result.resumen.total} registros encontrados<br>
        <span class="text-success">✓ ${result.resumen.validos} válidos</span> |
        <span class="text-danger">✗ ${result.resumen.con_errores} con errores</span> |
        <span class="text-warning">⚠ ${result.resumen.con_advertencias} con advertencias</span>
    `;

    // Renderizar tabla
    const thead = document.querySelector('#tablaPreview thead');
    const tbody = document.querySelector('#tablaPreview tbody');
    
    thead.innerHTML = `<tr>
        <th>Fila</th><th>Estado</th><th>Razón Social</th><th>CUIT</th><th>Cond. IVA</th><th>Problemas</th>
    </tr>`;
    
    tbody.innerHTML = datosPreview.map(r => {
        const estado = r.errores.length > 0 ? '❌' : (r.advertencias.length > 0 ? '⚠️' : '✅');
        const clase = r.errores.length > 0 ? 'table-danger' : (r.advertencias.length > 0 ? 'table-warning' : '');
        const problemas = [...r.errores, ...r.advertencias].join('; ');
        return `<tr class="${clase}">
            <td>${r.fila}</td>
            <td>${estado}</td>
            <td>${r.datos.razon_social || '-'}</td>
            <td>${r.datos.cuit_cuil || '-'}</td>
            <td>${r.datos.id_condicion_iva || '-'}</td>
            <td><small>${problemas || '-'}</small></td>
        </tr>`;
    }).join('');

    // Cambiar a paso 2
    document.getElementById('importPaso1').style.display = 'none';
    document.getElementById('importPaso2').style.display = 'block';
}

async function ejecutarImportacion() {
    const importarConAdvertencias = document.getElementById('chkImportarConAdvertencias').checked;
    const ignorarDuplicados = document.getElementById('chkIgnorarDuplicados').checked;

    try {
        mostrarToast('Info', 'Importando clientes...', 'info');
        
        const response = await fetch(`${API_URL}/api/clientes/import/ejecutar`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('authToken')}`
            },
            body: JSON.stringify({
                registros: datosPreview,
                importar_con_advertencias: importarConAdvertencias,
                ignorar_duplicados: ignorarDuplicados
            })
        });

        const result = await response.json();
        if (!response.ok) throw new Error(result.error);

        // Mostrar resultado
        const divResultado = document.getElementById('importResultado');
        divResultado.className = 'alert alert-success';
        divResultado.innerHTML = `
            <h5>✅ Importación completada</h5>
            <p><strong>${result.importados}</strong> clientes importados correctamente</p>
            ${result.omitidos > 0 ? `<p><strong>${result.omitidos}</strong> registros omitidos</p>` : ''}
        `;

        document.getElementById('importPaso2').style.display = 'none';
        document.getElementById('importPaso3').style.display = 'block';

        // Recargar tabla
        buscarClientes();

    } catch (error) {
        console.error('Error:', error);
        mostrarToast('Error', error.message, 'danger');
    }
}

// Inicializar importación cuando cargue la página
document.addEventListener('DOMContentLoaded', () => {
    setTimeout(configurarImportacion, 100);
});
