}

// ============================================================================
// EXPORTACIÓN
// ============================================================================

async function exportarSeleccion() {
    if (clientesSeleccionados.size === 0) return;
    await exportar(Array.from(clientesSeleccionados));
}

async function exportarTodos() {
    await exportar([]);
}

async function exportar(ids) {
    try {
        mostrarToast('Info', 'Generando archivo Excel...', 'info');
        
        const response = await fetch(`${API_URL}/api/clientes/exportar/excel-file`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': `Bearer ${localStorage.getItem('authToken')}`
            },
            body: JSON.stringify({ ids: ids.length > 0 ? ids : null })
        });

        if (!response.ok) {
            const err = await response.json();
            throw new Error(err.error || 'Error al exportar');
        }

        // Descargar el archivo Excel
        const blob = await response.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `clientes_${new Date().toISOString().split('T')[0]}.xlsx`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        
        mostrarToast('Éxito', 'Archivo Excel descargado', 'success');
    } catch (error) {
        console.error('Error exportando:', error);
        mostrarToast('Error', error.message, 'danger');
    }
}


// ============================================================================
// UTILIDADES
// ============================================================================

function poblarSelect(id, datos, valueKey, textKey, agregarTodos = false) {
    const select = document.getElementById(id);
    const valorActual = select.value;
    
    select.innerHTML = agregarTodos 
        ? `<option value="todos">Todos</option>` 
        : '';
    
    datos.forEach(item => {
        select.innerHTML += `<option value="${item[valueKey]}">${item[textKey]}</option>`;
    });

    if (valorActual) select.value = valorActual;
}

function poblarSelectSimple(id, valores, agregarTodos = false) {
    const select = document.getElementById(id);
    const valorActual = select.value;
    
    select.innerHTML = agregarTodos 
        ? `<option value="todos">Todas las provincias</option>` 
        : '';
    
    valores.forEach(v => {
        select.innerHTML += `<option value="${v}">${v}</option>`;
    });

    if (valorActual) select.value = valorActual;
}

function limpiarFormulario() {
    document.getElementById('formCliente').reset();
    document.getElementById('clienteId').value = '';
    document.getElementById('cuitFeedback').innerHTML = '';
    document.getElementById('condicionIVA').value = '4'; // Default: Consumidor Final
}

function formatearCUIT(valor) {
    // Remover todo excepto números
    let nums = valor.replace(/\D/g, '');
    
    // Limitar a 11 dígitos
    nums = nums.substring(0, 11);
    
    // Formatear XX-XXXXXXXX-X
    if (nums.length > 2) {
        nums = nums.substring(0, 2) + '-' + nums.substring(2);
    }
    if (nums.length > 11) {
        nums = nums.substring(0, 11) + '-' + nums.substring(11);
    }
    
    return nums;
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function mostrarToast(titulo, mensaje, tipo = 'info') {
    const toastEl = document.getElementById('toastNotificacion');
    const toastHeader = toastEl.querySelector('.toast-header');
    
    // Cambiar color según tipo
    toastHeader.className = 'toast-header';
    if (tipo === 'success') toastHeader.classList.add('bg-success', 'text-white');
    else if (tipo === 'danger') toastHeader.classList.add('bg-danger', 'text-white');
    else if (tipo === 'warning') toastHeader.classList.add('bg-warning');
    
    document.getElementById('toastTitulo').textContent = titulo;
    document.getElementById('toastMensaje').textContent = mensaje;
    
    toast.show();
}

