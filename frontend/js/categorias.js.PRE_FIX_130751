(function() {
    const API = (window.CONFIG && window.CONFIG.API_BASE_URL) || '';
    const state = { categorias: [], categoriaActiva: null, subcategorias: [] };

    async function api(path, opts) {
        opts = opts || {};
        const token = localStorage.getItem('token');
        const res = await fetch(API + path, Object.assign({}, opts, {
            headers: Object.assign({ 'Content-Type':'application/json', 'Authorization':'Bearer '+token }, opts.headers||{}),
        }));
        const data = await res.json().catch(()=>({}));
        if (!res.ok) throw new Error(data.error || ('HTTP '+res.status));
        return data;
    }

    async function cargarTodo() {
        try {
            const data = await api('/api/categorias');
            const todas = data.categorias || data || [];
            state.categorias = todas.filter(c => !c.id_categoria_padre);
            renderCategorias();
        } catch (err) { alert('Error: '+err.message); }
    }

    function renderCategorias() {
        const cont = document.getElementById('listaCategorias');
        const filtro = (document.getElementById('buscarCat').value||'').toLowerCase();
        const items = state.categorias.filter(c => c.nombre.toLowerCase().includes(filtro));
        document.getElementById('contCategorias').textContent = items.length;
        cont.innerHTML = items.length === 0
          ? '<div class="text-muted text-center py-3 small">Sin categorías</div>'
          : items.map(c => `
            <div class="lista-item ${state.categoriaActiva===c.id_categoria?'activa':''}">
              <i class="bi bi-folder"></i>
              <span class="flex-grow-1" onclick="seleccionarCategoria(${c.id_categoria})">${esc(c.nombre)}</span>
              <button class="accion-icon" onclick="event.stopPropagation();editarCategoria(${c.id_categoria})"><i class="bi bi-pencil"></i></button>
              <button class="accion-icon" onclick="event.stopPropagation();pedirEliminar(${c.id_categoria},'${escJs(c.nombre)}')"><i class="bi bi-trash"></i></button>
            </div>`).join('');
    }

    async function seleccionarCategoria(id) {
        state.categoriaActiva = id;
        const cat = state.categorias.find(c => c.id_categoria === id);
        document.getElementById('tituloSubcat').textContent = cat ? cat.nombre : 'Seleccioná';
        document.getElementById('btnNuevaSubcat').disabled = false;
        renderCategorias();
        try {
            const data = await api('/api/categorias/'+id+'/subcategorias');
            state.subcategorias = data.subcategorias || data || [];
            renderSubcategorias();
        } catch (err) {
            document.getElementById('listaSubcategorias').innerHTML = '<div class="text-danger p-3">'+err.message+'</div>';
        }
    }
    window.seleccionarCategoria = seleccionarCategoria;

    function renderSubcategorias() {
        const cont = document.getElementById('listaSubcategorias');
        document.getElementById('contSubcat').textContent = state.subcategorias.length;
        cont.innerHTML = state.subcategorias.length === 0
          ? '<div class="text-muted text-center py-5 small">Sin subcategorías.</div>'
          : state.subcategorias.map(s => `
            <div class="lista-item">
              <i class="bi bi-folder2"></i>
              <span class="flex-grow-1">${esc(s.nombre)}</span>
              <button class="accion-icon" onclick="editarCategoria(${s.id_categoria})"><i class="bi bi-pencil"></i></button>
              <button class="accion-icon" onclick="pedirEliminar(${s.id_categoria},'${escJs(s.nombre)}')"><i class="bi bi-trash"></i></button>
            </div>`).join('');
    }

    function abrirModal(titulo, id, padre, nombre) {
        document.getElementById('modalCatTitulo').textContent = titulo;
        document.getElementById('modalCatId').value = id || '';
        document.getElementById('modalCatPadre').value = padre || '';
        document.getElementById('modalCatNombre').value = nombre || '';
        document.getElementById('modalCatError').textContent = '';
        new bootstrap.Modal(document.getElementById('modalCat')).show();
        setTimeout(()=>document.getElementById('modalCatNombre').focus(), 200);
    }
    window.abrirNuevaCategoria = () => abrirModal('Nueva categoría', '', '', '');
    window.abrirNuevaSubcategoria = () => state.categoriaActiva && abrirModal('Nueva subcategoría', '', state.categoriaActiva, '');
    window.editarCategoria = (id) => {
        const c = state.categorias.find(x => x.id_categoria === id) || state.subcategorias.find(x => x.id_categoria === id);
        if (c) abrirModal('Renombrar', c.id_categoria, c.id_categoria_padre||'', c.nombre);
    };

    window.guardarCategoria = async () => {
        const id = document.getElementById('modalCatId').value;
        const padre = document.getElementById('modalCatPadre').value;
        const nombre = document.getElementById('modalCatNombre').value.trim();
        if (!nombre) { document.getElementById('modalCatError').textContent = 'Nombre obligatorio'; return; }
        try {
            if (id) await api('/api/categorias/'+id, { method:'PUT', body: JSON.stringify({ nombre }) });
            else    await api('/api/categorias',      { method:'POST', body: JSON.stringify({ nombre, id_categoria_padre: padre?parseInt(padre,10):null }) });
            bootstrap.Modal.getInstance(document.getElementById('modalCat')).hide();
            await cargarTodo();
            if (state.categoriaActiva) await seleccionarCategoria(state.categoriaActiva);
        } catch (err) { document.getElementById('modalCatError').textContent = err.message; }
    };

    window.pedirEliminar = async (id, nombre) => {
        document.getElementById('elimId').value = id;
        document.getElementById('elimNombre').textContent = nombre;
        document.getElementById('elimError').textContent = '';
        let cant = 0;
        try { cant = (await api('/api/categorias/'+id+'/productos-count')).cant || 0; } catch(e) {}
        if (cant > 0) {
            document.getElementById('elimConProductos').style.display = 'block';
            document.getElementById('elimSinProductos').style.display = 'none';
            document.getElementById('elimCant').textContent = cant;
            const opts = [...state.categorias.map(c=>({id:c.id_categoria,label:c.nombre})),
                          ...state.subcategorias.map(s=>({id:s.id_categoria,label:'  └ '+s.nombre}))].filter(o=>o.id!==id);
            document.getElementById('elimDestino').innerHTML = opts.map(o=>`<option value="${o.id}">${esc(o.label)}</option>`).join('');
        } else {
            document.getElementById('elimConProductos').style.display = 'none';
            document.getElementById('elimSinProductos').style.display = 'block';
        }
        new bootstrap.Modal(document.getElementById('modalEliminar')).show();
    };

    window.confirmarEliminar = async () => {
        const id = parseInt(document.getElementById('elimId').value, 10);
        let url = '/api/categorias/'+id;
        const opc = document.querySelector('input[name="elimOpc"]:checked');
        if (opc && opc.value === 'mover') url += '?reasignar_a='+document.getElementById('elimDestino').value;
        try {
            await api(url, { method:'DELETE' });
            bootstrap.Modal.getInstance(document.getElementById('modalEliminar')).hide();
            state.categoriaActiva = null;
            document.getElementById('tituloSubcat').textContent = 'Seleccioná una categoría';
            document.getElementById('btnNuevaSubcat').disabled = true;
            document.getElementById('listaSubcategorias').innerHTML = '<div class="text-muted text-center py-5">Elegí una categoría a la izquierda</div>';
            await cargarTodo();
        } catch (err) { document.getElementById('elimError').textContent = err.message; }
    };

    function esc(s) { return String(s||'').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
    function escJs(s) { return String(s||'').replace(/'/g, "\\'"); }

    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('buscarCat').addEventListener('input', renderCategorias);
        cargarTodo();
    });
})();
