'use strict';

const API_BASE = window.CONFIG?.API_BASE_URL || '';
let itemCount = 0;
let tipoNotaActual = '';
let paginaActual = 0;
const LIMIT = 50;

// ─── TOKEN ──────────────────────────────────────────────────────
function getToken() {
    return localStorage.getItem('authToken');
}

function getHeaders(json = false) {
    const h = { 'Authorization': `Bearer ${getToken()}` };
    if (json) h['Content-Type'] = 'application/json';
    return h;
}

// ─── INICIALIZACIÓN ─────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    verificarAutenticacion();
    cargarNotas();
    configurarFiltros();
    configurarTeclado();
});

function configurarFiltros() {
    const filtroTipo = document.getElementById('filtroTipo');
    const filtroCliente = document.getElementById('filtroCliente');

    if (filtroTipo) {
        filtroTipo.addEventListener('change', () => { paginaActual = 0; cargarNotas(); });
    }
    if (filtroCliente) {
        let timer;
        filtroCliente.addEventListener('input', () => {
            clearTimeout(timer);
            timer = setTimeout(() => { paginaActual = 0; cargarNotas(); }, 400);
        });
        filtroCliente.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); paginaActual = 0; cargarNotas(); }
        });
    }
}

function configurarTeclado() {
    document.addEventListener('keydown', (e) => {
        if (e.key === 'F5') { e.preventDefault(); cargarNotas(); }
        if (e.key === 'Escape') {
            const modal = bootstrap.Modal.getInstance(document.getElementById('modalNota'));
            if (modal) modal.hide();
            const det = bootstrap.Modal.getInstance(document.getElementById('modalDetalle'));
            if (det) det.hide();
        }
    });
}

// ─── CARGAR NOTAS (LISTADO) ─────────────────────────────────────
async function cargarNotas() {
    const tbody = document.getElementById('tablaNotas');
    tbody.innerHTML = '<tr><td colspan="8" class="text-center"><i class="bi bi-hourglass-split"></i> Cargando...</td></tr>';

    try {
        const tipo = document.getElementById('filtroTipo')?.value || '';
        const busqueda = document.getElementById('filtroCliente')?.value || '';

        const params = new URLSearchParams({ limit: LIMIT, offset: paginaActual * LIMIT });
        if (tipo) params.append('tipo', tipo);
        if (busqueda) params.append('busqueda', busqueda);

        const response = await fetch(`${API_BASE}/notas?${params}`, {
            headers: getHeaders()
        });

        if (!response.ok) {
            const err = await response.json().catch(() => ({}));
            throw new Error(err.error || `HTTP ${response.status}`);
        }

        const result = await response.json();

        // Soportar ambos formatos: array directo o {data, total}
        const notas = Array.isArray(result) ? result : (result.data || []);
        const total = Array.isArray(result) ? result.length : (result.total || 0);

        mostrarNotas(notas, total);
    } catch (error) {
        console.error('Error al cargar notas:', error);
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-danger"><i class="bi bi-exclamation-triangle"></i> Error al cargar notas: ' + error.message + '</td></tr>';
    }
}

// ─── MOSTRAR NOTAS ──────────────────────────────────────────────
function mostrarNotas(notas, total) {
    const tbody = document.getElementById('tablaNotas');

    // Limpiar paginacion anterior
    const existingPag = document.getElementById('paginacionNotas');
    if (existingPag) existingPag.remove();

    if (!notas || notas.length === 0) {
        tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted"><i class="bi bi-inbox"></i> No hay notas registradas</td></tr>';
        return;
    }

    tbody.innerHTML = notas.map(n => {
        const fecha = n.fecha_emision ? new Date(n.fecha_emision).toLocaleDateString('es-AR') : '-';
        const esCredito = (n.tipo_nota === 'credito' || n.tipo_nota === 'NC');
        const tipoBadge = esCredito
            ? '<span class="badge bg-success badge-tipo">CRÉDITO</span>'
            : '<span class="badge bg-warning badge-tipo">DÉBITO</span>';
        const claseRow = esCredito ? 'nota-credito' : 'nota-debito';
        const cliente = n.cliente || n.cliente_nombre || 'Sin cliente';
        const facturaOrigen = n.factura_origen || n.factura_numero || '-';
        const motivo = n.motivo || n.observaciones || '-';
        const totalStr = parseFloat(n.total || 0).toFixed(2);
        const idNota = n.id_nota || n.id_nota_credito_debito;

        return '<tr class="' + claseRow + '">' +
            '<td>' + tipoBadge + '</td>' +
            '<td><strong>' + (n.numero_completo || '-') + '</strong></td>' +
            '<td>' + fecha + '</td>' +
            '<td>' + cliente + '</td>' +
            '<td>' + facturaOrigen + '</td>' +
            '<td title="' + motivo + '">' + (motivo.length > 50 ? motivo.substring(0, 50) + '...' : motivo) + '</td>' +
            '<td class="text-end"><strong>$' + totalStr + '</strong></td>' +
            '<td>' +
                '<button class="btn btn-sm btn-info btn-action" onclick="verDetalle(' + idNota + ')" title="Ver detalle"><i class="bi bi-eye"></i></button> ' +
                '<button class="btn btn-sm btn-outline-danger btn-action" onclick="anularNota(' + idNota + ')" title="Anular"><i class="bi bi-x-circle"></i></button>' +
            '</td></tr>';
    }).join('');

    // Paginación
    if (total > LIMIT) {
        const totalPages = Math.ceil(total / LIMIT);
        let pagHTML = '<div class="d-flex justify-content-between align-items-center mt-2" id="paginacionNotas">' +
            '<small class="text-muted">Mostrando ' + (paginaActual * LIMIT + 1) + '-' + Math.min((paginaActual + 1) * LIMIT, total) + ' de ' + total + '</small><div>';
        if (paginaActual > 0) pagHTML += '<button class="btn btn-sm btn-outline-primary me-1" onclick="cambiarPagina(' + (paginaActual - 1) + ')"><i class="bi bi-chevron-left"></i> Anterior</button>';
        if (paginaActual < totalPages - 1) pagHTML += '<button class="btn btn-sm btn-outline-primary" onclick="cambiarPagina(' + (paginaActual + 1) + ')">Siguiente <i class="bi bi-chevron-right"></i></button>';
        pagHTML += '</div></div>';
        tbody.parentElement.insertAdjacentHTML('afterend', pagHTML);
    }
}

function cambiarPagina(pag) {
    paginaActual = pag;
    cargarNotas();
}

// ─── BÚSQUEDA LAZY CLIENTES ────────────────────────────────────
let clienteTimer;
let clienteSeleccionado = null;

function configurarBusquedaCliente() {
    const input = document.getElementById('id_cliente_busqueda');
    const dropdown = document.getElementById('clienteDropdown');
    if (!input) return;

    input.addEventListener('input', () => {
        clearTimeout(clienteTimer);
        clienteSeleccionado = null;
        const q = input.value.trim();
        if (q.length < 2) { dropdown.innerHTML = ''; dropdown.classList.remove('show'); return; }
        clienteTimer = setTimeout(() => buscarClientes(q), 300);
    });

    input.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { dropdown.classList.remove('show'); }
    });

    document.addEventListener('click', (e) => {
        if (!input.contains(e.target) && !dropdown.contains(e.target)) {
            dropdown.classList.remove('show');
        }
    });
}

async function buscarClientes(q) {
    const dropdown = document.getElementById('clienteDropdown');
    try {
        const res = await fetch(API_BASE + '/clientes/buscar?q=' + encodeURIComponent(q) + '&limit=15&activo=true', {
            headers: getHeaders()
        });
        if (!res.ok) return;
        const data = await res.json();
        const clientes = data.clientes || data || [];

        if (clientes.length === 0) {
            dropdown.innerHTML = '<div class="dropdown-item text-muted">Sin resultados</div>';
            dropdown.classList.add('show');
            return;
        }

        dropdown.innerHTML = clientes.map(c => {
            const nombre = (c.razon_social || '').replace(/'/g, "\\'");
            return '<a class="dropdown-item" href="#" onclick="seleccionarCliente(' + c.id_cliente + ', \'' + nombre + '\'); return false;">' +
                '<strong>' + c.razon_social + '</strong>' +
                (c.cuit_cuil ? ' <small class="text-muted ms-2">CUIT: ' + c.cuit_cuil + '</small>' : '') +
                '</a>';
        }).join('');
        dropdown.classList.add('show');
    } catch (err) {
        console.error('Error buscando clientes:', err);
    }
}

function seleccionarCliente(id, nombre) {
    clienteSeleccionado = id;
    const input = document.getElementById('id_cliente_busqueda');
    if (input) input.value = nombre;
    const hidden = document.getElementById('id_cliente');
    if (hidden) hidden.value = id;
    const dropdown = document.getElementById('clienteDropdown');
    if (dropdown) dropdown.classList.remove('show');
    cargarFacturasCliente(id);
}

// ─── FACTURAS DEL CLIENTE ───────────────────────────────────────
async function cargarFacturasCliente(idCliente) {
    const select = document.getElementById('id_factura_origen');
    if (!select) return;
    select.innerHTML = '<option value="">Cargando facturas...</option>';

    try {
        const res = await fetch(API_BASE + '/facturas?id_cliente=' + idCliente + '&limit=100', {
            headers: getHeaders()
        });
        if (!res.ok) throw new Error('Error cargando facturas');
        const data = await res.json();
        const facturas = data.data || data || [];

        select.innerHTML = '<option value="">Sin factura origen</option>';
        facturas.forEach(f => {
            if (f.estado !== 'anulada') {
                const num = f.numero_completo || ('#' + f.id_factura);
                const tot = parseFloat(f.total || 0).toFixed(2);
                select.innerHTML += '<option value="' + f.id_factura + '">' + num + ' - $' + tot + '</option>';
            }
        });
    } catch (err) {
        console.error('Error cargando facturas:', err);
        select.innerHTML = '<option value="">Sin factura origen</option>';
    }
}

// ─── BÚSQUEDA LAZY PRODUCTOS ────────────────────────────────────
const _prodTimers = {};

function buscarProductoDebounce(input, itemId) {
    clearTimeout(_prodTimers[itemId]);
    _prodTimers[itemId] = setTimeout(() => buscarProducto(input, itemId), 300);
}

async function buscarProducto(input, itemId) {
    const q = input.value.trim();
    const dropdown = document.getElementById('prodDropdown-' + itemId);
    if (!dropdown) return;

    if (q.length < 2) { dropdown.innerHTML = ''; dropdown.classList.remove('show'); return; }

    try {
        const res = await fetch(API_BASE + '/productos/buscar?q=' + encodeURIComponent(q) + '&limit=10', {
            headers: getHeaders()
        });
        if (!res.ok) return;
        const data = await res.json();
        const productos = data.productos || data.data || data || [];

        if (productos.length === 0) {
            dropdown.innerHTML = '<div class="dropdown-item text-muted">Sin resultados</div>';
            dropdown.classList.add('show');
            return;
        }

        dropdown.innerHTML = productos.map(p => {
            const precio = parseFloat(p.precio || p.precio_venta || 0).toFixed(2);
            const nombre = (p.nombre || '').replace(/'/g, "\\'");
            return '<a class="dropdown-item" href="#" onclick="seleccionarProducto(' + itemId + ', ' + p.id_producto + ', \'' + nombre + '\', ' + precio + '); return false;">' +
                '<strong>' + (p.codigo || '') + '</strong> ' + p.nombre + ' - $' + precio +
                '</a>';
        }).join('');
        dropdown.classList.add('show');
    } catch (err) {
        console.error('Error buscando productos:', err);
    }
}

function seleccionarProducto(itemId, idProducto, nombre, precio) {
    const row = document.getElementById('item-' + itemId);
    if (!row) return;

    row.querySelector('.descripcion-input').value = nombre;
    row.querySelector('.precio-input').value = precio;
    row.querySelector('.producto-id').value = idProducto;

    const dropdown = document.getElementById('prodDropdown-' + itemId);
    if (dropdown) dropdown.classList.remove('show');

    calcularItem(itemId);
    row.querySelector('.cantidad-input').focus();
    row.querySelector('.cantidad-input').select();
}

// ─── FORMULARIO ─────────────────────────────────────────────────
function mostrarFormulario(tipo) {
    tipoNotaActual = tipo;
    document.getElementById('tipo_nota').value = tipo;

    document.getElementById('formNota').reset();
    document.getElementById('itemsNota').innerHTML = '';
    document.getElementById('id_cliente').value = '';
    clienteSeleccionado = null;
    itemCount = 0;

    const modalHeader = document.getElementById('modalHeader');
    const modalTitle = document.getElementById('modalTitle');

    if (tipo === 'credito') {
        modalHeader.className = 'modal-header bg-success text-white';
        modalTitle.innerHTML = '<i class="bi bi-file-earmark-minus"></i> Nueva Nota de Crédito';
    } else {
        modalHeader.className = 'modal-header bg-warning text-white';
        modalTitle.innerHTML = '<i class="bi bi-file-earmark-plus"></i> Nueva Nota de Débito';
    }

    agregarItem();
    agregarItem();

    const modal = new bootstrap.Modal(document.getElementById('modalNota'));
    modal.show();

    setTimeout(() => {
        configurarBusquedaCliente();
        const busqCliente = document.getElementById('id_cliente_busqueda');
        if (busqCliente) busqCliente.focus();
    }, 300);
}

function agregarItem() {
    itemCount++;
    const id = itemCount;
    const tbody = document.getElementById('itemsNota');

    const row = '<tr id="item-' + id + '">' +
        '<td style="position:relative;">' +
            '<input type="hidden" class="producto-id" value="">' +
            '<input type="text" class="form-control form-control-sm producto-busqueda" placeholder="Buscar producto..." autocomplete="off" oninput="buscarProductoDebounce(this, ' + id + ')" data-item="' + id + '">' +
            '<div class="dropdown-menu w-100" id="prodDropdown-' + id + '" style="max-height:200px;overflow-y:auto;"></div>' +
            '<input type="text" class="form-control form-control-sm mt-1 descripcion-input" placeholder="Descripción del item" data-item="' + id + '">' +
        '</td>' +
        '<td><input type="number" class="form-control form-control-sm cantidad-input" value="1" min="0.01" step="0.01" onchange="calcularItem(' + id + ')" onkeyup="calcularItem(' + id + ')" data-item="' + id + '"></td>' +
        '<td><input type="number" class="form-control form-control-sm precio-input" value="0" min="0" step="0.01" onchange="calcularItem(' + id + ')" onkeyup="calcularItem(' + id + ')" data-item="' + id + '"></td>' +
        '<td><input type="number" class="form-control form-control-sm iva-input" value="21" min="0" max="100" step="0.01" onchange="calcularItem(' + id + ')" onkeyup="calcularItem(' + id + ')" data-item="' + id + '"></td>' +
        '<td><input type="text" class="form-control form-control-sm total-input" readonly value="$0.00" data-item="' + id + '"></td>' +
        '<td><button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarItem(' + id + ')"><i class="bi bi-trash"></i></button></td>' +
    '</tr>';

    tbody.insertAdjacentHTML('beforeend', row);
}

function calcularItem(itemId) {
    const row = document.getElementById('item-' + itemId);
    if (!row) return;

    const cantidad = parseFloat(row.querySelector('.cantidad-input').value) || 0;
    const precio = parseFloat(row.querySelector('.precio-input').value) || 0;
    const iva = parseFloat(row.querySelector('.iva-input').value) || 0;

    const subtotal = cantidad * precio;
    const ivaAmount = subtotal * (iva / 100);
    const total = subtotal + ivaAmount;

    row.querySelector('.total-input').value = '$' + total.toFixed(2);
    calcularTotales();
}

function calcularTotales() {
    let subtotalTotal = 0;
    let ivaTotal = 0;

    document.querySelectorAll('#itemsNota tr').forEach(row => {
        const cantidad = parseFloat(row.querySelector('.cantidad-input')?.value) || 0;
        const precio = parseFloat(row.querySelector('.precio-input')?.value) || 0;
        const iva = parseFloat(row.querySelector('.iva-input')?.value) || 0;

        const subtotal = cantidad * precio;
        subtotalTotal += subtotal;
        ivaTotal += subtotal * (iva / 100);
    });

    const el = function(id, val) { const e = document.getElementById(id); if (e) e.textContent = val; };
    el('subtotalNota', '$' + subtotalTotal.toFixed(2));
    el('ivaNota', '$' + ivaTotal.toFixed(2));
    el('totalNota', '$' + (subtotalTotal + ivaTotal).toFixed(2));
}

function eliminarItem(itemId) {
    const row = document.getElementById('item-' + itemId);
    if (row) { row.remove(); calcularTotales(); }
}

// ─── GUARDAR NOTA ───────────────────────────────────────────────
async function guardarNota() {
    const tipo_nota = document.getElementById('tipo_nota').value;
    const id_cliente = document.getElementById('id_cliente').value;
    const id_factura_origen = document.getElementById('id_factura_origen').value;
    const codigo_tipo = document.getElementById('codigo_tipo').value;
    const motivo = document.getElementById('motivo').value;
    const observaciones = document.getElementById('observaciones').value;

    if (!codigo_tipo || !motivo) {
        alert('Complete el código tipo y el motivo');
        return;
    }

    const items = [];
    document.querySelectorAll('#itemsNota tr').forEach(row => {
        const id_producto = row.querySelector('.producto-id')?.value || null;
        const descripcion = row.querySelector('.descripcion-input')?.value;
        const cantidad = parseFloat(row.querySelector('.cantidad-input')?.value) || 0;
        const precio = parseFloat(row.querySelector('.precio-input')?.value) || 0;
        const iva = parseFloat(row.querySelector('.iva-input')?.value) || 21;

        if (cantidad > 0 && precio > 0 && descripcion) {
            items.push({
                id_producto: id_producto || null,
                descripcion: descripcion,
                cantidad: cantidad,
                precio_unitario: precio,
                iva_porcentaje: iva
            });
        }
    });

    if (items.length === 0) {
        alert('Debe agregar al menos un item con cantidad, precio y descripción');
        return;
    }

    if (!confirm('Confirma crear la Nota de ' + (tipo_nota === 'credito' ? 'Crédito' : 'Débito') + '?')) return;

    const btnGuardar = document.querySelector('#modalNota .btn-danger');
    if (btnGuardar) { btnGuardar.disabled = true; btnGuardar.innerHTML = '<i class="bi bi-hourglass-split"></i> Guardando...'; }

    try {
        const response = await fetch(API_BASE + '/notas', {
            method: 'POST',
            headers: getHeaders(true),
            body: JSON.stringify({
                tipo_nota: tipo_nota,
                codigo_tipo: codigo_tipo,
                id_cliente: id_cliente || null,
                id_factura_origen: id_factura_origen || null,
                motivo: motivo,
                observaciones: observaciones,
                items: items
            })
        });

        if (response.ok) {
            const tipoTexto = tipo_nota === 'credito' ? 'Crédito' : 'Débito';
            alert('Nota de ' + tipoTexto + ' creada exitosamente');
            bootstrap.Modal.getInstance(document.getElementById('modalNota')).hide();
            cargarNotas();
        } else {
            const error = await response.json().catch(() => ({}));
            alert('Error: ' + (error.error || error.detalle || 'Error desconocido'));
        }
    } catch (error) {
        console.error('Error guardando nota:', error);
        alert('Error de conexión al guardar nota');
    } finally {
        if (btnGuardar) { btnGuardar.disabled = false; btnGuardar.innerHTML = '<i class="bi bi-save"></i> Guardar Nota'; }
    }
}

// ─── VER DETALLE ────────────────────────────────────────────────
async function verDetalle(id) {
    if (!id) return;
    try {
        const response = await fetch(API_BASE + '/notas/' + id, {
            headers: getHeaders()
        });

        if (!response.ok) throw new Error('Error al cargar detalle');
        const nota = await response.json();
        mostrarDetalleModal(nota);
    } catch (error) {
        console.error('Error:', error);
        alert('Error al cargar detalle de la nota');
    }
}

function mostrarDetalleModal(n) {
    const fecha = n.fecha_emision ? new Date(n.fecha_emision).toLocaleDateString('es-AR') : '-';
    const esCredito = (n.tipo_nota === 'credito' || n.tipo_nota === 'NC');
    const tipoTexto = esCredito ? 'CRÉDITO' : 'DÉBITO';
    const bgColor = esCredito ? 'bg-success' : 'bg-warning';
    const cliente = n.cliente || n.cliente_nombre || 'Sin cliente';

    const items = n.items || [];
    var itemsHTML;
    if (items.length > 0) {
        itemsHTML = items.map(function(item) {
            return '<tr>' +
                '<td>' + (item.descripcion || item.producto_nombre || '-') + '</td>' +
                '<td class="text-center">' + item.cantidad + '</td>' +
                '<td class="text-end">$' + parseFloat(item.precio_unitario || 0).toFixed(2) + '</td>' +
                '<td class="text-center">' + (item.iva_porcentaje || 21) + '%</td>' +
                '<td class="text-end"><strong>$' + parseFloat(item.total || 0).toFixed(2) + '</strong></td>' +
            '</tr>';
        }).join('');
    } else {
        itemsHTML = '<tr><td colspan="5" class="text-center text-muted">Sin items</td></tr>';
    }

    var totalStr = parseFloat(n.total || 0).toFixed(2);

    var modalHTML = '<div class="modal fade" id="modalDetalle" tabindex="-1">' +
        '<div class="modal-dialog modal-lg"><div class="modal-content">' +
        '<div class="modal-header ' + bgColor + ' text-white">' +
            '<h5 class="modal-title">Nota de ' + tipoTexto + ' ' + (n.numero_completo || '') + '</h5>' +
            '<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>' +
        '</div>' +
        '<div class="modal-body">' +
            '<div class="row mb-3">' +
                '<div class="col-md-6"><strong>Cliente:</strong> ' + cliente + '</div>' +
                '<div class="col-md-3"><strong>Fecha:</strong> ' + fecha + '</div>' +
                '<div class="col-md-3"><strong>Estado:</strong> ' + (n.estado || '-') + '</div>' +
            '</div>' +
            (n.motivo ? '<div class="mb-3"><strong>Motivo:</strong> ' + n.motivo + '</div>' : '') +
            '<table class="table table-sm table-bordered"><thead class="table-light">' +
                '<tr><th>Producto</th><th class="text-center" width="10%">Cant.</th><th class="text-end" width="15%">P.Unit.</th><th class="text-center" width="10%">IVA%</th><th class="text-end" width="15%">Total</th></tr>' +
            '</thead><tbody>' + itemsHTML + '</tbody></table>' +
            '<div class="text-end"><h5 class="mt-2">Total: <strong>$' + totalStr + '</strong></h5></div>' +
            (n.observaciones ? '<p class="mt-2 text-muted"><strong>Obs:</strong> ' + n.observaciones + '</p>' : '') +
        '</div>' +
        '<div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button></div>' +
        '</div></div></div>';

    var existing = document.getElementById('modalDetalle');
    if (existing) existing.remove();

    document.body.insertAdjacentHTML('beforeend', modalHTML);
    var modal = new bootstrap.Modal(document.getElementById('modalDetalle'));
    modal.show();

    document.getElementById('modalDetalle').addEventListener('hidden.bs.modal', function() {
        this.remove();
    });
}

// ─── ANULAR NOTA ────────────────────────────────────────────────
async function anularNota(id) {
    if (!id) return;
    if (!confirm('Esta seguro de ANULAR esta nota? Se revertiran los movimientos en cuenta corriente.')) return;

    try {
        const response = await fetch(API_BASE + '/notas/' + id, {
            method: 'DELETE',
            headers: getHeaders()
        });

        if (response.ok) {
            alert('Nota anulada exitosamente');
            cargarNotas();
        } else {
            const error = await response.json().catch(() => ({}));
            alert('Error: ' + (error.error || 'No se pudo anular'));
        }
    } catch (error) {
        console.error('Error anulando:', error);
        alert('Error de conexión al anular nota');
    }
}
