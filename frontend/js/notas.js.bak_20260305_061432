'use strict';
// =============================================================================
//   NOTAS.JS - ERP LAGO  — NC/ND con 3 flujos: Factura / Presupuesto / Manual
// =============================================================================

const API_BASE = window.CONFIG?.API_BASE_URL || '';

// ─── Estado global ────────────────────────────────────────────────────────────
let paginaActual   = 0;
const LIMIT        = 50;
let buscadorFiltro = null;
let buscadorModal  = null;

// Estado del formulario
const formState = {
    tipo:                 '',   // 'credito' | 'debito'
    origen:               '',   // 'factura' | 'presupuesto' | 'manual'
    id_cliente:           null,
    letra:                '',
    punto_venta:          null,
    id_factura_origen:    null,
    id_presupuesto_origen:null,
    requiere_afip:        false,
    itemCount:            0,
};

// ─── Auth ─────────────────────────────────────────────────────────────────────
function getToken()         { return localStorage.getItem('authToken'); }
function getHeaders(json=false) {
    const h = { Authorization: `Bearer ${getToken()}` };
    if (json) h['Content-Type'] = 'application/json';
    return h;
}

// ─── INIT ─────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    verificarAutenticacion?.();

    // Buscador de clientes para filtro del listado
    buscadorFiltro = new BuscadorClientes({
        container:   '#buscadorClienteFiltro',
        placeholder: 'F3 · Filtrar por cliente...',
        showSaldo:   true,
        onSelect: () => { paginaActual = 0; cargarNotas(); },
        onClear:  () => { paginaActual = 0; cargarNotas(); },
    });

    // Filtros
    document.getElementById('filtroTipo')?.addEventListener('change', () => { paginaActual = 0; cargarNotas(); });

    let timerBusqueda;
    const filtroTexto = document.getElementById('filtroTexto');
    if (filtroTexto) {
        filtroTexto.addEventListener('input', () => {
            clearTimeout(timerBusqueda);
            timerBusqueda = setTimeout(() => { paginaActual = 0; cargarNotas(); }, 400);
        });
        filtroTexto.addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); paginaActual = 0; cargarNotas(); }
        });
    }

    // Atajos
    AtajosGlobales.registrar('guardar',    () => { if (document.getElementById('modalNota')?.classList.contains('show')) guardarNota(); });
    AtajosGlobales.registrar('actualizar', () => cargarNotas());
    AtajosGlobales.registrar('nuevo',      () => abrirSelector());
    AtajosGlobales.registrar('cerrar', () => {
        ['modalNota','modalDetalle','modalSelector'].forEach(id => {
            const el = document.getElementById(id);
            if (el?.classList.contains('show')) bootstrap.Modal.getInstance(el)?.hide();
        });
    });

    cargarNotas();
});

// =============================================================================
//   LISTADO
// =============================================================================

async function cargarNotas() {
    const tbody = document.getElementById('tablaNotas');
    tbody.innerHTML = '<tr><td colspan="9" class="text-center py-3"><div class="spinner-border spinner-border-sm text-success"></div> Cargando...</td></tr>';

    try {
        const params = new URLSearchParams({ limit: LIMIT, offset: paginaActual * LIMIT });
        const tipo      = document.getElementById('filtroTipo')?.value;
        const busqueda  = document.getElementById('filtroTexto')?.value;
        const idCliente = buscadorFiltro?.getClienteId();
        if (tipo)      params.append('tipo', tipo);
        if (busqueda)  params.append('busqueda', busqueda);
        if (idCliente) params.append('id_cliente', idCliente);

        const res  = await fetch(`${API_BASE}/notas?${params}`, { headers: getHeaders() });
        if (!res.ok) throw new Error((await res.json().catch(()=>({}))).error || `HTTP ${res.status}`);

        const result = await res.json();
        const notas  = result.data  || [];
        const total  = result.total || 0;

        renderNotas(notas);
        renderMetricas(notas);
        renderPaginacion(total);
    } catch (err) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-3"><i class="bi bi-exclamation-triangle"></i> ${err.message}</td></tr>`;
    }
}

function renderNotas(notas) {
    const tbody = document.getElementById('tablaNotas');
    if (!notas.length) {
        tbody.innerHTML = '<tr><td colspan="9" class="text-center text-muted py-4"><i class="bi bi-inbox"></i> No hay notas registradas</td></tr>';
        return;
    }
    tbody.innerHTML = notas.map(n => {
        const esNC    = n.tipo_nota === 'credito';
        const fecha   = n.fecha_emision ? new Date(n.fecha_emision).toLocaleDateString('es-AR') : '-';
        const origen  = n.factura_origen_numero || n.presupuesto_origen_numero || '-';
        const origenLabel = n.id_factura_origen ? 'F:' : n.id_presupuesto_origen ? 'P:' : '';
        const motivo  = (n.motivo||'').length > 45 ? n.motivo.substring(0,45)+'…' : (n.motivo||'-');
        const total   = parseFloat(n.total||0).toLocaleString('es-AR',{minimumFractionDigits:2});
        const caeIcon = n.cae ? '<i class="bi bi-patch-check-fill text-success" title="Con CAE AFIP"></i>' : '';
        const estadoBadge = n.estado === 'anulada'
            ? '<span class="lago-badge lago-badge-danger">ANULADA</span>'
            : '<span class="lago-badge lago-badge-activa">ACTIVA</span>';

        return `<tr class="${esNC ? 'nota-credito' : 'nota-debito'}">
            <td><span class="lago-badge ${esNC ? 'lago-badge-nc' : 'lago-badge-nd'}">${esNC ? 'CRÉDITO' : 'DÉBITO'}</span></td>
            <td class="mono"><strong>${n.numero_completo||'-'}</strong> ${caeIcon}</td>
            <td>${fecha}</td>
            <td>${n.cliente_nombre||'-'}</td>
            <td class="mono text-muted">${origenLabel}${origen}</td>
            <td title="${n.motivo||''}">${motivo}</td>
            <td class="money">$${total}</td>
            <td>${estadoBadge}</td>
            <td class="td-actions">
                <button class="btn-detalle" onclick="verDetalle(${n.id_nota})" title="Ver detalle"><i class="bi bi-eye"></i></button>
                ${n.estado !== 'anulada' ? `<button class="btn-detalle" style="color:var(--lago-danger)" onclick="confirmarAnular(${n.id_nota},'${(n.numero_completo||'').replace(/'/g,"\\'")}',${!!n.cae})" title="Anular"><i class="bi bi-x-circle"></i></button>` : ''}
            </td>
        </tr>`;
    }).join('');
}

function renderMetricas(notas) {
    const nc = notas.filter(n => n.tipo_nota === 'credito');
    const nd = notas.filter(n => n.tipo_nota === 'debito');
    const sumNC = nc.reduce((s,n) => s + parseFloat(n.total||0), 0);
    const sumND = nd.reduce((s,n) => s + parseFloat(n.total||0), 0);
    const set = (id, v) => { const e = document.getElementById(id); if(e) e.textContent = v; };
    set('metricNC',    nc.length);
    set('metricNCSub', '$'+sumNC.toLocaleString('es-AR',{minimumFractionDigits:0}));
    set('metricND',    nd.length);
    set('metricNDSub', '$'+sumND.toLocaleString('es-AR',{minimumFractionDigits:0}));
    set('metricTotal',    notas.length);
    set('metricTotalSub', '$'+(sumNC+sumND).toLocaleString('es-AR',{minimumFractionDigits:0}));
}

function renderPaginacion(total) {
    const cont = document.getElementById('paginacionContainer');
    if (!cont) return;
    if (total <= LIMIT) { cont.innerHTML = ''; return; }
    const totalPages = Math.ceil(total / LIMIT);
    const desde = paginaActual * LIMIT + 1;
    const hasta = Math.min((paginaActual+1)*LIMIT, total);
    cont.innerHTML = `<div class="d-flex justify-content-between align-items-center mt-2 px-2">
        <small class="text-muted">${desde}–${hasta} de ${total}</small>
        <div>
            ${paginaActual > 0 ? `<button class="btn btn-sm btn-outline-success me-1" onclick="cambiarPagina(${paginaActual-1})"><i class="bi bi-chevron-left"></i></button>` : ''}
            ${paginaActual < totalPages-1 ? `<button class="btn btn-sm btn-outline-success" onclick="cambiarPagina(${paginaActual+1})"><i class="bi bi-chevron-right"></i></button>` : ''}
        </div>
    </div>`;
}

function cambiarPagina(p) { paginaActual = p; cargarNotas(); }

// =============================================================================
//   SELECTOR DE TIPO Y ORIGEN  (Paso 1 y 2)
// =============================================================================

function abrirSelector() {
    const modal = document.getElementById('modalSelector');
    if (!modal) return;
    // Reset visual
    modal.querySelectorAll('.card-tipo, .card-origen').forEach(c => c.classList.remove('selected'));
    document.getElementById('selectorPaso2').style.display = 'none';
    document.getElementById('btnAbrirFormulario').style.display = 'none';
    formState.tipo   = '';
    formState.origen = '';
    new bootstrap.Modal(modal).show();
}

function seleccionarTipo(tipo) {
    formState.tipo = tipo;
    document.querySelectorAll('.card-tipo').forEach(c => c.classList.remove('selected'));
    document.querySelector(`.card-tipo[data-tipo="${tipo}"]`)?.classList.add('selected');
    document.getElementById('selectorPaso2').style.display = '';
    document.getElementById('btnAbrirFormulario').style.display = 'none';
    document.querySelectorAll('.card-origen').forEach(c => c.classList.remove('selected'));
    formState.origen = '';
}

function seleccionarOrigen(origen) {
    formState.origen = origen;
    document.querySelectorAll('.card-origen').forEach(c => c.classList.remove('selected'));
    document.querySelector(`.card-origen[data-origen="${origen}"]`)?.classList.add('selected');
    document.getElementById('btnAbrirFormulario').style.display = '';
}

function confirmarSelector() {
    if (!formState.tipo || !formState.origen) {
        AtajosGlobales.toast('Seleccioná tipo y origen');
        return;
    }
    bootstrap.Modal.getInstance(document.getElementById('modalSelector'))?.hide();
    setTimeout(() => abrirFormulario(formState.tipo, formState.origen), 300);
}

// =============================================================================
//   FORMULARIO PRINCIPAL
// =============================================================================

async function abrirFormulario(tipo, origen) {
    formState.tipo                  = tipo;
    formState.origen                = origen;
    formState.id_cliente            = null;
    formState.letra                 = '';
    formState.punto_venta           = null;
    formState.id_factura_origen     = null;
    formState.id_presupuesto_origen = null;
    formState.requiere_afip         = false;
    formState.itemCount             = 0;

    const esNC = tipo === 'credito';

    // Título y color del header
    const header   = document.getElementById('modalHeader');
    const title    = document.getElementById('modalTitle');
    const subtitle = document.getElementById('modalSubtitle');
    const icon     = document.getElementById('modalHeaderIcon');
    if (header) {
        header.style.background = esNC
            ? 'linear-gradient(135deg, #14532d, #16a34a)'
            : 'linear-gradient(135deg, #78350f, #d97706)';
    }
    if (title) {
        title.textContent = esNC ? 'Nueva Nota de Crédito' : 'Nueva Nota de Débito';
    }
    if (subtitle) {
        subtitle.textContent = origen === 'factura'     ? 'Desde factura · con AFIP'
                             : origen === 'presupuesto' ? 'Desde presupuesto · sin AFIP'
                             : 'Manual · sin AFIP';
    }
    if (icon) {
        icon.innerHTML = esNC
            ? '<i class="bi bi-file-earmark-minus"></i>'
            : '<i class="bi bi-file-earmark-plus"></i>';
    }

    // Mostrar/ocultar secciones según origen
    const secComp = document.getElementById('seccionBuscarComprobante');
    if (secComp) secComp.style.display = (origen === 'factura' || origen === 'presupuesto') ? '' : 'none';

    // Label del buscador de comprobante
    const lblComp = document.getElementById('labelBuscarComprobante');
    if (lblComp) {
        lblComp.textContent = origen === 'factura'
            ? 'Buscar factura de origen'
            : 'Buscar presupuesto de origen';
    }

    // Badge AFIP
    const badgeAfip = document.getElementById('badgeAfip');
    if (badgeAfip) badgeAfip.style.display = origen === 'factura' ? '' : 'none';

    // Limpiar form
    document.getElementById('formNota').reset();
    document.getElementById('itemsNota').innerHTML = '';
    document.getElementById('inputComprobanteOrigen').value = '';
    document.getElementById('infoComprobanteOrigen').innerHTML = '';
    actualizarTotalesForm();

    // Items vacíos por defecto para manual
    if (origen === 'manual') {
        agregarItem();
        agregarItem();
    }

    const modal = new bootstrap.Modal(document.getElementById('modalNota'));
    modal.show();

    // Inicializar BuscadorClientes en el modal
    setTimeout(() => {
        buscadorModal?.destroy?.();
        buscadorModal = new BuscadorClientes({
            container:   '#buscadorClienteModal',
            placeholder: 'Buscar cliente...',
            autoFocus:   origen === 'manual',
            onSelect: (cli) => {
                formState.id_cliente  = cli.id_cliente;
                formState.letra       = formState.letra || '';
                const hid = document.getElementById('id_cliente_hidden');
                if (hid) hid.value = cli.id_cliente;
                cargarComprobantesCliente(cli.id_cliente, cli.razon_social);
            },
            onClear: () => {
                formState.id_cliente = null;
                const panel = document.getElementById('comprobantesCliente');
                if (panel) panel.innerHTML = '<div style="padding:1.25rem;text-align:center;color:#94a3b8;font-size:.78rem"><i class="bi bi-arrow-up" style="display:block;font-size:1.2rem;margin-bottom:.35rem;opacity:.4"></i>Primero seleccioná un cliente</div>';
            },
        });

        // Si el origen tiene comprobante, el cliente viene de él
        if (origen !== 'manual') {
            document.getElementById('inputComprobanteOrigen')?.focus();
        }
    }, 350);
}

// ─── Buscar comprobante de origen (lazy search) ───────────────────────────────

let _timerComp;
function buscarComprobanteDebounce() {
    clearTimeout(_timerComp);
    _timerComp = setTimeout(buscarComprobante, 350);
}
// Carga los comprobantes del cliente seleccionado en el panel izquierdo
async function cargarComprobantesCliente(id_cliente, razon_social) {
    const panel = document.getElementById('comprobantesCliente');
    if (!panel) return;
    const tipo = formState.origen;
    if (tipo === 'manual') return;

    panel.innerHTML = '<div style="padding:1rem;text-align:center;color:#94a3b8;font-size:.78rem"><span class="spinner-border spinner-border-sm me-1"></span>Cargando...</div>';

    try {
        const endpoint = tipo === 'factura'
            ? `${API_BASE}/facturas?id_cliente=${id_cliente}&limit=20`
            : `${API_BASE}/presupuestos?id_cliente=${id_cliente}&limit=20`;

        const res  = await fetch(endpoint, { headers: getHeaders() });
        const data = await res.json();
        const rows = data.data || data || [];

        if (!rows.length) {
            const tipoLabel = tipo === 'factura' ? 'facturas' : 'presupuestos';
            panel.innerHTML = `<div style="padding:.85rem 1rem;border-left:3px solid #f59e0b;background:#fffbeb;border-radius:0 0 6px 6px">
                <div style="font-weight:600;font-size:.8rem;color:#92400e">⚠️ ${razon_social} no tiene ${tipoLabel}</div>
                <div style="font-size:.73rem;color:#b45309;margin-top:.2rem">
                    ${tipo === 'presupuesto'
                        ? 'Podés usar origen <b>Manual</b> para crear la nota sin comprobante.'
                        : 'No hay facturas emitidas para este cliente.'}
                </div>
            </div>`;
            return;
        }

        panel.innerHTML = rows.map(r => {
            const num    = r.numero_completo;
            const total  = parseFloat(r.total||0).toLocaleString('es-AR',{minimumFractionDigits:2});
            const fecha  = r.fecha_emision ? new Date(r.fecha_emision).toLocaleDateString('es-AR') : '';
            const id     = r.id_factura || r.id_presupuesto;
            const cae    = r.cae ? `<span style="font-size:.63rem;background:#d1fae5;color:#065f46;padding:1px 5px;border-radius:3px;margin-left:.3rem">CAE</span>` : '';
            return `<div onclick="seleccionarComprobante(${id},'${num}')"
                style="padding:.55rem .75rem;cursor:pointer;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #f1f5f9;transition:background .1s"
                onmouseover="this.style.background='#f0fdf4'"
                onmouseout="this.style.background=''">
                <div>
                    <div style="font-family:monospace;font-weight:700;font-size:.8rem;color:#1a5f7a">${num}${cae}</div>
                    <div style="font-size:.72rem;color:#64748b">${fecha}</div>
                </div>
                <div style="font-family:monospace;font-weight:700;font-size:.82rem;color:#16a34a">$${total}</div>
            </div>`;
        }).join('');
    } catch(e) {
        panel.innerHTML = '<div style="padding:.75rem;color:#ef4444;font-size:.78rem">Error al cargar comprobantes</div>';
    }
}



async function buscarComprobante() {
    const q       = document.getElementById('inputComprobanteOrigen')?.value?.trim();
    const tipo    = formState.origen; // 'factura' | 'presupuesto'
    const lista   = document.getElementById('listaComprobantes');
    if (!lista) return;

    if (!q || q.length < 2) { lista.innerHTML = ''; lista.style.display = 'none'; return; }

    try {
        // Incluir id_cliente si ya fue seleccionado (filtra resultados del cliente)
        const clienteParam = formState.id_cliente ? `&id_cliente=${formState.id_cliente}` : '';
        const endpoint = tipo === 'factura'
            ? `${API_BASE}/facturas?busqueda=${encodeURIComponent(q)}&limit=10${clienteParam}`
            : `${API_BASE}/presupuestos?busqueda=${encodeURIComponent(q)}&limit=10${clienteParam}`;

        const res  = await fetch(endpoint, { headers: getHeaders() });
        if (!res.ok) return;
        const data = await res.json();
        const rows = data.data || data || [];

        if (!rows.length) {
            const tipoLabel = tipo === "factura" ? "facturas" : "presupuestos";
            lista.innerHTML = `<div style="padding:.85rem 1rem;border-left:3px solid #f59e0b;background:#fffbeb"><div style="font-weight:600;font-size:.82rem;color:#92400e">⚠️ Sin ${tipoLabel} para esta búsqueda</div><div style="font-size:.75rem;color:#b45309;margin-top:.2rem">${tipo === "presupuesto" ? "Este cliente no tiene presupuestos. Usá origen Manual para crear la nota sin comprobante." : "No se encontraron facturas. Verificá el nombre o usá origen Manual."}</div></div>`;
            lista.style.display = 'block';
            return;
        }

        lista.innerHTML = rows.map(r => {
            const num    = r.numero_completo || r.id_factura || r.id_presupuesto;
            const total  = parseFloat(r.total||0).toLocaleString('es-AR',{minimumFractionDigits:2});
            const cliente = r.razon_social || r.cliente || r.cliente_nombre || '';
            const fecha  = r.fecha_emision ? new Date(r.fecha_emision).toLocaleDateString('es-AR') : '';
            const id     = r.id_factura || r.id_presupuesto;
            return `<div onclick="seleccionarComprobante(${id},'${num.replace(/'/g,"\\'")}');event.stopPropagation()"
                style="padding:.55rem 1rem;cursor:pointer;display:flex;align-items:center;
                       justify-content:space-between;border-bottom:1px solid #f1f5f9;
                       background:#fff;transition:background .1s"
                onmouseover="this.style.background='#f0fdf4'"
                onmouseout="this.style.background='#fff'">
                <div>
                    <div style="font-family:monospace;font-weight:700;font-size:.82rem;color:#1a5f7a">${num}</div>
                    <div style="font-size:.78rem;color:#64748b">${cliente}${fecha ? ' · '+fecha : ''}</div>
                </div>
                <div style="font-family:monospace;font-weight:700;font-size:.82rem;color:#16a34a;white-space:nowrap;margin-left:1rem">$${total}</div>
            </div>`;
        }).join('');
        lista.style.display = 'block';
    } catch(e) {
        console.error('Error buscando comprobante:', e);
    }
}

async function seleccionarComprobante(id, numero) {
    document.getElementById('listaComprobantes').style.display = 'none';
    document.getElementById('inputComprobanteOrigen').value = numero;

    const info = document.getElementById('infoComprobanteOrigen');
    info.innerHTML = '<small class="text-muted"><i class="bi bi-hourglass-split"></i> Cargando datos...</small>';

    try {
        const tipo = formState.origen; // 'factura' | 'presupuesto'
        const res  = await fetch(`${API_BASE}/notas/comprobante-origen/${tipo}/${id}`, { headers: getHeaders() });
        if (!res.ok) {
            const err = await res.json().catch(()=>({}));
            throw new Error(err.error || 'Error al cargar comprobante');
        }
        const datos = await res.json();

        // Guardar en estado
        formState.letra        = datos.letra;
        formState.punto_venta  = datos.punto_venta;
        formState.requiere_afip= datos.requiere_afip;

        if (tipo === 'factura') {
            formState.id_factura_origen = id;
        } else {
            formState.id_presupuesto_origen = id;
        }

        // Autocompletar cliente en el buscador
        if (datos.cliente && datos.cliente.id_cliente) {
            formState.id_cliente = datos.cliente.id_cliente;
            // setCliente espera objeto con id_cliente, razon_social, etc.
            if (buscadorModal && typeof buscadorModal.setCliente === 'function') {
                buscadorModal.setCliente(datos.cliente);
            }
            // También setear el hidden para seguridad
            const hid = document.getElementById('id_cliente_hidden');
            if (hid) hid.value = datos.cliente.id_cliente;
        }

        // Autocompletar punto de venta si viene
        if (datos.punto_venta) {
            const pvInput = document.getElementById('punto_venta');
            if (pvInput) pvInput.value = datos.punto_venta;
        }

        // Badge AFIP dinámico
        const badgeAfip = document.getElementById('badgeAfip');
        if (badgeAfip) {
            badgeAfip.innerHTML = datos.requiere_afip
                ? (datos.tiene_cae_real
                    ? '<span class="badge bg-success"><i class="bi bi-patch-check"></i> Requiere CAE AFIP</span>'
                    : '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle"></i> Factura sin CAE real — no irá a AFIP</span>')
                : '<span class="badge bg-secondary"><i class="bi bi-file-text"></i> Documento interno — sin AFIP</span>';
            badgeAfip.style.display = '';
        }

        // Autocompletar items desde el comprobante
        cargarItemsDesdeComprobante(datos.items || []);

        // Info resumen
        info.innerHTML = `<div class="alert alert-info py-1 px-2 mb-0 mt-1">
            <small>
                <strong>${datos.cliente?.razon_social || ''}</strong>
                | Letra: <strong>${datos.letra}</strong>
                | Total: <strong>$${parseFloat(datos.totales?.total||0).toLocaleString('es-AR',{minimumFractionDigits:2})}</strong>
                ${datos.requiere_afip && datos.tiene_cae_real ? ' | <span class="text-success">✓ AFIP</span>' : ''}
            </small>
        </div>`;

    } catch(err) {
        info.innerHTML = `<small class="text-danger"><i class="bi bi-exclamation-triangle"></i> ${err.message}</small>`;
    }
}

function cargarItemsDesdeComprobante(items) {
    document.getElementById('itemsNota').innerHTML = '';
    formState.itemCount = 0;
    if (!items.length) {
        agregarItem();
        return;
    }
    items.forEach(item => agregarItem(item));
}

