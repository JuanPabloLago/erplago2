function confirmarAnular(id, numero, tieneCae) {
    const aviso = tieneCae
        ? '\n⚠️ Esta nota tiene CAE de AFIP. Verifique si corresponde gestionar contrapartida.'
        : '';
    if (!confirm(`¿ANULAR la nota ${numero}?\nSe revertirán los movimientos en cuenta corriente.${aviso}`)) return;
    anularNota(id);
}

async function anularNota(id) {
    try {
        const res = await fetch(`${API_BASE}/notas/${id}`, { method: 'DELETE', headers: getHeaders() });
        if (res.ok) {
            const data = await res.json();
            AtajosGlobales.toast('Nota anulada ✓');
            if (data.aviso_afip) {
                setTimeout(() => alert(`ℹ️ AFIP: ${data.aviso_afip}`), 500);
            }
            cargarNotas();
        } else {
            const err = await res.json().catch(()=>({}));
            alert('Error: ' + (err.error||'No se pudo anular'));
        }
    } catch(e) {
        alert('Error de conexión al anular nota');
    }
}
