const _prodTimers = {};

function agregarItem(datosPreCargados = null) {
    formState.itemCount++;
    const id = formState.itemCount;

    const cantidad = datosPreCargados?.cantidad       || 1;
    const precio   = datosPreCargados?.precio_unitario|| 0;
    const iva      = datosPreCargados?.iva_porcentaje || 21;
    const desc     = datosPreCargados?.descripcion    || '';
    const prodId   = datosPreCargados?.id_producto    || '';

    // Si viene precargado, mostrar desc directo en el buscador y ocultar input extra
    const tieneProd = !!datosPreCargados;
    const row = `<tr id="item-${id}">
        <td style="position:relative; min-width:200px">
            <input type="hidden" class="producto-id" value="${prodId}">
            ${tieneProd
                ? `<input type="text" class="form-control form-control-sm producto-busqueda"
                    placeholder="Buscar producto..." autocomplete="off"
                    oninput="buscarProductoDebounce(this,${id})"
                    value="${desc.replace(/"/g,'&quot;')}" style="display:none">
                   <div class="dropdown-menu w-100" id="prodDropdown-${id}" style="max-height:200px;overflow-y:auto;position:absolute;z-index:9999"></div>
                   <input type="text" class="form-control form-control-sm descripcion-input"
                    placeholder="Descripción *" value="${desc.replace(/"/g,'&quot;')}">`
                : `<input type="text" class="form-control form-control-sm producto-busqueda mb-1"
                    placeholder="Buscar producto..." autocomplete="off"
                    oninput="buscarProductoDebounce(this,${id})">
                   <div class="dropdown-menu w-100" id="prodDropdown-${id}" style="max-height:200px;overflow-y:auto;position:absolute;z-index:9999"></div>
                   <input type="text" class="form-control form-control-sm descripcion-input"
                    placeholder="Descripción *" value="">`
            }
        </td>
        <td style="width:90px">
            <input type="number" class="form-control form-control-sm cantidad-input"
                value="${cantidad}" min="0.01" step="0.01"
                onchange="calcularItem(${id})" onkeyup="calcularItem(${id})">
        </td>
        <td style="width:110px">
            <input type="number" class="form-control form-control-sm precio-input"
                value="${precio}" min="0" step="0.01"
                onchange="calcularItem(${id})" onkeyup="calcularItem(${id})">
        </td>
        <td style="width:80px">
            <input type="number" class="form-control form-control-sm iva-input"
                value="${iva}" min="0" max="105" step="0.01"
                onchange="calcularItem(${id})" onkeyup="calcularItem(${id})">
        </td>
        <td style="width:110px">
            <input type="text" class="form-control form-control-sm total-input bg-light" readonly>
        </td>
        <td style="width:40px">
            <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarItem(${id})">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>`;

    document.getElementById('itemsNota').insertAdjacentHTML('beforeend', row);
    calcularItem(id);

    // Tab entre campos dentro del item
    const fila = document.getElementById(`item-${id}`);
    fila.querySelectorAll('input:not([type=hidden])').forEach((inp, i, arr) => {
        inp.addEventListener('keydown', e => {
            if (e.key === 'Tab' && !e.shiftKey && i === arr.length - 2) {
                // Al salir del precio, foco en cantidad del mismo item
            }
            if (e.key === 'Enter') { e.preventDefault(); arr[Math.min(i+1, arr.length-1)].focus(); }
        });
    });
}

function buscarProductoDebounce(input, itemId) {
    clearTimeout(_prodTimers[itemId]);
    _prodTimers[itemId] = setTimeout(() => buscarProducto(input, itemId), 300);
}

async function buscarProducto(input, itemId) {
    const q        = input.value.trim();
    const dropdown = document.getElementById(`prodDropdown-${itemId}`);
    if (!dropdown) return;
    if (q.length < 2) { dropdown.innerHTML = ''; dropdown.style.display = 'none'; return; }

    try {
        const res  = await fetch(`${API_BASE}/productos/buscar?q=${encodeURIComponent(q)}&limit=10`, { headers: getHeaders() });
        if (!res.ok) return;
        const data = await res.json();
        const prods = data.results || data.productos || data.data || data || [];

        if (!prods.length) {
            dropdown.innerHTML = '<div class="dropdown-item-text text-muted small">Sin resultados</div>';
        } else {
            dropdown.innerHTML = prods.map(p => {
                const precio = parseFloat(p.precio || p.precio_venta || 0).toFixed(2);
                const nombre = (p.nombre||'').replace(/'/g,"\\'");
                return `<a class="dropdown-item small" href="#"
                    onclick="seleccionarProducto(${itemId},${p.id_producto},'${nombre}',${precio}); return false;">
                    <strong>${p.codigo||p.sku||''}</strong> ${p.nombre} — $${precio}
                </a>`;
            }).join('');
        }
        dropdown.style.display = '';
    } catch(e) { console.error('Error productos:', e); }
}

function seleccionarProducto(itemId, idProd, nombre, precio) {
    const row = document.getElementById(`item-${itemId}`);
    if (!row) return;
    row.querySelector('.producto-id').value        = idProd;
    row.querySelector('.descripcion-input').value  = nombre;
    row.querySelector('.precio-input').value        = precio;
    const dd = document.getElementById(`prodDropdown-${itemId}`);
    if (dd) dd.style.display = 'none';
    calcularItem(itemId);
    row.querySelector('.cantidad-input').focus();
    row.querySelector('.cantidad-input').select();
}

function calcularItem(itemId) {
    const row = document.getElementById(`item-${itemId}`);
    if (!row) return;
    const cant  = parseFloat(row.querySelector('.cantidad-input')?.value) || 0;
    const prec  = parseFloat(row.querySelector('.precio-input')?.value)   || 0;
    const iva   = parseFloat(row.querySelector('.iva-input')?.value)      || 0;
    const sub   = cant * prec;
    const total = sub + sub * (iva / 100);
    const ti    = row.querySelector('.total-input');
    if (ti) ti.value = '$' + total.toFixed(2);
    actualizarTotalesForm();
}

function actualizarTotalesForm() {
    let sub = 0, ivaT = 0;
    document.querySelectorAll('#itemsNota tr').forEach(row => {
        const c = parseFloat(row.querySelector('.cantidad-input')?.value) || 0;
        const p = parseFloat(row.querySelector('.precio-input')?.value)   || 0;
        const v = parseFloat(row.querySelector('.iva-input')?.value)      || 0;
        const s = c * p;
        sub  += s;
        ivaT += s * (v / 100);
    });
    const set = (id,v) => { const e=document.getElementById(id); if(e) e.textContent=v; };
    set('subtotalNota', '$'+sub.toFixed(2));
    set('ivaNota',      '$'+ivaT.toFixed(2));
    set('totalNota',    '$'+(sub+ivaT).toFixed(2));
}

function eliminarItem(itemId) {
    document.getElementById(`item-${itemId}`)?.remove();
    actualizarTotalesForm();
}

// =============================================================================
//   GUARDAR NOTA
// =============================================================================

async function guardarNota() {
    const tipo_nota  = formState.tipo;
    const origen     = formState.origen;
    const id_cliente = formState.id_cliente || document.getElementById('id_cliente_hidden')?.value;
    const motivo     = document.getElementById('motivo')?.value?.trim();
    const obs        = document.getElementById('observaciones')?.value?.trim();
    const pv         = parseInt(document.getElementById('punto_venta')?.value);

    // Validaciones frontend
    if (!id_cliente) {
        AtajosGlobales.toast('Seleccioná un cliente');
        buscadorModal?.focus?.();
        return;
    }
    if (!pv || isNaN(pv)) {
        AtajosGlobales.toast('Ingresá el punto de venta');
        document.getElementById('punto_venta')?.focus();
        return;
    }
    if (!motivo) {
        AtajosGlobales.toast('El motivo es obligatorio');
        document.getElementById('motivo')?.focus();
        return;
    }
    if (origen === 'factura' && !formState.id_factura_origen) {
        AtajosGlobales.toast('Seleccioná la factura de origen');
        return;
    }
    if (origen === 'presupuesto' && !formState.id_presupuesto_origen) {
        AtajosGlobales.toast('Seleccioná el presupuesto de origen');
        return;
    }

    // Recolectar items válidos
    const items = [];
    document.querySelectorAll('#itemsNota tr').forEach(row => {
        const desc   = row.querySelector('.descripcion-input')?.value?.trim();
        const cant   = parseFloat(row.querySelector('.cantidad-input')?.value);
        const precio = parseFloat(row.querySelector('.precio-input')?.value);
        const iva    = parseFloat(row.querySelector('.iva-input')?.value ?? 21);
        const prodId = row.querySelector('.producto-id')?.value;
        if (desc && cant > 0 && precio >= 0) {
            items.push({
                id_producto:    prodId ? parseInt(prodId) : null,
                descripcion:    desc,
                cantidad:       cant,
                precio_unitario:precio,
                iva_porcentaje: iva,
            });
        }
    });

    if (!items.length) {
        AtajosGlobales.toast('Agregá al menos un item con descripción, cantidad y precio');
        return;
    }

    const tipoLabel = tipo_nota === 'credito' ? 'Crédito' : 'Débito';
    const afipWarn  = formState.requiere_afip
        ? '\n⚠️ Esta nota requiere CAE de AFIP.' : '';

    if (!confirm(`¿Confirmar Nota de ${tipoLabel}?${afipWarn}`)) return;

    const btn = document.getElementById('btnGuardarNota');
    if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Guardando...'; }

    try {
        const body = {
            tipo_nota:              tipo_nota,
            origen:                 origen,
            id_cliente:             parseInt(id_cliente),
            punto_venta:            pv,
            motivo,
            observaciones:          obs || null,
            items,
            id_factura_origen:      formState.id_factura_origen     || null,
            id_presupuesto_origen:  formState.id_presupuesto_origen || null,
            letra:                  formState.letra                 || null,
        };

        const res = await fetch(`${API_BASE}/notas`, {
            method:  'POST',
            headers: getHeaders(true),
            body:    JSON.stringify(body),
        });

        if (res.ok) {
            const nota = await res.json();
            AtajosGlobales.toast(
                `Nota de ${tipoLabel} ${nota.numero_completo||''} creada ✓` +
                (nota.cae ? ` · CAE: ${nota.cae}` : '')
            );
            bootstrap.Modal.getInstance(document.getElementById('modalNota'))?.hide();
            cargarNotas();
        } else {
            const err = await res.json().catch(()=>({}));
            const msg = err.error || err.detalle || 'Error desconocido';
            if (err.codigo === 'AFIP_ERROR') {
                alert(`❌ Error AFIP:\n${msg}\n\nLa nota NO fue creada.`);
            } else {
                alert(`Error: ${msg}`);
            }
        }
    } catch(e) {
        console.error('Error guardando nota:', e);
        alert('Error de conexión al guardar nota');
    } finally {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-save"></i> Guardar <kbd>F2</kbd>'; }
    }
}

