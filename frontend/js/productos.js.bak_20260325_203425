// SINCRONIZAR CATÁLOGO WEB
// ═══════════════════════════════════════════════════════════════
async function sincronizarWeb() {
    const btn = document.getElementById('btnSyncWeb');
    if (!confirm('¿Sincronizar catálogo web ahora?\n\nEsto genera el JSON y lo sube a lago.ar')) return;
    const textoOriginal = btn.innerHTML;
    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Sincronizando...';
    btn.disabled = true;
    try {
        const res = await fetch(window.CONFIG?.API_BASE_URL + '/productos/sincronizar-web', {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + localStorage.getItem('authToken'), 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (res.ok) {
            btn.innerHTML = '<i class="bi bi-check-circle"></i> ¡Sincronizado!';
            btn.style.background = '#28a745';
            btn.style.color = 'white';
            setTimeout(() => { btn.innerHTML = textoOriginal; btn.style.background = '#d4edda'; btn.style.color = '#155724'; btn.disabled = false; }, 3000);
        } else {
            throw new Error(data.error || 'Error al sincronizar');
        }
    } catch (e) {
        alert('Error: ' + e.message);
        btn.innerHTML = textoOriginal;
        btn.disabled = false;
    }
}



