                </div>
                <div class="modal-footer py-2">
                    <span class="keyboard-hint me-auto small">F2 guardar · Esc cancelar</span>
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-sm btn-primary" onclick="guardarProducto()">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== MODAL AJUSTE PRECIO MASIVO ========== -->
    <div class="modal fade modal-lago" id="modalAjustePrecio" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-percent"></i> Ajustar Precios</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        Se aplicará a <strong id="ajusteCantidad">0</strong> productos según los filtros actuales.
                    </div>

                    <div class="mb-3">
                        <label class="form-label-lago">Tipo de ajuste</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" name="tipoAjuste" id="tipoAumento" value="aumento" checked>
                            <label class="btn btn-outline-success" for="tipoAumento">
                                <i class="bi bi-arrow-up"></i> Aumento
                            </label>
                            <input type="radio" class="btn-check" name="tipoAjuste" id="tipoDescuento" value="descuento">
                            <label class="btn btn-outline-danger" for="tipoDescuento">
                                <i class="bi bi-arrow-down"></i> Descuento
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-lago">Porcentaje</label>
                        <div class="input-group">
                            <input type="number" class="form-control form-control-lago" id="ajustePorcentaje" min="1" max="100" value="10">
                            <span class="input-group-text">%</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-lago">Aplicar a:</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ajusteVenta" checked>
                            <label class="form-check-label" for="ajusteVenta">
                                Precios de venta (todas las listas)
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="ajusteCompra">
                            <label class="form-check-label" for="ajusteCompra">
                                Precios de compra
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-lago">Motivo (opcional)</label>
                        <input type="text" class="form-control form-control-lago" id="ajusteMotivo" placeholder="Ej: Ajuste por inflación enero 2026">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary" onclick="ejecutarAjustePrecio()">
                        <i class="bi bi-check-lg"></i> Aplicar Ajuste
                    </button>
                </div>
            </div>
        </div>
    </div>
<!-- ========== MODAL IMPORTAR EXCEL ========== -->
<div class="modal fade" id="modalImportar" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-lago">
            <div class="modal-header">
                <h5 class="modal-title-lago">
                    <i class="bi bi-upload"></i> Importar Productos desde Excel
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="dropZoneImport" class="border border-2 border-dashed rounded p-4 text-center mb-3" 
                     style="border-color: #667eea !important; background: #f8f9ff; cursor: pointer; transition: all 0.2s;">
                    <i class="bi bi-cloud-arrow-up" style="font-size: 3rem; color: #667eea;"></i>
                    <p class="mb-2 mt-2"><strong>Arrastrá el archivo Excel aquí</strong></p>
                    <p class="text-muted mb-0">o hacé clic para seleccionar</p>
                    <input type="file" id="inputArchivoImport" accept=".xlsx,.xls" style="display: none;">
                </div>
                <div id="archivoSeleccionado" class="alert alert-info d-none">
                    <i class="bi bi-file-earmark-excel me-2"></i>
                    <span id="nombreArchivoImport"></span>
                    <button type="button" class="btn-close float-end" onclick="limpiarArchivoImport()"></button>
                </div>
                <!-- Opciones de IVA -->
                <div class="card border-primary mb-3" id="opcionesIvaImport">
                    <div class="card-header bg-primary text-white py-2">
                        <i class="bi bi-percent me-1"></i> Configuración de IVA
                    </div>
                    <div class="card-body">
                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="chkPreciosIncluyenIva" checked>
                            <label class="form-check-label" for="chkPreciosIncluyenIva">
                                <strong>Los precios del Excel incluyen IVA</strong>
                                <small class="text-muted d-block">Se calculará el precio neto automáticamente</small>
                            </label>
                        </div>
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <label for="selectAlicuotaIva" class="col-form-label">Alícuota:</label>
                            </div>
                            <div class="col-auto">
                                <select class="form-select form-select-sm" id="selectAlicuotaIva">
                                    <option value="0">0%</option>
                                    <option value="2.5">2.5%</option>
                                    <option value="5">5%</option>
                                    <option value="10.5">10.5%</option>
                                    <option value="21" selected>21%</option>
                                    <option value="27">27%</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card border-0 bg-light">
                    <div class="card-body small">
                        <h6 class="card-title"><i class="bi bi-info-circle me-1"></i>Instrucciones</h6>
                        <ul class="mb-0">
                            <li><strong>SKU obligatorio</strong> - Identifica productos existentes o crea nuevos</li>
                            <li><strong>SKU_Padre</strong> - Si tiene valor, la fila es una variante del producto padre</li>
                            <li><strong>Columnas vacías</strong> - No se modifican (útil para actualizar solo precios)</li>
                            <li><strong>Categoría/Marca/Proveedor</strong> - Deben existir exactamente en el sistema</li>
                        </ul>
                        <div class="mt-2">
                            <a href="#" onclick="descargarPlantilla('completo', false); return false;" class="text-decoration-none">
                                <i class="bi bi-download me-1"></i>Descargar plantilla vacía
                            </a>
                            <span class="mx-2">|</span>
                            <a href="#" onclick="descargarPlantilla('completo', true); return false;" class="text-decoration-none">
                                <i class="bi bi-download me-1"></i>Descargar con datos actuales
                            </a>
                        </div>
                    </div>
                </div>
                <div id="resultadoImport" class="mt-3 d-none"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnEjecutarImport" onclick="ejecutarImportacion()" disabled>
                    <i class="bi bi-upload"></i> Importar
                </button>
            </div>
        </div>
    </div>
</div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/auth.js"></script>
    <script src="js/productos.js"></script>

<!-- ========== MODAL CARGAR IMÁGENES ========== -->
<div class="modal fade" id="modalCargarImagenes" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content modal-lago">
            <div class="modal-header">
                <h5 class="modal-title-lago">
                    <i class="bi bi-image"></i> Cargar Imágenes desde URLs
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Paso 1: Input URLs -->
                <div id="imgStep1">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Pegar URLs de imágenes (una por línea):</label>
                        <textarea class="form-control" id="txtUrlsImagenes" rows="8" placeholder="https://i.ibb.co/xxx/SKU1.jpg"></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="chkSobrescribirImagenes">
                        <label class="form-check-label" for="chkSobrescribirImagenes">Sobrescribir imágenes existentes</label>
                    </div>
                    <div class="card bg-light border-0">
                        <div class="card-body small">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>El SKU se extrae del nombre del archivo.</strong><br>
                            Ej: <code>https://i.ibb.co/xxx/<strong>ALI3000</strong>.jpg</code> → SKU: <strong>ALI3000</strong><br>
                            Si hay duplicados (mismo SKU), se usa la última URL de la lista.
                        </div>
                    </div>
                </div>
                <!-- Paso 2: Preview -->
                <div id="imgStep2" class="d-none">
                    <div class="alert alert-info mb-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-info-circle me-1"></i> <strong id="imgResumenPreview">Analizando...</strong></span>
                            <button class="btn btn-sm btn-outline-primary" onclick="volverPaso1Imagenes()"><i class="bi bi-arrow-left"></i> Volver</button>
                        </div>
                    </div>
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-hover">
                            <thead class="table-light sticky-top">
                                <tr><th style="width: 50px;">Estado</th><th>SKU</th><th>Producto</th><th>Acción</th><th style="width: 60px;">Preview</th></tr>
                            </thead>
                            <tbody id="tbodyPreviewImagenes"></tbody>
                        </table>
                    </div>
                </div>
                <!-- Paso 3: Resultado -->
                <div id="imgStep3" class="d-none">
                    <div class="text-center py-4">
                        <i class="bi bi-check-circle text-success" style="font-size: 4rem;"></i>
                        <h4 class="mt-3" id="imgResultadoTitulo">¡Imágenes cargadas!</h4>
                        <p class="text-muted" id="imgResultadoDetalle"></p>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" id="btnAnalizarImagenes" onclick="analizarImagenes()"><i class="bi bi-search"></i> Analizar</button>
                <button type="button" class="btn btn-success d-none" id="btnAplicarImagenes" onclick="aplicarImagenes()"><i class="bi bi-check-lg"></i> Aplicar</button>
            </div>
        </div>
    </div>
</div>
</body>
</html>
