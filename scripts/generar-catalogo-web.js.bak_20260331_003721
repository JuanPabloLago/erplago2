/**
 * GENERAR-CATALOGO-WEB.js
 * Genera catalogo.json para la web pública de LAGO
 * - Precios con IVA según alícuota de cada producto
 * - Herencia de imagen desde producto padre
 */
const { Pool } = require('pg');
const fs = require('fs');
const path = require('path');

const CONFIG = {
  id_empresa: 1,
  id_lista_precio_web: 1,
  output_dir: path.join(__dirname, '..', 'catalogo-web'),
  output_file: 'catalogo.json',
  empresa: {
    nombre: 'LAGO',
    slogan: 'Ferretería desde 2003 | Mayorista y Minorista',
    whatsapp: '5401163035258',
    telefono: '011 6303-5258',
    email: 'venta@lago.ar',
    direccion: 'Roger 3498, Glew',
    horarios: 'Lunes a Viernes 8:30 a 17:00 hs',
    razon_social: 'LAGO JUAN PABLO',
    cuit: '20-29628492-1',
    condicion_iva: 'IVA Responsable Inscripto',
    domicilio_legal: 'Av. Argentina 1622 esq. Roger, Glew (1856), Buenos Aires'
  }
};

const pool = new Pool({
  host: 'localhost',
  user: 'juanpablo',
  password: 'Huu3697debian@',
  database: 'erplago',
  port: 5432
});

async function generarCatalogo() {
  const client = await pool.connect();
  const inicio = Date.now();
  try {
    console.log(`[${new Date().toISOString()}] Generando catálogo web...`);

    const { rows: categorias } = await client.query(`
      SELECT id_categoria AS id, nombre, id_categoria_padre AS id_padre, orden
      FROM categorias WHERE activo = true ORDER BY orden, nombre
    `);

    const { rows: marcas } = await client.query(`
      SELECT id_marca AS id, nombre FROM marcas WHERE activo = true ORDER BY nombre
    `);

    const { rows: conjuntos } = await client.query(`
      SELECT id_conjunto AS id, nombre, descripcion
      FROM conjuntos WHERE activo = true AND id_empresa = $1 ORDER BY nombre
    `, [CONFIG.id_empresa]);

    const { rows: productos } = await client.query(`
      SELECT
        p.id_producto AS id, p.sku, p.nombre, p.descripcion, p.id_categoria,
        c.nombre AS categoria, p.unidad_medida AS unidad, m.nombre AS marca,
        p.url_imagen AS imagen,
        padre.url_imagen AS imagen_padre,
        p.tiene_variantes, p.id_producto_padre,
        pr.precio AS precio_neto,
        COALESCE(iva.porcentaje, 21) AS iva_porcentaje,
        ROUND(pr.precio * (1 + COALESCE(iva.porcentaje, 21) / 100), 2) AS precio_con_iva,
        COALESCE(inv.stock_real, 0) > 0 AS hay_stock
      FROM productos p
      LEFT JOIN productos padre ON padre.id_producto = p.id_producto_padre
      LEFT JOIN categorias c ON c.id_categoria = p.id_categoria
      LEFT JOIN marcas m ON m.id_marca = p.id_marca
      LEFT JOIN alicuotasiva iva ON iva.id_alicuota = p.id_alicuota_iva
      LEFT JOIN precios pr ON pr.id_producto = p.id_producto
        AND pr.id_empresa = $1 AND pr.id_lista_precio = $2
      LEFT JOIN inventario inv ON inv.id_producto = p.id_producto
        AND inv.id_empresa = $1
      WHERE p.visible_web = true AND p.activo = true
      ORDER BY p.nombre
    `, [CONFIG.id_empresa, CONFIG.id_lista_precio_web]);

    const productIds = productos.filter(p => p.tiene_variantes).map(p => p.id);
    let variantes = [];
    if (productIds.length > 0) {
      const { rows } = await client.query(`
        SELECT pv.id_variante AS id, pv.id_producto, pv.nombre_variante AS nombre,
          pv.sku, pv.precio, COALESCE(pv.stock, 0) > 0 AS hay_stock
        FROM producto_variantes pv
        WHERE pv.id_producto = ANY($1) AND pv.activo = true
        ORDER BY pv.id_producto, pv.nombre_variante
      `, [productIds]);
      variantes = rows;
    }

    const conjuntoIds = conjuntos.map(c => c.id);
    let conjuntoItems = [];
    if (conjuntoIds.length > 0) {
      const { rows } = await client.query(`
        SELECT id_conjunto, id_producto FROM conjunto_items
        WHERE id_conjunto = ANY($1) AND id_empresa = $2
      `, [conjuntoIds, CONFIG.id_empresa]);
      conjuntoItems = rows;
    }

    const variantesPorProducto = {};
    variantes.forEach(v => {
      if (!variantesPorProducto[v.id_producto]) variantesPorProducto[v.id_producto] = [];
      variantesPorProducto[v.id_producto].push({
        id: v.id, nombre: v.nombre, sku: v.sku,
        precio: v.precio ? parseFloat(v.precio) : null, hay_stock: v.hay_stock
      });
    });

    const conjuntosPorProducto = {};
    conjuntoItems.forEach(ci => {
      if (!conjuntosPorProducto[ci.id_producto]) conjuntosPorProducto[ci.id_producto] = [];
      conjuntosPorProducto[ci.id_producto].push(ci.id_conjunto);
    });

    let heredaronImagen = 0;
    const productosJson = productos.map(p => {
      // Herencia de imagen: si no tiene propia, usa la del padre
      let imagen = p.imagen || '';
      if (!imagen && p.imagen_padre) {
        imagen = p.imagen_padre;
        heredaronImagen++;
      }

      return {
        id: p.id, sku: p.sku, nombre: p.nombre, descripcion: p.descripcion || '',
        id_categoria: p.id_categoria, categoria: p.categoria || '', marca: p.marca || '',
        unidad: p.unidad || 'unidades', imagen,
        precio: p.precio_con_iva ? parseFloat(p.precio_con_iva) : null,
        hay_stock: p.hay_stock,
        conjuntos: conjuntosPorProducto[p.id] || [],
        variantes: variantesPorProducto[p.id] || []
      };
    });

    const catalogo = {
      generado: new Date().toISOString(), version: 1, empresa: CONFIG.empresa,
      categorias: categorias.map(c => ({ id: c.id, nombre: c.nombre, id_padre: c.id_padre, orden: c.orden })),
      conjuntos: conjuntos.map(c => ({ id: c.id, nombre: c.nombre, descripcion: c.descripcion || '' })),
      marcas: marcas.map(m => ({ id: m.id, nombre: m.nombre })),
      productos: productosJson
    };

    if (!fs.existsSync(CONFIG.output_dir)) fs.mkdirSync(CONFIG.output_dir, { recursive: true });
    const outputPath = path.join(CONFIG.output_dir, CONFIG.output_file);
    fs.writeFileSync(outputPath, JSON.stringify(catalogo));
    fs.writeFileSync(path.join(CONFIG.output_dir, 'catalogo-debug.json'), JSON.stringify(catalogo, null, 2));

    const conImagen = productosJson.filter(p => p.imagen).length;
    console.log(`[OK] Catálogo generado: ${productosJson.length} productos, ${variantes.length} variantes`);
    console.log(`     ${categorias.length} categorías, ${conjuntos.length} conjuntos, ${marcas.length} marcas`);
    console.log(`     Precios con IVA según alícuota de cada producto`);
    console.log(`     Imágenes: ${conImagen} con imagen (${heredaronImagen} heredadas del padre)`);
    console.log(`     Tamaño: ${(Buffer.byteLength(JSON.stringify(catalogo)) / 1024).toFixed(1)} KB`);
    console.log(`     Archivo: ${outputPath}`);
  } catch (error) {
    console.error(`[ERROR]`, error.message);
    throw error;
  } finally {
    client.release();
  }
}

generarCatalogo().then(() => { pool.end(); process.exit(0); }).catch(err => { console.error(err); pool.end(); process.exit(1); });
