});

// --- OBTENER UN SOLO CLIENTE POR ID ---
app.get('/api/clientes/:id', async (req, res) => {
    const id = parseInt(req.params.id);
    if (isNaN(id)) {
        return res.status(400).send('El ID debe ser un número válido.');
    }

    try {
        const result = await pool.query('SELECT * FROM clientes WHERE id_cliente = $1', [id]);
        if (result.rows.length === 0) {
            return res.status(404).send('Cliente no encontrado.');
        }
        res.json(result.rows[0]);
    } catch (err) {
        console.error('Error al obtener el cliente:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

// --- CREAR UN NUEVO CLIENTE ---
app.post('/api/clientes', async (req, res) => {
    const { id_empresa, cuit_cuil, razon_social, domicilio, id_condicion_iva, email, telefono } = req.body;

    if (!id_empresa || !razon_social || !id_condicion_iva) {
        return res.status(400).json({ error: 'id_empresa, razon_social e id_condicion_iva son obligatorios.' });
    }

    try {
        const text = 'INSERT INTO clientes(id_empresa, cuit_cuil, razon_social, domicilio, id_condicion_iva, email, telefono) VALUES($1, $2, $3, $4, $5, $6, $7) RETURNING *';
        const values = [id_empresa, cuit_cuil, razon_social, domicilio, id_condicion_iva, email, telefono];
        const result = await pool.query(text, values);
        res.status(201).json(result.rows[0]);
    } catch (err) {
        console.error('Error al insertar el cliente:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

// --- ACTUALIZAR UN CLIENTE EXISTENTE ---
app.put('/api/clientes/:id', async (req, res) => {
    const id = parseInt(req.params.id);
    const { cuit_cuil, razon_social, domicilio, id_condicion_iva, email, telefono, activo } = req.body;

    if (isNaN(id)) {
        return res.status(400).send('El ID debe ser un número válido.');
    }

    try {
        const text = 'UPDATE clientes SET cuit_cuil = $1, razon_social = $2, domicilio = $3, id_condicion_iva = $4, email = $5, telefono = $6, activo = $7, fecha_modificacion = now() WHERE id_cliente = $8 RETURNING *';
        const values = [cuit_cuil, razon_social, domicilio, id_condicion_iva, email, telefono, activo, id];
        const result = await pool.query(text, values);

        if (result.rows.length === 0) {
            return res.status(404).send('Cliente no encontrado.');
        }
        res.json(result.rows[0]);
    } catch (err) {
        console.error('Error al actualizar el cliente:', err.stack);
        res.status(500).send('Error interno del servidor');
    }
});

