<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Inventario — {{empresa.razon_social}}</title>
<style>
    @page { size: A4 landscape; margin: 12mm 10mm; }
    * { box-sizing: border-box; }
    body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        font-size: 10pt;
        color: #1a1a1a;
        margin: 0;
        padding: 0;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    header {
        border-bottom: 2px solid #0d6b45;
        padding-bottom: 8px;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    header .titulo h1 {
        color: #0d6b45;
        font-size: 16pt;
        margin: 0 0 2px 0;
        font-weight: 700;
    }
    header .titulo .sub {
        font-size: 10pt;
        color: #555;
    }
    header .empresa {
        text-align: right;
        font-size: 9pt;
        color: #555;
    }
    header .empresa .razon {
        color: #0d6b45;
        font-weight: 700;
        font-size: 11pt;
    }
    .meta {
        display: flex;
        justify-content: space-between;
        margin: 4px 0 6px 0;
        font-size: 9pt;
        color: #555;
    }
    .filtros {
        font-size: 8pt;
        color: #777;
        margin-bottom: 8px;
        font-style: italic;
        border-left: 3px solid #15a35e;
        padding-left: 6px;
    }
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 8.5pt;
    }
    thead {
        background: #0d6b45;
        color: #fff;
    }
    thead th {
        padding: 4px 6px;
        text-align: left;
        font-weight: 500;
        font-size: 8pt;
        text-transform: uppercase;
        letter-spacing: 0.3px;
    }
    thead th.num { text-align: right; }
    thead th.center { text-align: center; }
    tbody td {
        padding: 3px 6px;
        border-bottom: 1px solid #eee;
        vertical-align: top;
    }
    tbody tr:nth-child(even) { background: #fafafa; }
    tbody tr.bajo-min td { background: #fef5f5 !important; }
    tbody tr.sin-stock td { background: #fde7e7 !important; }
    tbody td.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        font-feature-settings: "tnum";
    }
    tbody td.center { text-align: center; }
    tbody td.bold { font-weight: 700; }
    tbody td code {
        font-family: "SF Mono", Consolas, "Liberation Mono", monospace;
        font-size: 8pt;
    }
    .empty {
        text-align: center;
        padding: 30px;
        color: #888;
        font-style: italic;
    }
    footer {
        margin-top: 12px;
        font-size: 8pt;
        color: #888;
        text-align: right;
        border-top: 1px solid #ddd;
        padding-top: 6px;
    }
    @media print {
        thead { display: table-header-group; }
        tr { page-break-inside: avoid; }
    }
</style>
</head>
<body>

<header>
    <div class="titulo">
        <h1>Inventario</h1>
        <div class="sub">Depósito: <strong>{{deposito_nombre}}</strong></div>
    </div>
    <div class="empresa">
        <div class="razon">{{empresa.razon_social}}</div>
        {{#if empresa.cuit}}<div>CUIT: {{empresa.cuit}}</div>{{/if}}
        {{#if empresa.direccion}}<div>{{empresa.direccion}}</div>{{/if}}
    </div>
</header>

<div class="meta">
    <span>Fecha de impresión: <strong>{{fecha_impresion}}</strong></span>
    <span>Usuario: <strong>{{usuario_nombre}}</strong></span>
    <span><strong>{{cantidad}}</strong> productos</span>
</div>

{{#if filtros_texto}}
<div class="filtros"><strong>Filtros aplicados:</strong> {{filtros_texto}}</div>
{{/if}}

{{#if productos.length}}
<table>
    <thead>
        <tr>
            <th style="width:80px">SKU</th>
            <th>Producto</th>
            <th style="width:90px">Marca</th>
            <th style="width:45px" class="num">Mín.</th>
            <th style="width:45px" class="num">Máx.</th>
            <th style="width:60px" class="num">Sistema</th>
            <th style="width:60px" class="num">Disp.</th>
            <th style="width:35px" class="center">OCs</th>
            <th>Proveedor preferido</th>
        </tr>
    </thead>
    <tbody>
        {{#each productos}}
        <tr class="{{this.fila_clase}}">
            <td><code>{{this.sku}}</code></td>
            <td>{{this.nombre}}</td>
            <td>{{this.marca_nombre}}</td>
            <td class="num">{{this.stock_minimo_fmt}}</td>
            <td class="num">{{this.stock_maximo_fmt}}</td>
            <td class="num bold">{{this.stock_real_fmt}}</td>
            <td class="num">{{this.stock_disponible_fmt}}</td>
            <td class="center">{{this.ocs_activas_display}}</td>
            <td>{{this.proveedor_preferido_nombre}}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
{{else}}
<div class="empty">No hay productos para mostrar con los filtros aplicados</div>
{{/if}}

<footer>ERP LAGO — Listado de Inventario · Impreso el {{fecha_impresion}}</footer>

<script>
    window.addEventListener('load', function () {
        setTimeout(function () { window.print(); }, 200);
    });
    window.addEventListener('afterprint', function () {
        setTimeout(function () { window.close(); }, 300);
    });
</script>

</body>
</html>
