<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Comprobante #{{pedido.id_pedido}}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 12px; color: #333; padding: 20px; max-width: 800px; margin: 0 auto; }
        
        .header { display: flex; justify-content: space-between; border-bottom: 3px solid #2c3e50; padding-bottom: 15px; margin-bottom: 20px; }
        .empresa-info { flex: 1; }
        .empresa-nombre { font-size: 24px; font-weight: bold; color: #2c3e50; margin-bottom: 5px; }
        .empresa-datos { font-size: 11px; color: #666; line-height: 1.5; }
        
        .comprobante-box { text-align: center; border: 2px solid #2c3e50; padding: 10px 20px; min-width: 200px; }
        .comprobante-tipo { font-size: 28px; font-weight: bold; color: #2c3e50; }
        .comprobante-letra { font-size: 14px; color: #666; }
        .comprobante-numero { font-size: 16px; margin-top: 5px; }
        
        .info-section { display: flex; gap: 20px; margin-bottom: 20px; }
        .info-box { flex: 1; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 5px; padding: 12px; }
        .info-title { font-weight: bold; color: #2c3e50; margin-bottom: 8px; font-size: 11px; text-transform: uppercase; border-bottom: 1px solid #dee2e6; padding-bottom: 5px; }
        .info-row { display: flex; margin-bottom: 4px; }
        .info-label { color: #666; min-width: 80px; font-size: 11px; }
        .info-value { font-weight: 500; }
        
        .items-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; }
        .items-table th { background: #2c3e50; color: white; padding: 10px 8px; text-align: left; font-size: 11px; text-transform: uppercase; }
        .items-table td { padding: 10px 8px; border-bottom: 1px solid #eee; }
        .items-table tr:hover { background: #f8f9fa; }
        .items-table .text-right { text-align: right; }
        .items-table .text-center { text-align: center; }
        .items-table .codigo { color: #3498db; font-weight: 600; }
        
        .totales-section { display: flex; justify-content: flex-end; }
        .totales-box { min-width: 300px; }
        .total-row { display: flex; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid #eee; }
        .total-row.subtotal { background: #f8f9fa; }
        .total-row.final { background: #2c3e50; color: white; font-size: 16px; font-weight: bold; border-radius: 0 0 5px 5px; }
        
        .estado-badge { display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase; }
        .estado-pagado { background: #d4edda; color: #155724; }
        .estado-pendiente { background: #fff3cd; color: #856404; }
        .estado-retira { background: #cce5ff; color: #004085; }
        .estado-entrega { background: #f8d7da; color: #721c24; }
        
        .footer { margin-top: 30px; padding-top: 15px; border-top: 1px solid #dee2e6; text-align: center; color: #666; font-size: 10px; }
        .qr-section { text-align: center; margin-top: 20px; }
        
        .observaciones { background: #fff3cd; border: 1px solid #ffc107; border-radius: 5px; padding: 10px; margin-bottom: 20px; }
        .observaciones-title { font-weight: bold; color: #856404; margin-bottom: 5px; }
        
        @media print {
            body { padding: 10px; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>
    <div class="header">
        <div class="empresa-info">
            <div class="empresa-nombre">{{empresa.razon_social}}</div>
            <div class="empresa-datos">
                CUIT: {{empresa.cuit}}<br>
                {{empresa.domicilio_fiscal}}<br>
                {{#if empresa.telefono}}Tel: {{empresa.telefono}}<br>{{/if}}
                {{#if empresa.email}}{{empresa.email}}{{/if}}
            </div>
        </div>
        <div class="comprobante-box">
            <div class="comprobante-tipo">X</div>
            <div class="comprobante-letra">Documento No Fiscal</div>
            <div class="comprobante-numero">Nº {{padLeft pedido.id_pedido 8}}</div>
            <div style="font-size: 11px; margin-top: 5px;">{{formatDate pedido.fecha_creacion}}</div>
        </div>
    </div>

    <div class="info-section">
        <div class="info-box">
            <div class="info-title">📋 Datos del Cliente</div>
            <div class="info-row"><span class="info-label">Cliente:</span><span class="info-value">{{cliente.razon_social}}</span></div>
            <div class="info-row"><span class="info-label">CUIT/CUIL:</span><span class="info-value">{{cliente.cuit_cuil}}</span></div>
            <div class="info-row"><span class="info-label">Domicilio:</span><span class="info-value">{{cliente.domicilio}}</span></div>
            {{#if cliente.telefono}}<div class="info-row"><span class="info-label">Teléfono:</span><span class="info-value">{{cliente.telefono}}</span></div>{{/if}}
        </div>
        <div class="info-box">
            <div class="info-title">📦 Estado del Pedido</div>
            <div class="info-row">
                <span class="info-label">Entrega:</span>
                <span class="info-value">
                    {{#if (eq pedido.tipo_entrega 'retiro')}}
                        <span class="estado-badge estado-retira">🏪 Retira en Local</span>
                    {{else}}
                        <span class="estado-badge estado-entrega">🚚 Para Entregar</span>
                    {{/if}}
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">Pago:</span>
                <span class="info-value">
                    {{#if deuda_cuenta_corriente}}
                        <span class="estado-badge estado-pendiente">💳 Cuenta Corriente</span> <strong>${{formatNumber monto_cuenta_corriente}}</strong>
                    {{else if pagado}}
                        <span class="estado-badge estado-pagado">✅ Pagado</span>
                    {{else}}
                        <span class="estado-badge estado-pendiente">⏳ Pendiente</span>
                    {{/if}}
                </span>
            </div>
            {{#if pedido.domicilio_entrega}}
            <div class="info-row"><span class="info-label">Dirección:</span><span class="info-value">{{pedido.domicilio_entrega}}</span></div>
            {{/if}}
        </div>
    </div>

    {{#if pedido.observaciones}}
    <div class="observaciones">
        <div class="observaciones-title">📝 Observaciones:</div>
        {{pedido.observaciones}}
    </div>
    {{/if}}

    <table class="items-table">
        <thead>
            <tr>
                <th style="width: 60px;">Cant.</th>
                <th style="width: 100px;">Código</th>
                <th>Descripción</th>
                <th style="width: 100px;" class="text-right">{{#if es_responsable_inscripto}}P.Unit Neto{{else}}P.Unit{{/if}}</th>
                <th style="width: 80px;" class="text-center">Dto%</th>
                <th style="width: 110px;" class="text-right">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            {{#each items}}
            <tr>
                <td class="text-center">{{this.cantidad}}</td>
                <td class="codigo">{{this.sku}}</td>
                <td>{{this.descripcion}}</td>
                <td class="text-right">${{formatNumber this.precio_unitario}}</td>
                <td class="text-center">{{#if this.porcentaje_descuento}}{{this.porcentaje_descuento}}%{{else}}-{{/if}}</td>
                <td class="text-right">${{formatNumber this.subtotal}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <div class="totales-section">
        <div class="totales-box">
            <div class="total-row subtotal">
                <span>{{#if es_responsable_inscripto}}Subtotal (Neto):{{else}}Subtotal:{{/if}}</span>
                <span>${{formatNumber totales.subtotal}}</span>
            </div>
            {{#if pedido.descuento_monto}}
            <div class="total-row">
                <span>Descuento:</span>
                <span>-${{formatNumber pedido.descuento_monto}}</span>
            </div>
            {{/if}}
            {{#each ajustes}}
            <div class="total-row" style="color: {{#if (eq this.tipo 'recargo')}}#c0392b{{else}}#27ae60{{/if}};">
                <span>{{this.descripcion}}</span>
                <span>{{#if (eq this.tipo 'recargo')}}+{{/if}}${{formatNumber this.monto_ajuste}}</span>
            </div>
            {{/each}}
            {{#if es_responsable_inscripto}}
            <div class="total-row">
                <span>IVA (21%):</span>
                <span>${{formatNumber totales.iva}}</span>
            </div>
            {{/if}}
            <div class="total-row final">
                <span>TOTAL:</span>
                <span>${{formatNumber pedido.total_final}}</span>
            </div>
        </div>
    </div>

    {{#if pagos.length}}
    <div style="margin-top: 20px;">
        <div class="info-title" style="margin-bottom: 10px;">💳 Formas de Pago</div>
        {{#each pagos}}
        <div style="display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px dashed #ddd;">
            <span>{{this.metodo}}</span>
            <span>${{formatNumber this.monto}}</span>
        </div>
        {{#if this.monto_original}}
        <div style="font-size: 10px; color: #888; text-align: right; padding: 2px 0;">
            Base: ${{formatNumber this.monto_original}}
        </div>
        {{/if}}
        {{/each}}
    </div>
    {{/if}}

    <div class="footer">
        <p>Documento no válido como factura • Generado el {{now}} • ERP LAGO</p>
        <p style="margin-top: 5px;">¡Gracias por su compra!</p>
    </div>
</body>
</html>
